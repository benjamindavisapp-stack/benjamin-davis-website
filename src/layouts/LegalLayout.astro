---
// LegalLayout.astro — shared shell for the privacy policy and terms pages.
// Plain prose rather than the spec-sheet treatment used elsewhere: these are
// documents to be read start to finish, so measure and rhythm matter more
// than framing. Keeps the site's type scale, palette and sharp edges.
import Layout from '@/layouts/Layout.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  updated: string;
}

const { title, description, heading, updated } = Astro.props;
---

<Layout title={title} description={description}>

  <article class="legal">
    <div class="container legal-body">

      <header class="legal-head">
        <p class="legal-eyebrow">Benjamin Davis &middot; benjamindavis.build</p>
        <h1 class="legal-title">{heading}</h1>
        <p class="legal-updated">Last updated {updated}</p>
      </header>

      <div class="legal-prose">
        <slot />
      </div>

    </div>
  </article>

</Layout>

<style>
  .legal {
    border-top: 1px solid var(--panel-edge);
  }

  .legal-body {
    max-width: 680px;
    padding-block: 4rem 5rem;
  }

  .legal-head {
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--panel-edge);
    margin-bottom: 2.5rem;
  }

  .legal-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--copper);
    margin-bottom: 0.9rem;
  }

  .legal-title {
    font-family: var(--font-head);
    font-size: clamp(2.2rem, 7vw, 3.1rem);
    font-weight: 900;
    line-height: 0.95;
    color: var(--text);
  }

  .legal-updated {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--steel);
    margin-top: 0.9rem;
  }

  /* Prose rhythm — generous leading, short measure, clear heading steps. */
  .legal-prose :global(h2) {
    font-family: var(--font-head);
    font-size: 1.3rem;
    font-weight: 900;
    letter-spacing: 0.01em;
    color: var(--gold);
    margin-top: 2.75rem;
    margin-bottom: 0.85rem;
  }

  .legal-prose :global(h2:first-child) {
    margin-top: 0;
  }

  .legal-prose :global(p) {
    font-size: 0.92rem;
    line-height: 1.75;
    color: var(--text);
    margin-bottom: 1.1rem;
  }

  .legal-prose :global(ul) {
    margin: 0 0 1.1rem 0;
    padding-left: 1.1rem;
    list-style: none;
  }

  .legal-prose :global(li) {
    position: relative;
    font-size: 0.92rem;
    line-height: 1.75;
    color: var(--text);
    margin-bottom: 0.6rem;
  }

  /* En-dash markers rather than discs or check glyphs. */
  .legal-prose :global(li)::before {
    content: '–';
    position: absolute;
    left: -1.1rem;
    color: var(--copper);
  }

  .legal-prose :global(a) {
    color: var(--gold);
    border-bottom: 1px solid var(--gold-dim);
  }

  .legal-prose :global(a:hover) {
    color: var(--text);
    border-bottom-color: var(--steel);
  }

  .legal-prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .legal-prose :global(.legal-note) {
    border: 1px solid var(--panel-edge);
    background: var(--panel);
    padding: 1.1rem 1.25rem;
    font-size: 0.86rem;
    line-height: 1.7;
    color: var(--steel);
    margin-bottom: 1.1rem;
  }

  @media (max-width: 600px) {
    .legal-body {
      padding-block: 2.5rem 3.5rem;
    }
  }
</style>
