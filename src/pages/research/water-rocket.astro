---
import ProjectLayout  from '@/layouts/ProjectLayout.astro';
import ProjectSection from '@/components/ProjectSection.astro';
import ProjectGallery from '@/components/ProjectGallery.astro';
import SpecTable      from '@/components/SpecTable.astro';
import Credits        from '@/components/Credits.astro';
import { getProject, getNeighbours } from '@/data/projects';

const p = getProject('water-rocket');
---

<ProjectLayout
  title={p.title}
  subtitle="Builds"
  role={p.role}
  year={p.year}
  tags={p.tags}
  overview={p.summary}
  ogImage={p.cover}
  specs={[
    { key: 'Height',             value: '10 ft' },
    { key: 'Pressure chamber',   value: '2 L' },
    { key: 'Fin sets',           value: '3' },
  ]}
  {...getNeighbours(p.slug)}
>

  <ProjectSection num="01" title="The build" dark>
    <p>
      Ten feet of water rocket, built with four classmates for physics. A
      two-litre bottle forms the pressure chamber; above and below it the body
      is clear tube sections, so the water column is visible right up to
      launch. The nose cone is printed, and three sets of fins are spaced along
      the airframe rather than clustered at the base.
    </p>

    <SpecTable
      caption="Airframe"
      rows={[
        { key: 'Overall height',   value: 'About 10 ft' },
        { key: 'Pressure chamber', value: '2-litre bottle' },
        { key: 'Body',             value: 'Clear tube sections' },
        { key: 'Nose cone',        value: '3D printed' },
        { key: 'Fins',             value: 'Three sets along the airframe' },
      ]}
    />

    <ProjectGallery
      cols={3}
      images={[
        {
          src: '/images/projects/rocket10-nosecone.jpg',
          alt: 'The printed green nose cone held in hand next to a clear body tube section',
          caption: 'Printed nose cone and a clear body section.',
        },
        {
          src: '/images/projects/rocket10-build.jpg',
          alt: 'Two students holding the assembled body tubes of the water rocket in a classroom',
          caption: 'Assembling body sections in the lab.',
        },
        {
          src: '/images/projects/rocket10-team.jpg',
          alt: 'The build team holding the completed ten-foot rocket horizontally on the school field before launch',
          caption: 'The full rocket, carried out to the field.',
        },
      ]}
    />
  </ProjectSection>

  <ProjectSection num="02" title="The flight">
    <p>
      It launched cleanly off the pad and climbed straight. Partway up it
      pitched over, and it came down nose-first. A ten-foot airframe on a
      two-litre chamber is a long lever on a small impulse, and the flight
      ended the way the proportions suggested it might.
    </p>
    <p>
      I have not finished the analysis of why it pitched over, so I am not
      publishing a cause or a fix yet — working out which of the candidates
      actually did it is the interesting part, and it deserves better than a
      guess.
    </p>

    <ProjectGallery
      cols={1}
      ratio="4 / 3"
      images={[
        {
          src: '/images/projects/rocket10-launch.jpg',
          alt: 'The ten-foot water rocket standing vertically on its launch pad on the school field with the class watching from a distance',
          focus: 'center 40%',
          caption: 'On the pad, moments before launch.',
        },
      ]}
    />
  </ProjectSection>

  <ProjectSection num="03" title="Launcher and credits" dark>
    <p>
      The rocket flew from my modified <strong>StratoLauncher IV Deluxe</strong>,
      and the airframe is loosely inspired by the StratoRocket 48".
    </p>
    <Credits
      teamLabel="Physics build team"
      team={[
        { name: 'Avi Amin', url: 'https://aviamin.com' },
        { name: 'Liam Sheehan' },
        { name: 'Ansh Nagpal' },
        { name: 'Will Kennedy' },
        { name: 'Benjamin Davis' },
      ]}
      items={[
        'Launched from my modified StratoLauncher IV Deluxe.',
        'Airframe loosely inspired by the StratoRocket 48".',
      ]}
    />
  </ProjectSection>

</ProjectLayout>
