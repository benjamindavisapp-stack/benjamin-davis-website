---
import ProjectLayout  from '@/layouts/ProjectLayout.astro';
import ProjectSection from '@/components/ProjectSection.astro';
import ProjectGallery from '@/components/ProjectGallery.astro';
import SpecTable      from '@/components/SpecTable.astro';
import Credits        from '@/components/Credits.astro';
import { getProject, getNeighbours } from '@/data/projects';

const p = getProject('santa-shop-conveyor');
---

<ProjectLayout
  title={p.title}
  subtitle="Team & Community"
  role={p.role}
  year={p.year}
  tags={p.tags}
  overview={p.summary}
  ogImage={p.cover}
  {...getNeighbours(p.slug)}
>

  <ProjectSection num="01" title="The build" dark>
    <p>
      Bishop Feehan runs a Santa Shop every December. My TechForge team built
      the centerpiece: a working conveyor that carries 3D-printed toys along
      the display and under a decorated hopper.
    </p>
    <p>
      The mechanism is deliberately simple, because it has to run all day with
      children leaning on it. Rollers are <strong>PVC sleeves on threaded
      rod</strong>, located by nuts and washers — cheap, replaceable, and
      adjustable without tools anyone would have to go and find.
    </p>

    <SpecTable
      caption="Construction"
      rows={[
        { key: 'Rollers',   value: 'PVC sleeves over threaded rod' },
        { key: 'Location',  value: 'Nuts and washers either side of each sleeve' },
        { key: 'Frame',     value: 'Timber, built to display height' },
        { key: 'Load',      value: '3D-printed toys made by the team' },
        { key: 'Based on',  value: 'The Instructables "DIY Conveyor Belt"' },
      ]}
    />
  </ProjectSection>

  <ProjectSection num="02" title="Leading the team">
    <p>
      The interesting problem was not the conveyor — it was making twenty-odd
      identical rollers with a group of students in the time a club meeting
      gives you. I set up an assembly line: one station cutting sleeves, one
      threading rod, one stacking nuts and washers to a fixed pattern, one
      checking each finished roller against the first.
    </p>
    <p>
      Batching it that way meant the rollers came out consistent enough that
      the belt tracked straight the first time it ran.
    </p>

    <ProjectGallery
      cols={2}
      images={[
        {
          src: '/images/projects/santa-rollers.webp',
          alt: 'A dozen finished conveyor rollers laid out in rows — white PVC sleeves on threaded rod with nuts and washers at each end',
          caption: 'A batch of finished rollers off the assembly line.',
        },
        {
          src: '/images/projects/santa-team.webp',
          alt: 'The TechForge team gathered around the conveyor in the lab, watching it run',
          caption: 'The team, watching the first full-length run.',
        },
      ]}
    />
  </ProjectSection>

  <ProjectSection num="03" title="Installed" dark>
    <ProjectGallery
      cols={2}
      images={[
        {
          src: '/images/projects/santa-toys.webp',
          alt: 'Brightly colored 3D-printed toys arranged at the end of the conveyor display',
          caption: 'The printed toys the conveyor carries.',
        },
        {
          src: '/images/projects/santa-conveyor.webp',
          alt: 'The finished Santa Shop conveyor installed in the school hall, clad in wrapping paper and decorated for the event',
          caption: 'Installed and decorated for Santa Shop.',
        },
      ]}
    />

    <Credits
      items={[
        'Mechanism based on the Instructables "DIY Conveyor Belt".',
        'Built with the Bishop Feehan TechForge team.',
      ]}
    />
  </ProjectSection>

</ProjectLayout>
