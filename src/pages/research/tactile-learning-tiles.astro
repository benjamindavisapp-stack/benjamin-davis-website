---
import ProjectLayout  from '@/layouts/ProjectLayout.astro';
import ProjectSection from '@/components/ProjectSection.astro';
import ProjectGallery from '@/components/ProjectGallery.astro';
import SpecTable      from '@/components/SpecTable.astro';
import { getProject, getNeighbours } from '@/data/projects';

const p = getProject('tactile-learning-tiles');
---

<ProjectLayout
  title={p.title}
  subtitle="Team & Community"
  role={p.role}
  year={p.year}
  tags={p.tags}
  overview={p.summary}
  ogImage={p.cover}
  {...getNeighbours(p.slug)}
>

  <ProjectSection num="01" title="One card, two ways to read it" dark>
    <p>
      Classroom communication cards usually come in two versions: a printed
      one for sighted students and a braille one for blind students. Two sets
      of cards means two groups of children using different objects to say the
      same thing.
    </p>
    <p>
      These tiles carry all three at once — a <strong>raised icon</strong>,
      <strong>large print</strong>, and <strong>braille</strong> — so the same
      tile works whether a student reads it with their eyes or their fingers.
      They were designed and made with my TechForge team and donated to
      <strong>Pappas Rehabilitation Hospital</strong>.
    </p>
  </ProjectSection>

  <ProjectSection num="02" title="Design and making">
    <SpecTable
      caption="How they are made"
      rows={[
        { key: 'CAD',       value: 'Modelled in Fusion 360' },
        { key: 'Process',   value: 'FDM, printed in two colors' },
        { key: 'Contrast',  value: 'Raised icon in a contrasting color for low-vision users' },
        { key: 'Surface',   value: 'Raised icon, large print and braille on one face' },
        { key: 'Set',       value: 'Yes / No, subject tiles, number tiles' },
      ]}
    />
    <p>
      Printing in two colors is doing real work here, not decoration: a
      low-vision student who cannot resolve the outline of the icon can still
      see the color boundary between the icon and the tile behind it.
    </p>

    <ProjectGallery
      cols={2}
      images={[
        {
          src: '/images/projects/tactile-cad.jpg',
          alt: 'CAD model of a SCIENCE tile in Fusion 360, showing the raised flask icon, the raised word and the braille dots',
          caption: 'The CAD model — icon, print and braille all raised off the same face.',
        },
        {
          src: '/images/projects/tactile-tiles.jpg',
          alt: 'Eight finished tactile learning tiles laid out on a dark bench — raised orange icons, large print and braille on white tiles',
          caption: 'Finished tiles: yes/no, subject and number cards.',
        },
      ]}
    />
  </ProjectSection>

</ProjectLayout>
