---
import ProjectLayout  from '@/layouts/ProjectLayout.astro';
import ProjectSection from '@/components/ProjectSection.astro';
import ProjectGallery from '@/components/ProjectGallery.astro';
import SpecTable      from '@/components/SpecTable.astro';
import { getProject, getNeighbours } from '@/data/projects';

const p = getProject('bd-cards');
---

<ProjectLayout
  title={p.title}
  subtitle="Builds"
  role={p.role}
  year={p.year}
  tags={p.tags}
  overview={p.summary}
  ogImage={p.cover}
  specs={[
    { key: 'Processes per card', value: '4' },
    { key: 'Next version',       value: '6' },
    { key: 'Tap target',         value: 'This site' },
  ]}
  {...getNeighbours(p.slug)}
>

  <ProjectSection num="01" title="A business card as a manufacturing exercise" dark>
    <p>
      A paper business card gets thrown away. One that takes four manufacturing
      processes to make does not — and making it is the point. Every card is a
      complete CAD-to-CAM-to-part exercise at a scale small enough to iterate
      on in an evening.
    </p>
    <p>
      If you arrived here by tapping a card against your phone, the NFC tag
      inside it is what sent you.
    </p>

    <ProjectGallery
      cols={2}
      images={[
        {
          src: '/images/projects/bdcards-card.webp',
          alt: 'A finished BD card held in hand, showing the machined frame, lattice infill and raised BENJAMIN DAVIS / ADVANCED MANUFACTURING lettering',
          caption: 'The card: machined frame, structural lattice, raised nameplate.',
        },
        {
          src: '/images/card-back.webp',
          alt: 'Render of the card reverse, showing the copper QR inlay set into the lattice frame',
          caption: 'The reverse, with the QR inlay.',
        },
      ]}
    />
  </ProjectSection>

  <ProjectSection num="02" title="The processes">
    <SpecTable
      caption="What goes into a card today"
      head={['Process', 'What it makes', 'Machine']}
      rows={[
        { key: 'CNC machining',    value: 'Brass lettering',        note: 'Genmitsu 3030 ProVer' },
        { key: 'Laser cutting',    value: 'Acrylic layer',          note: '—' },
        { key: 'Multi-color FDM',  value: 'Two-tone printed detail', note: 'Bambu Lab X2D / A1' },
        { key: 'Resin printing',   value: 'Fine-feature parts',      note: 'Creality Halot R6' },
      ]}
    />
    <p>
      The NFC tag is not a fifth process — it is a component the four have to
      make room for. It has to sit deep enough to survive handling and shallow
      enough to read through the face.
    </p>
    <p>
      Each process constrains the next. The frame sets the pockets the brass
      has to land in, the acrylic has to index off those same pockets, and
      every tolerance stacks toward the one face anyone actually looks at.
    </p>

    <h3>Coming in the next version</h3>
    <p>
      Two more processes are designed in but not yet on a card I have handed
      anyone: an <strong>SLS-printed frame</strong> in place of the current
      one, and <strong>anodizing</strong> for the surface finish. Both are
      what the next revision is for.
    </p>
  </ProjectSection>

  <ProjectSection num="03" title="Variants" dark>
    <h3>The milled copper circuit-board card</h3>
    <p>
      A card milled as an actual PCB — copper traces routed into clad board,
      the name and QR laid out as part of the circuit artwork rather than
      printed on top of it.
    </p>

    <h3>Nameplates</h3>
    <p>
      The same process set, scaled up: brass and aluminum nameplates with
      two-color printed inserts, made for school staff. Each one carries the
      person's name, role and a QR or contact detail in the insert.
    </p>

    <ProjectGallery
      cols={3}
      images={[
        {
          src: '/images/projects/bdcards-pcb.webp',
          alt: 'The milled copper circuit-board card, with routed copper traces forming the name and layout on green clad board',
          caption: 'Milled copper PCB card.',
        },
        {
          src: '/images/projects/bdcards-nameplate-liam.webp',
          alt: 'A copper-framed nameplate reading Liam Sheehan, Math Economics History, held in hand',
          caption: 'Nameplate with a two-color printed insert.',
        },
        {
          src: '/images/projects/bdcards-nameplate-staff.webp',
          alt: 'A gold-framed staff nameplate reading Mrs. Smith, VP of Student Life, with printed social and email icons',
          caption: 'Staff nameplate, with contact icons in the insert.',
        },
      ]}
    />
  </ProjectSection>

  <ProjectSection num="04" title="Want one?">
    <p>
      I design and produce bespoke cards and nameplates — same materials, same
      tolerances, same process. Lead time and pricing depend on quantity and
      complexity. <a href="/contact">Get in touch</a> if you want one made.
    </p>
    <p>
      More on how the physical card drove the design of this site is on the
      <a href="/website">website page</a>.
    </p>
  </ProjectSection>

</ProjectLayout>
