---
import Layout     from '@/layouts/Layout.astro';
import Lattice    from '@/components/Lattice.astro';
import Bolt       from '@/components/Bolt.astro';
import PCBText    from '@/components/PCBText.astro';

const email    = 'benjamindavisma@gmail.com';
const linkedin = 'https://www.linkedin.com/in/benjamin-davis-60726635a/';

const links = [
  {
    label:    'Email',
    value:    email,
    href:     `mailto:${email}`,
    mono:     email,
    icon:     'M',
    ready:    true,
  },
  {
    label:    'LinkedIn',
    value:    'benjamin-davis-60726635a',
    href:     linkedin,
    mono:     'linkedin.com/in/benjamin-davis-60726635a',
    icon:     'Li',
    ready:    true,
  },
  {
    label:    'GitHub',
    value:    '—',
    href:     null,
    mono:     'coming soon',
    icon:     'Gh',
    ready:    false,
  },
  {
    label:    'Instagram',
    value:    '—',
    href:     null,
    mono:     'coming soon',
    icon:     'Ig',
    ready:    false,
  },
];
---

<Layout
  title="Contact — Benjamin Davis"
  description="Get in touch with Benjamin Davis — advanced manufacturing researcher, ISEF Young Scientist, Masason Foundation member."
>

  <!-- ── Hero ──────────────────────────────────────────────────────────────── -->
  <section class="ct-hero">
    <Lattice />
    <Bolt position="tl" />
    <Bolt position="tr" />
    <Bolt position="bl" />
    <Bolt position="br" />
    <div class="container ct-hero-body">
      <p class="overline">Contact</p>
      <PCBText id="contact-hero" duration={3.5} delay={0.4} maskColor="green">
        <h1 class="ct-heading">You've got the card —<br />let's keep building.</h1>
      </PCBText>
      <p class="ct-sub">Whether you want to collaborate, ask about the research, or just say hello — reach out directly.</p>
    </div>
  </section>

  <!-- ── Save contact ───────────────────────────────────────────────────────── -->
  <section class="ct-save">
    <div class="container ct-save-inner">
      <div class="ct-save-text">
        <p class="ct-save-label">Save to contacts</p>
        <p class="ct-save-note">One tap adds name, email, and LinkedIn to your phone.</p>
      </div>
      <a href="/benjamin-davis.vcf" download="Benjamin Davis.vcf" class="btn-save">
        <span class="btn-save-icon" aria-hidden="true">↓</span>
        Save Contact
      </a>
    </div>
  </section>

  <!-- ── Link grid ─────────────────────────────────────────────────────────── -->
  <section class="ct-links">
    <div class="container">
      <p class="overline">Reach me</p>
      <div class="link-grid">
        {links.map(l => (
          l.ready
            ? (
              <a href={l.href} class="link-card link-card--active" target={l.href?.startsWith('mailto') ? undefined : '_blank'} rel={l.href?.startsWith('mailto') ? undefined : 'noopener noreferrer'}>
                <span class="link-icon" aria-hidden="true">{l.icon}</span>
                <span class="link-label">{l.label}</span>
                <span class="link-mono">{l.mono}</span>
                <span class="link-arrow" aria-hidden="true">→</span>
              </a>
            )
            : (
              <div class="link-card link-card--placeholder">
                <span class="link-icon" aria-hidden="true">{l.icon}</span>
                <span class="link-label">{l.label}</span>
                <span class="link-mono">{l.mono}</span>
                <span class="link-placeholder-tag">coming soon</span>
              </div>
            )
        ))}
      </div>
    </div>
  </section>

  <!-- ── Message form ───────────────────────────────────────────────────────── -->
  <section class="ct-form-section">
    <div class="container ct-form-wrap">

      <div class="ct-form-head">
        <p class="overline">Send a message</p>
        <p class="ct-form-note">Opens your mail app — no accounts, no tracking.</p>
      </div>

      <form class="ct-form" id="contact-form">
        <div class="field-row">
          <div class="field">
            <label for="f-name" class="field-label">Name</label>
            <input id="f-name" name="name" type="text" class="field-input" placeholder="Your name" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="f-email" class="field-label">Your email</label>
            <input id="f-email" name="email" type="email" class="field-input" placeholder="you@example.com" autocomplete="email" required />
          </div>
        </div>

        <div class="field">
          <label for="f-subject" class="field-label">Subject</label>
          <input id="f-subject" name="subject" type="text" class="field-input" placeholder="What's this about?" required />
        </div>

        <div class="field">
          <label for="f-msg" class="field-label">Message</label>
          <textarea id="f-msg" name="message" class="field-input field-textarea" placeholder="What are you working on?" rows="5" required></textarea>
        </div>

        <button type="submit" class="btn-send">Send via email →</button>
      </form>
    </div>
  </section>

</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name    = (form.elements.namedItem('name')    as HTMLInputElement).value.trim();
    const replyTo = (form.elements.namedItem('email')   as HTMLInputElement).value.trim();
    const subject = (form.elements.namedItem('subject') as HTMLInputElement).value.trim();
    const message = (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim();

    const body = `Name: ${name}\nEmail: ${replyTo}\n\n${message}`;
    const mailto = `mailto:benjamindavisma@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    window.location.href = mailto;
  });
</script>

<style>
  /* ── Hero ──────────────────────────────────────────────────────────────── */
  .ct-hero {
    position: relative;
    padding-block: 4rem 3rem;
    overflow: hidden;
    border-bottom: 1px solid var(--panel-edge);
  }

  .ct-hero-body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .overline {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--copper);
  }

  .ct-heading {
    font-family: var(--font-head);
    font-size: clamp(2.4rem, 8vw, 4.5rem);
    font-weight: 900;
    line-height: 0.93;
    color: var(--text);
  }

  .ct-sub {
    font-size: 0.88rem;
    color: var(--steel);
    max-width: 460px;
    line-height: 1.65;
    margin-top: 0.4rem;
  }

  /* ── Save contact ────────────────────────────────────────────────────────── */
  .ct-save {
    background: color-mix(in srgb, var(--gold-dim) 20%, var(--panel));
    border-bottom: 1px solid var(--panel-edge);
    padding-block: 1.75rem;
  }

  .ct-save-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .ct-save-label {
    font-family: var(--font-head);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--gold);
  }

  .ct-save-note {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    color: var(--steel);
    margin-top: 0.2rem;
  }

  .btn-save {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.4rem;
    background: var(--gold);
    color: var(--graphite);
    font-family: var(--font-head);
    font-size: 1rem;
    font-weight: 900;
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: background 0.15s;
    white-space: nowrap;
  }

  .btn-save:hover  { background: var(--gold-bright); }
  .btn-save:focus-visible { outline: 2px solid var(--copper); outline-offset: 3px; }

  .btn-save-icon {
    font-size: 1.1rem;
    line-height: 1;
  }

  /* ── Link grid ───────────────────────────────────────────────────────────── */
  .ct-links {
    padding-block: 3rem;
    border-bottom: 1px solid var(--panel-edge);
  }

  .link-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--panel-edge);
    border: 1px solid var(--panel-edge);
    margin-top: 1.25rem;
  }

  .link-card {
    background: var(--graphite);
    padding: 1.4rem 1.5rem;
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    grid-template-rows: auto auto;
    column-gap: 0.75rem;
    align-items: start;
    text-decoration: none;
    transition: background 0.15s;
  }

  .link-card--active:hover { background: var(--panel); }
  .link-card--active:focus-visible { outline: 2px solid var(--copper); outline-offset: -2px; }

  .link-card--placeholder {
    opacity: 0.45;
    cursor: default;
  }

  .link-icon {
    grid-row: 1 / 3;
    align-self: center;
    font-family: var(--font-head);
    font-size: 0.75rem;
    font-weight: 900;
    color: var(--copper);
    border: 1px solid var(--panel-edge);
    width: 2.25rem;
    height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    letter-spacing: 0;
  }

  .link-label {
    font-family: var(--font-head);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
    align-self: end;
    padding-bottom: 0.1rem;
  }

  .link-mono {
    grid-column: 2;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.06em;
    color: var(--steel);
    align-self: start;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }

  .link-arrow {
    grid-row: 1 / 3;
    grid-column: 3;
    align-self: center;
    font-size: 1rem;
    color: var(--gold);
    transition: transform 0.15s;
  }

  .link-card--active:hover .link-arrow { transform: translateX(3px); }

  .link-placeholder-tag {
    grid-row: 1 / 3;
    grid-column: 3;
    align-self: center;
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--steel);
    border: 1px solid var(--panel-edge);
    padding: 0.15rem 0.4rem;
  }

  /* ── Message form ────────────────────────────────────────────────────────── */
  .ct-form-section {
    padding-block: 3.5rem;
    background: var(--panel);
  }

  .ct-form-wrap {
    max-width: 640px;
  }

  .ct-form-head {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-bottom: 2rem;
  }

  .ct-form-note {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.07em;
    color: var(--steel);
  }

  .ct-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field-label {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--copper);
  }

  .field-input {
    background: var(--graphite);
    border: 1px solid var(--panel-edge);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 0.88rem;
    padding: 0.65rem 0.8rem;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 0.15s;
    outline: none;
    -webkit-appearance: none;
  }

  .field-input::placeholder { color: var(--steel); opacity: 0.6; }
  .field-input:focus { border-color: var(--copper); }
  .field-input:focus-visible { outline: 2px solid var(--copper); outline-offset: -1px; }

  .field-textarea {
    resize: vertical;
    min-height: 120px;
    font-family: var(--font-body);
  }

  .btn-send {
    align-self: flex-start;
    padding: 0.7rem 1.6rem;
    background: transparent;
    border: 1px solid var(--copper);
    color: var(--copper);
    font-family: var(--font-head);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }

  .btn-send:hover { background: var(--copper); color: var(--graphite); }
  .btn-send:focus-visible { outline: 2px solid var(--copper); outline-offset: 3px; }

  /* ── Responsive ──────────────────────────────────────────────────────────── */
  @media (max-width: 600px) {
    .link-grid {
      grid-template-columns: 1fr;
    }

    .field-row {
      grid-template-columns: 1fr;
    }

    .ct-save-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
