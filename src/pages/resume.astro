---
import Layout from '@/layouts/Layout.astro';

/**
 * Resume. Also the source for public/benjamin-davis-resume.pdf, which is
 * rendered from this page by scripts/build-resume-pdf.mjs — so the PDF and
 * the web version can never drift apart.
 *
 * Home town and phone number are deliberately omitted: this page is public.
 * The school's own town stays, since that identifies the school rather than
 * where Benjamin lives.
 */

const CONTACT = [
  { label: 'Email',    value: 'benjamindavisma@gmail.com', href: 'mailto:benjamindavisma@gmail.com' },
  { label: 'Site',     value: 'benjamindavis.build',       href: 'https://benjamindavis.build' },
  { label: 'LinkedIn', value: 'benjamin-davis',            href: 'https://www.linkedin.com/in/benjamin-davis-60726635a/' },
];

const education = {
  school: 'Bishop Feehan High School — Attleboro, MA',
  grad:   'Expected graduation: June 2027',
  rows: [
    { key: 'Weighted GPA', val: '4.61 / 5.0 (freshman and sophomore year)' },
    { key: 'SAT',          val: '1560' },
    { key: 'AP exams',     val: '5 completed; AP Precalculus score 5' },
    { key: 'Junior year',  val: 'AP Calculus BC, AP Physics 1, AP English Literature, AP U.S. History' },
    { key: 'Senior year',  val: 'AP Statistics, AP English Language, AP Chemistry, AP Physics C: Mechanics, AP Physics C: E&M' },
    { key: 'University',   val: 'Multivariable Calculus (Calculus 3), UC Berkeley — Summer 2026' },
    { key: 'Engineering',  val: 'Intro to Engineering (junior), Engineering II (senior)' },
  ],
};

const awards = [
  {
    title: 'Regeneron Young Scientist Award',
    org:   'Regeneron ISEF 2025 · Columbus, OH',
    lines: [
      'One of only two students worldwide to receive this distinction',
      'Second highest overall score at ISEF 2025 · $75,000 scholarship',
    ],
  },
  {
    title: '1st Place — Engineering Technology: Statics & Dynamics',
    org:   'Regeneron ISEF 2025',
    lines: [
      '“From Crude to Extrude”: a desktop system combining pultrusion and extrusion to recycle PET bottle waste and 3D-printing purge into additive-manufacturing filament',
      'About 43% more energy efficient and roughly 5× lower particulate emissions than standard extrusion and re-extrusion',
      'Filament approaching commercial tolerances at about 90% lower cost',
      '800+ hours and 50+ component iterations',
    ],
  },
  { title: 'Masason Foundation Member', org: 'Masason Foundation', lines: ['Highly selective global fellowship for young innovators; supporting the 2026–2027 research year'] },
  { title: 'AJAS Fellow (2026)',        org: 'American Junior Academy of Science', lines: ['Presented research at the AAAS Annual Conference'] },
  { title: 'Sigma Xi (2026)',           org: 'Sigma Xi, The Scientific Research Honor Society', lines: ['Nominated for membership after meeting CEO and Executive Director Jamie L. Vernon at the AJAS/AAAS conference'] },
  { title: 'Bausch + Lomb Honorary Science Award (2026)', org: 'Bishop Feehan High School', lines: ['Outstanding junior in science'] },
  { title: 'Yale Book Award (2026)',    org: 'Yale University / Bishop Feehan High School', lines: ['Outstanding junior in academics and character'] },
  { title: 'Gold Medal Awards',         org: 'Bishop Feehan High School', lines: ['Science Gold Medal (2026) · Fine Arts Gold Medal (2026, 2024) — highest grade in subject across the grade'] },
];

const fairs = [
  { year: '2024–2025', items: [
    '1st Place — Massachusetts State Science & Engineering Fair',
    'AMD Engineering Excellence Award — Massachusetts State Science Fair',
    'AMD Engineering Excellence Award — Massachusetts Region III Science Fair',
    '1st Place and Excellence in Visual Presentation — Bishop Feehan Science Fair',
  ]},
  { year: '2023–2024', items: [
    '1st Place — Massachusetts Region III Science Fair',
    'Sanofi Special Care Grand Prize — Massachusetts Region III Science Fair',
    'U.S. Air Force Certificate of Achievement — Massachusetts Region III',
    '1st Place and Excellence in Visual Presentation — Bishop Feehan Science Fair',
  ]},
];

const leadership = [
  {
    role: 'Co-Founder — TechForge',
    org:  'Bishop Feehan High School',
    lines: [
      "Co-founded the school's hands-on design and fabrication club, open to grades 9–12",
      'Focus on 3D printing, CNC machining and drone technology',
      'Personally taught 20+ students 3D printing, CNC, hand tools and CAD',
      'Designed and fabricated tactile learning tiles for children with disabilities, donated to Pappas Rehabilitation Hospital',
      "Built a 3D-printed toy conveyor for the school's annual Santa Shop",
    ],
  },
  {
    role: 'Captain — Robotics Team',
    org:  'Bishop Feehan High School',
    lines: [
      'Grew team membership by 25% in a single year',
      "Raised close to $5,000 for a Bambu Lab H2C printer in the school's fabrication lab; secured a $1,000 budget increase from ISEF winnings",
      'Instituted a new organizational, cataloguing and repair system for components',
      'Taught building, 3D printing, CNC, CAD, tool use and design to 20+ students',
      'Volunteered two years at the robotics summer camp, teaching FIRST and FTC to elementary and middle schoolers',
    ],
  },
  {
    role: 'Science Fair Mentoring',
    org:  'Bishop Feehan and online',
    lines: [
      'Mentors students for free, in person and over LinkedIn, Discord and Zoom',
      'Member of the Massachusetts Science & Engineering Fair Advisory Board',
    ],
  },
  {
    role: '1st Clarinet — Concert Band',
    org:  'Bishop Feehan High School',
    lines: [
      'All four years; Honors Band sophomore through senior year',
      'NCBA Honors Band (2026); SEMMEA Districts 2nd Clarinet, 1st Chair (2024)',
      'Band named Outstanding Catholic Concert Band in the United States (2026)',
      'Selected for the NBA Band Symposium at the United States Coast Guard Academy',
    ],
  },
];

const societies = [
  'Science National Honor Society — Vice President',
  'National Honor Society',
  'National Math Honor Society',
  'National English Honor Society',
  'National Social Studies Honor Society',
  'Tri-M Music Honor Society',
  'Société Honoraire de Français',
];

const activities = ['Debate Team — Varsity', 'Math Team — Varsity', 'Engineering Club', 'Jazz Ensemble — Clarinet and Drum Set', 'Percussion Ensemble'];

const skills = [
  { key: 'Engineering & fabrication', val: '3D printing, CNC machining, CAD (Fusion 360, OnShape), electronics design and soldering, prototyping, additive manufacturing, materials science, mechanical / electrical / systems engineering, product design and iteration' },
  { key: 'Programming & technology',  val: 'Arduino, basic programming, Fritzing PCB layout' },
  { key: 'Research & analysis',       val: 'Independent research, data collection and analysis, scientific writing, lab documentation' },
  { key: 'Leadership & operations',   val: 'Team building, project management, fundraising and budgeting, peer mentorship and teaching, public speaking, curriculum design' },
  { key: 'Music',                     val: 'Clarinet, drum set, percussion' },
  { key: 'Languages',                 val: 'English (native), French (studied)' },
];
---

<Layout
  title="Resume — Benjamin Davis"
  description="Resume of Benjamin Davis — advanced manufacturing researcher, ISEF 2025 Regeneron Young Scientist Award winner, Masason Foundation member, and senior at Bishop Feehan High School."
>
  <div class="resume-page">
    <div class="container">

      <div class="r-actions no-print">
        <a href="/benjamin-davis-resume.pdf" class="r-download" download>Download PDF &darr;</a>
        <button class="r-print" type="button">Print</button>
      </div>

      <header class="r-head">
        <h1 class="r-name">Benjamin Davis</h1>
        <p class="r-tagline">Advanced Manufacturing &middot; Bishop Feehan High School, Class of 2027</p>
        <ul class="r-contact">
          {CONTACT.map(c => (
            <li><span class="rc-label">{c.label}</span><a href={c.href}>{c.value}</a></li>
          ))}
        </ul>
      </header>

      <section class="r-section">
        <h2 class="r-h2">Education</h2>
        <p class="r-org">{education.school}</p>
        <p class="r-sub">{education.grad}</p>
        <table class="r-table">
          <tbody>
            {education.rows.map(r => (
              <tr><th scope="row">{r.key}</th><td>{r.val}</td></tr>
            ))}
          </tbody>
        </table>
      </section>

      <section class="r-section">
        <h2 class="r-h2">Awards &amp; Honors</h2>
        {awards.map(a => (
          <div class="r-entry">
            <p class="r-entry-title">{a.title}</p>
            <p class="r-entry-org">{a.org}</p>
            <ul class="r-list">{a.lines.map(l => <li>{l}</li>)}</ul>
          </div>
        ))}
      </section>

      <section class="r-section">
        <h2 class="r-h2">Science Fair Awards</h2>
        {fairs.map(f => (
          <div class="r-entry">
            <p class="r-entry-title">{f.year}</p>
            <ul class="r-list">{f.items.map(l => <li>{l}</li>)}</ul>
          </div>
        ))}
      </section>

      <section class="r-section">
        <h2 class="r-h2">Activities &amp; Leadership</h2>
        {leadership.map(l => (
          <div class="r-entry">
            <p class="r-entry-title">{l.role}</p>
            <p class="r-entry-org">{l.org}</p>
            <ul class="r-list">{l.lines.map(x => <li>{x}</li>)}</ul>
          </div>
        ))}
        <div class="r-entry">
          <p class="r-entry-title">Additional activities</p>
          <p class="r-inline">{activities.join(' · ')}</p>
        </div>
      </section>

      <section class="r-section">
        <h2 class="r-h2">Honor Societies</h2>
        <p class="r-inline">{societies.join(' · ')}</p>
        <p class="r-inline r-inline--sub">75+ hours of community service completed</p>
      </section>

      <section class="r-section">
        <h2 class="r-h2">Skills</h2>
        <table class="r-table">
          <tbody>
            {skills.map(s => (
              <tr><th scope="row">{s.key}</th><td>{s.val}</td></tr>
            ))}
          </tbody>
        </table>
      </section>

    </div>
  </div>
</Layout>

<script>
  document.querySelector('.r-print')?.addEventListener('click', () => window.print());
</script>

<style>
  .resume-page { padding-block: 3rem 4rem; }

  .r-actions {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .r-download,
  .r-print {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
    background: none;
    border: 1px solid var(--gold-dim);
    padding: 0.5rem 0.9rem;
    cursor: pointer;
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s;
  }
  .r-download:hover,
  .r-print:hover { color: var(--gold-bright); border-color: var(--gold); }

  .r-head {
    border-bottom: 1px solid var(--panel-edge);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }
  .r-name {
    font-family: var(--font-head);
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 900;
    line-height: 1;
    color: var(--text);
  }
  .r-tagline {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--copper);
    margin-top: 0.5rem;
  }
  .r-contact {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 0.9rem;
  }
  .r-contact li { display: flex; flex-direction: column; gap: 0.1rem; }
  .rc-label {
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--steel);
  }
  .r-contact a { font-size: 0.84rem; color: var(--gold); text-decoration: none; }
  .r-contact a:hover { color: var(--gold-bright); }

  .r-section { margin-bottom: 2.25rem; }
  .r-h2 {
    font-family: var(--font-head);
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--gold);
    padding-bottom: 0.4rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--panel-edge);
  }

  .r-org {
    font-family: var(--font-head);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
  }
  .r-sub {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--steel);
    margin-bottom: 0.75rem;
  }

  .r-entry { margin-bottom: 1.15rem; }
  .r-entry:last-child { margin-bottom: 0; }
  .r-entry-title {
    font-family: var(--font-head);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.25;
  }
  .r-entry-org {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--copper);
    margin-top: 0.15rem;
  }

  .r-list {
    list-style: none;
    margin-top: 0.45rem;
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
  }
  .r-list li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--steel);
  }
  .r-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 6px;
    height: 1px;
    background: var(--copper);
  }

  .r-inline {
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--steel);
  }
  .r-inline--sub { margin-top: 0.5rem; color: var(--panel-edge); }

  .r-table { width: 100%; border-collapse: collapse; }
  .r-table th {
    text-align: left;
    vertical-align: top;
    width: 30%;
    padding: 0.4rem 0.9rem 0.4rem 0;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--steel);
    border-bottom: 1px solid var(--panel-edge);
  }
  .r-table td {
    padding: 0.4rem 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--text);
    border-bottom: 1px solid var(--panel-edge);
    vertical-align: top;
  }
  .r-table tr:last-child th,
  .r-table tr:last-child td { border-bottom: none; }

  @media (max-width: 560px) {
    .r-table th, .r-table td { display: block; width: 100%; }
    .r-table th { border-bottom: none; padding-bottom: 0.1rem; }
  }

  /* ── Print / PDF ──────────────────────────────────────────────────────────
     The PDF is rendered from this page, so print styles are what the
     downloadable file actually looks like: ink-saving light background,
     no chrome, no page breaks inside an entry.
  ─────────────────────────────────────────────────────────────────────────── */
  @media print {
    /* Ink on paper. The site is dark by design, but a dark resume PDF is
       unreadable printed. Colors are set literally on these selectors rather
       than by overriding :root — a :root override here loses to global.css
       on stylesheet order, which silently leaves the text near-white. */
    :global(body) { background: #fff !important; }
    :global(.site-header),
    :global(footer),
    :global(canvas) { display: none !important; }

    .no-print { display: none !important; }
    .resume-page { padding: 0; background: #fff; }

    .r-name,
    .r-org,
    .r-entry-title,
    .r-table td        { color: #111317 !important; }

    .r-sub,
    .r-list li,
    .r-inline,
    .r-table th,
    .r-contact a       { color: #3c4046 !important; }

    .r-tagline,
    .r-entry-org,
    .rc-label          { color: #8a4f23 !important; }

    .r-h2              { color: #6f5116 !important; }

    .r-inline--sub     { color: #6b7076 !important; }

    .r-head,
    .r-h2,
    .r-table th,
    .r-table td        { border-color: #c9ccd1 !important; }

    .r-list li::before { background: #8a4f23 !important; }
    .r-section { break-inside: auto; margin-bottom: 1.1rem; }
    .r-entry   { break-inside: avoid; margin-bottom: 0.7rem; }
    .r-head    { break-after: avoid; }
    .r-h2      { break-after: avoid; font-size: 1.05rem; margin-bottom: 0.6rem; }
    .r-name    { font-size: 1.9rem; }
    .r-list li, .r-table td, .r-inline { font-size: 0.74rem; line-height: 1.45; }
    .r-table th { font-size: 0.56rem; }
    .r-entry-title { font-size: 0.86rem; }
  }
</style>
