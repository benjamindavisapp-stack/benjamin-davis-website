---
import Layout  from '@/layouts/Layout.astro';
import Lattice from '@/components/Lattice.astro';
import Bolt    from '@/components/Bolt.astro';
import FDMText from '@/components/FDMText.astro';
import { SECTIONS, SOFTWARE, SAFETY } from '@/data/equipment';

const STATUS_LABEL = {
  owned:    null,
  incoming: 'Incoming',
  retired:  'Retired',
} as const;
---

<Layout
  title="Equipment — Benjamin Davis"
  description="The machines, tools and instruments in Benjamin Davis's home workshop — CNC mill and lathe, 3D printers, electronics bench and metrology, and the software behind them."
  ogImage="/images/projects/shop-metalworking.webp"
>

  <!-- ── Hero ───────────────────────────────────────────────────────────────── -->
  <section class="hero">
    <Lattice />
    <Bolt position="tl" />
    <Bolt position="tr" />
    <Bolt position="bl" />
    <Bolt position="br" />
    <div class="container hero-body">
      <p class="hero-eyebrow">Workshop &amp; Lab</p>
      <FDMText id="equip-hero" duration={3.5} delay={0.4}>
        <h1 class="hero-heading">
          The machines<br/>
          <span class="gold">behind the work.</span>
        </h1>
      </FDMText>
      <p class="hero-sub">
        Fabrication &middot; Additive &middot; Electronics &middot; Metrology
      </p>
      <p class="hero-intro">
        Everything here lives in a home workshop. Nothing on this page is a
        school machine or a rented service — if a project on this site says I
        made a part, it came off one of these.
      </p>
    </div>
  </section>

  {SECTIONS.map(sec => {
    /* Machines with a photo get a card; the rest become a compact roster row.
       Rendering an empty 3:2 placeholder for every un-photographed tool turned
       the additive and metrology sections into a wall of grey boxes. */
    const carded = sec.machines.filter(m => m.image);
    const listed = sec.machines.filter(m => !m.image);
    return (
    <section class:list={['equip-section', { 'equip-section--dark': sec.dark }]}>
      <div class="container">
        <div class="section-header">
          <p class="section-overline">{sec.num}</p>
          <FDMText id={`equip-sec-${sec.num}`} duration={2.0} trigger="scroll" delay={0.05}>
            <h2 class="section-title">{sec.title}</h2>
          </FDMText>
          {sec.wip && <span class="section-flag">Building out</span>}
        </div>

        {sec.intro && <p class="section-intro">{sec.intro}</p>}

        {carded.length > 0 && (
          <div class="equip-grid">
            {carded.map(m => (
              <article class:list={['equip-card', { 'equip-card--muted': m.status === 'retired' }]}>
                <div class="card-image-wrap">
                  <img src={m.image} alt={m.imageAlt} width="600" height="400" loading="lazy" decoding="async" />
                </div>

                <div class="card-body">
                  <div class="card-meta">
                    <p class="card-type">{m.type}</p>
                    {STATUS_LABEL[m.status] && (
                      <span class={`status status--${m.status}`}>{STATUS_LABEL[m.status]}</span>
                    )}
                  </div>

                  <h3 class="card-name">{m.name}</h3>
                  {m.acquired && <p class="card-acquired">{m.acquired}</p>}

                  {m.specs && m.specs.length > 0 && (
                    <table class="spec-table">
                      <tbody>
                        {m.specs.map(s => (
                          <tr><th scope="row">{s.key}</th><td>{s.val}</td></tr>
                        ))}
                      </tbody>
                    </table>
                  )}

                  {m.notes && <p class="card-notes">{m.notes}</p>}

                  {m.href && (
                    <a href={m.href} class="card-link">{m.hrefLabel ?? 'Related project'} &rarr;</a>
                  )}
                </div>
              </article>
            ))}
          </div>
        )}

        {listed.length > 0 && (
          <ul class:list={['machine-list', { 'machine-list--spaced': carded.length > 0 }]}>
            {listed.map(m => (
              <li class:list={['machine-row', { 'machine-row--muted': m.status === 'retired' }]}>
                <div class="mr-head">
                  <h3 class="mr-name">{m.name}</h3>
                  {STATUS_LABEL[m.status] && (
                    <span class={`status status--${m.status}`}>{STATUS_LABEL[m.status]}</span>
                  )}
                </div>
                <p class="mr-meta">
                  <span class="mr-type">{m.type}</span>
                  {m.acquired && <><span class="mr-dot" aria-hidden="true">·</span><span>{m.acquired}</span></>}
                </p>
                {m.specs && m.specs.length > 0 && (
                  <p class="mr-specs">
                    {m.specs.map((s, i) => (
                      <>
                        {i > 0 && <span class="mr-dot" aria-hidden="true">·</span>}
                        <span class="mr-spec-key">{s.key}</span>{' '}<span>{s.val}</span>
                      </>
                    ))}
                  </p>
                )}
                {m.notes && <p class="mr-notes">{m.notes}</p>}
                {m.href && (
                  <a href={m.href} class="card-link">{m.hrefLabel ?? 'Related project'} &rarr;</a>
                )}
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
    );
  })}

  <!-- ── Safety & shop practice ─────────────────────────────────────────────── -->
  <section class="equip-section">
    <div class="container">
      <div class="section-header">
        <p class="section-overline">06</p>
        <FDMText id="equip-sec-06" duration={2.0} trigger="scroll" delay={0.05}>
          <h2 class="section-title">Safety &amp; Shop Practice</h2>
        </FDMText>
      </div>

      <p class="section-intro">
        A lathe does not care how old you are. Before either machine conversion
        runs under program control, it is covered by a written risk assessment
        and approval package — <a href="/research/cnc-lathe-conversion">ISO 12100,
        ANSI B11, NFPA 79 and OSHA lockout/tagout</a>, with a witnessed
        commissioning plan. The rest is the equipment that gets worn.
      </p>

      <ul class="software-list">
        {SAFETY.map(s => (
          <li class="software-item">
            <span class="sw-name">{s.name}</span>
            <span class="sw-role">{s.role}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── Software ───────────────────────────────────────────────────────────── -->
  <section class="equip-section equip-section--dark">
    <div class="container">
      <div class="section-header">
        <p class="section-overline">07</p>
        <FDMText id="equip-sec-07" duration={2.0} trigger="scroll" delay={0.05}>
          <h2 class="section-title">Software &amp; Design Tools</h2>
        </FDMText>
      </div>

      <ul class="software-list">
        {SOFTWARE.map(s => (
          <li class="software-item">
            <span class="sw-name">{s.name}</span>
            <span class="sw-role">{s.role}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    padding-block: 5rem 4rem;
    overflow: hidden;
    border-bottom: 1px solid var(--panel-edge);
  }
  .hero-body {
    position: relative;
    z-index: 1;
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--copper);
  }
  .hero-heading {
    font-family: var(--font-head);
    font-size: clamp(2rem, 7vw, 3.5rem);
    font-weight: 900;
    line-height: 1.05;
    color: var(--text);
  }
  .hero-sub {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--steel);
  }
  .hero-intro {
    font-size: 0.95rem;
    line-height: 1.78;
    color: var(--steel);
    max-width: 580px;
    margin-top: 0.4rem;
  }

  /* ── Sections ─────────────────────────────────────────────────────────────── */
  .equip-section {
    padding-block: 4rem;
    border-bottom: 1px solid var(--panel-edge);
  }
  .equip-section--dark { background: var(--panel); }

  .section-header {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--panel-edge);
  }
  .section-overline {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    color: var(--copper);
    flex-shrink: 0;
  }
  .section-title {
    font-family: var(--font-head);
    font-size: clamp(1.5rem, 5vw, 2.2rem);
    font-weight: 900;
    color: var(--text);
  }
  .section-flag {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--copper);
    border: 1px solid var(--gold-dim);
    padding: 0.2rem 0.5rem;
  }
  .section-intro {
    font-size: 0.92rem;
    line-height: 1.72;
    color: var(--steel);
    max-width: 620px;
    margin-bottom: 2rem;
  }

  /* ── Equipment grid ───────────────────────────────────────────────────────── */
  .equip-grid {
    display: grid;
    /* auto-fill, not auto-fit: a section with one photographed machine keeps
       normal card width instead of stretching that photo across the page.
       Empty tracks are invisible because cards carry their own borders. */
    grid-template-columns: repeat(auto-fill, minmax(265px, 1fr));
    gap: 1.25rem;
    align-items: start;
  }

  .equip-card {
    background: var(--graphite);
    border: 1px solid var(--panel-edge);
    display: flex;
    flex-direction: column;
  }
  .equip-section--dark .equip-card { background: var(--panel); }

  /* Retired machines stay in the record but read quieter. */
  .equip-card--muted { opacity: 0.72; }
  .equip-card--muted:hover { opacity: 1; }

  .card-image-wrap {
    overflow: hidden;
    border-bottom: 1px solid var(--panel-edge);
  }
  .card-image-wrap img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: center;
    filter: brightness(0.85) contrast(1.08);
    display: block;
    transition: filter 0.3s;
  }
  .equip-card:hover .card-image-wrap img { filter: brightness(0.95) contrast(1.05); }

  /* ── Roster list (machines without a photo) ───────────────────────────────── */
  .machine-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(265px, 1fr));
    gap: 1.25rem;
    align-items: start;
  }
  .machine-list--spaced { margin-top: 1.25rem; }

  .machine-row {
    background: var(--graphite);
    border: 1px solid var(--panel-edge);
    padding: 1.1rem 1.15rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .equip-section--dark .machine-row { background: var(--panel); }
  .machine-row--muted { opacity: 0.72; }
  .machine-row--muted:hover { opacity: 1; }

  .mr-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .mr-name {
    font-family: var(--font-head);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.2;
  }
  .mr-meta,
  .mr-specs {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--steel);
    line-height: 1.6;
  }
  .mr-type { color: var(--copper); }
  .mr-dot  { color: var(--panel-edge); margin-inline: 0.35rem; }
  .mr-specs { text-transform: none; letter-spacing: 0.04em; }
  .mr-spec-key { color: var(--steel); opacity: 0.8; }
  .mr-notes {
    font-size: 0.8rem;
    line-height: 1.65;
    color: var(--steel);
    margin-top: 0.1rem;
  }

  .card-body {
    padding: 1.2rem 1.15rem 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .card-type {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--copper);
  }
  .status {
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.16rem 0.44rem;
    border: 1px solid currentColor;
    flex-shrink: 0;
  }
  .status--incoming { color: var(--copper); }
  .status--retired  { color: var(--steel);  }

  .card-name {
    font-family: var(--font-head);
    font-size: 1.12rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.18;
  }
  .card-acquired {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    color: var(--steel);
  }

  .card-notes {
    font-size: 0.8rem;
    line-height: 1.65;
    color: var(--steel);
    margin-top: auto;
    padding-top: 0.3rem;
  }

  .card-link {
    display: inline-block;
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    color: var(--gold);
    text-decoration: none;
    transition: color 0.15s;
  }
  .card-link:hover { color: var(--gold-bright); }

  /* ── Spec table ───────────────────────────────────────────────────────────── */
  .spec-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.74rem;
    margin-top: 0.2rem;
  }
  .spec-table tr { border-bottom: 1px solid var(--panel-edge); }
  .spec-table tr:last-child { border-bottom: none; }
  .spec-table th {
    text-align: left;
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--steel);
    padding: 0.26rem 0.5rem 0.26rem 0;
    width: 38%;
    vertical-align: top;
  }
  .spec-table td {
    color: var(--text);
    padding: 0.26rem 0;
    vertical-align: top;
  }

  /* ── Software list ────────────────────────────────────────────────────────── */
  .software-list {
    list-style: none;
    border: 1px solid var(--panel-edge);
  }
  .software-item {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid var(--panel-edge);
    transition: background 0.15s;
  }
  .software-item:last-child { border-bottom: none; }
  .software-item:hover { background: var(--graphite); }
  .sw-name {
    font-family: var(--font-head);
    font-size: 1rem;
    font-weight: 700;
    color: var(--gold);
    min-width: 150px;
    flex-shrink: 0;
  }
  .sw-role { font-size: 0.82rem; color: var(--steel); line-height: 1.55; }

  .gold { color: var(--gold); }

  @media (max-width: 680px) {
    .software-item { flex-direction: column; gap: 0.25rem; }
    .sw-name { min-width: unset; }
  }
</style>
