---
import Layout  from '@/layouts/Layout.astro';
import Lattice from '@/components/Lattice.astro';
import Bolt    from '@/components/Bolt.astro';
import FDMText from '@/components/FDMText.astro';

const additive = [
  {
    name:    'Bambu Lab X2D',
    type:    'FDM 3D Printer — Dual Nozzle',
    specs: [
      { key: 'Build volume',  val: '256 × 256 × 260 mm' },
      { key: 'Speed',         val: 'Up to 1000 mm/s' },
      { key: 'Chamber',       val: 'Enclosed, actively heated to 65 °C' },
      { key: 'Multi-material', val: 'Dual nozzle + AMS 2 Pro' },
    ],
    notes:   'The lab printer at Bishop Feehan, bought with ISEF winnings. Jigs, fixtures, printed tooling, and TechForge student projects all run on it. I send the engineering filaments to this one because of the chamber: PC and nylon keep shrinking as they cool, so on an open printer the bottom of a tall part finishes contracting while the top is still being laid down, and the corners lift off the plate somewhere in the middle. Holding the chamber at 65 °C keeps the whole part at one temperature until it is done.',
    image:   null,
    imageAlt: 'Bambu Lab X2D dual-nozzle 3D printer in the fabrication lab',
  },
  {
    name:    'Bambu Lab A1',
    type:    'FDM 3D Printer',
    specs: [
      { key: 'Build volume',  val: '256 × 256 × 256 mm' },
      { key: 'Speed',         val: 'Up to 500 mm/s' },
      { key: 'Multi-material', val: 'AMS lite, 4 colors' },
      { key: 'Location',      val: 'Home workshop' },
    ],
    notes:   'My own printer, and the one every batch of recycled filament gets tried on first. It is open-frame, so I can see the first layer going down from across the garage and stop a run as soon as the extrusion starts to look starved (which is what a diameter dip looks like before the calipers confirm it). If a spool is going to jam an extruder, I would rather it jam this one than the lab machine.',
    image:   null,
    imageAlt: 'Bambu Lab A1 printer on the workshop bench',
  },
  {
    name:    'Creality Halot R6',
    type:    'MSLA Resin 3D Printer',
    specs: [
      { key: 'Build volume', val: '130 × 80 × 160 mm' },
      { key: 'XY resolution', val: '50 µm (2560 × 1620, 2K)' },
      { key: 'Layer height',  val: '0.01 – 0.2 mm' },
      { key: 'Light source',  val: '405 nm UV LED' },
    ],
    notes:   'For the parts where FDM layer lines are too coarse to tell me anything — small housings, and the thread-fit coupons I check under a loupe. At 50 µm in XY it holds a feature the A1 would turn into a staircase. The floor is 130 × 80 mm and cured resin is brittle, so nothing structural comes off it.',
    image:   null,
    imageAlt: 'Creality Halot R6 resin printer with its lid closed',
  },
  {
    name:    'Creality UW-03',
    type:    'Wash & Cure Station',
    specs: [
      { key: 'Wash volume',  val: '6.72 L (210 × 160 × 200 mm)' },
      { key: 'Cure volume',  val: '10.64 L (215 × 165 × 300 mm)' },
      { key: 'UV array',     val: '18 × 405 nm LED, 360° exposure' },
      { key: 'Cycle time',   val: '5 – 30 min, wash or cure' },
    ],
    notes:   'A resin print is not finished when the printer stops. The part comes out coated in uncured resin, and that film has to come off in isopropyl before the UV array can reach what is underneath it; the cure is the step that takes the part from soft to full hardness. Doing both in one machine means I am not carrying a dripping part across the garage between them.',
    image:   null,
    imageAlt: 'Creality UW-03 wash and cure station next to the resin printer',
  },
];

const cnc = [
  {
    name:    'Bridgeport Series I — CNC Retrofit',
    type:    'Vertical Knee Mill',
    specs: [
      { key: 'Control',   val: '3-axis CNC retrofit' },
      { key: 'Spindle',   val: 'R8 taper' },
      { key: 'Table',     val: '9 × 42 in' },
      { key: 'Materials', val: 'Steel, aluminum, brass' },
    ],
    notes:   'The heavy machine, and the only one here with the mass to take a real cut in steel. It cut the fixture plates for the extrusion system, faced stock flat, and bored the bearing seats — a twist drill walks as it enters, and a shaft sitting in a walked hole will never run true, so those seats had to come out of a boring head.',
    image:   null,
    imageAlt: 'Bridgeport knee mill with CNC retrofit in the workshop',
  },
  {
    name:    'Genmitsu 3030-PROVer',
    type:    'Desktop CNC Router',
    specs: [
      { key: 'Work area', val: '300 × 300 mm' },
      { key: 'Motion',    val: 'Ball screws, dual linear guides' },
      { key: 'Materials', val: 'Brass, aluminum, acrylic, wood' },
    ],
    notes:   'The small, precise one. It cut the engraving plates for the brass business cards and the panel cutouts for the control box. The ball screws are the part that matters: a lead screw has backlash, so the cutter lags behind the axis every time it reverses and one side of an engraved line comes out wider than the other. On this one the line is the same width in both directions, which is the whole reason the card lettering is legible.',
    image:   null,
    imageAlt: 'Genmitsu desktop CNC router engraving a brass plate',
  },
];

const handTools = [
  { name: 'Drill press',   role: 'Hole placement on the extruder frame. A hand drill wanders off the punch mark; this one does not.' },
  { name: 'Dremel',        role: 'Cut-off wheels and carbide burrs, for the clearance cuts and the deburring in spots nothing larger reaches' },
  { name: 'Angle grinder', role: 'Cutting steel section to length for the frame, and bulk stock removal before anything needs to be accurate' },
  { name: 'Tap & die set', role: 'I cut every threaded hole on the extrusion machine by hand with these' },
  { name: 'Files',         role: 'Fitting parts that came off the mill a few thousandths proud, and breaking the edges before assembly' },
  { name: 'Bench vise',    role: 'Holds the work for all of the above' },
];

const electronics = [
  {
    name:    'Soldering Station',
    type:    'Electronics Fabrication',
    specs: [
      { key: 'Type',   val: 'Temperature-controlled iron' },
      { key: 'Use',    val: 'PCB assembly, wire harnesses, sensors' },
    ],
    notes:   'Used for all custom electronics in the extrusion system: motor driver boards, thermocouple wiring, control panel assemblies.',
    image:   null,
    imageAlt: 'Temperature-controlled soldering station on electronics bench',
  },
  {
    name:    'Digital Instruments',
    type:    'Measurement & Test',
    specs: [
      { key: 'DMM',       val: 'Benchtop multimeter' },
      { key: 'Calipers',  val: 'Digital, 0.01 mm resolution' },
    ],
    notes:   'The calipers are what every manufactured component gets checked against, and they are how I confirmed the filament was holding ±0.05 mm. A 0.01 mm resolution is enough to catch a batch drifting out of that band, though a dedicated filament gauge would catch it sooner than I do now.',
    image:   null,
    imageAlt: 'Digital calipers measuring a machined part',
  },
  {
    name:    'Microcontroller Platform',
    type:    'Embedded Control',
    specs: [
      { key: 'Platform', val: 'Arduino (various)' },
      { key: 'IDE',      val: 'Arduino IDE + Fritzing for PCB design' },
    ],
    notes:   'Control system for motor speed, temperature PID loops, and sensor data acquisition in the From Crude to Extrude machine.',
    image:   null,
    imageAlt: 'Arduino microcontroller board with wired peripherals',
  },
];

const research = [
  {
    name:    'From Crude to Extrude — Extrusion/Pultrusion System',
    type:    'Custom Research Apparatus',
    specs: [
      { key: 'Sub-systems',   val: '7 integrated' },
      { key: 'Parts',         val: '30+ CAD-designed & manufactured' },
      { key: 'Build time',    val: '800+ hours over 8 months' },
      { key: 'Output',        val: 'Filament to ±0.05 mm tolerance' },
      { key: 'Energy saving', val: '~43 % vs. standard re-extrusion' },
    ],
    notes:   'The flagship machine: a novel combination of extrusion and pultrusion that recycles PET bottle waste and 3D-printing purge material into additive manufacturing filament. Built entirely in the home workshop from scratch. Produced 1st-place ISEF results and the Regeneron Young Scientist Award.',
    href:    '/research/from-crude-to-extrude',
    image:   '/images/machine-full.jpg',
    imageAlt: 'The From Crude to Extrude recycling machine at ISEF 2025',
    featured: true,
  },
];

const software = [
  { name: 'Fusion 360',   role: 'Parametric CAD & CAM for all machined and 3D-printed parts' },
  { name: 'OnShape',      role: 'Cloud-based CAD for collaborative and quick-iterate designs' },
  { name: 'Fritzing',     role: 'PCB schematic and board layout for custom electronics' },
  { name: 'Bambu Studio', role: 'Slicer for all Bambu Lab print jobs; multi-color setup' },
  { name: 'Halot Box',    role: 'Slicer for the Halot R6; resin exposure and support tuning' },
  { name: 'Arduino IDE',  role: 'Firmware development for embedded control systems' },
];
---

<Layout
  title="Equipment — Benjamin Davis"
  description="The printers, machines and measuring kit I actually build with — what each one is for, and what it cost."
>

  <!-- ── Hero ───────────────────────────────────────────────────────────────── -->
  <section class="hero">
    <Lattice material="carbide" />
    <Bolt position="tl" />
    <Bolt position="tr" />
    <Bolt position="bl" />
    <Bolt position="br" />
    <div class="container hero-body">
      <p class="hero-eyebrow">Workshop &amp; Lab</p>
      <FDMText id="equip-hero" duration={3.5} delay={0.4}>
        <h1 class="hero-heading">
          The machines<br/>
          <span class="gold">behind the work.</span>
        </h1>
      </FDMText>
      <p class="hero-sub">
        Some of this is in the school fabrication lab. The rest is in a garage.
      </p>
    </div>
  </section>

  <!-- ── 01 Additive Manufacturing ──────────────────────────────────────────── -->
  <section class="equip-section">
    <div class="container">
      <div class="section-header">
        <p class="section-overline">01</p>
        <FDMText id="equip-sec-01" duration={2.2} trigger="scroll" delay={0.05}>
          <h2 class="section-title">Additive Manufacturing</h2>
        </FDMText>
      </div>

      <div class="equip-grid">
        {additive.map(item => (
          <article class="equip-card">
            {item.image
              ? <div class="card-image-wrap">
                  <img src={item.image} alt={item.imageAlt}
                    width="600" height="400" loading="lazy" />
                </div>
              : null
            }
            <div class="card-body">
              <p class="card-type">{item.type}</p>
              <h3 class="card-name">{item.name}</h3>
              <table class="spec-table">
                {item.specs.map(s => (
                  <tr>
                    <th>{s.key}</th>
                    <td>{s.val}</td>
                  </tr>
                ))}
              </table>
              <p class="card-notes">{item.notes}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── 02 CNC & Machining ─────────────────────────────────────────────────── -->
  <section class="equip-section equip-section--dark">
    <div class="container">
      <div class="section-header">
        <p class="section-overline">02</p>
        <FDMText id="equip-sec-02" duration={2.2} trigger="scroll" delay={0.05}>
          <h2 class="section-title">CNC &amp; Machining</h2>
        </FDMText>
      </div>

      <div class="equip-grid">
        {cnc.map(item => (
          <article class="equip-card">
            {item.image
              ? <div class="card-image-wrap">
                  <img src={item.image} alt={item.imageAlt}
                    width="600" height="400" loading="lazy" />
                </div>
              : null
            }
            <div class="card-body">
              <p class="card-type">{item.type}</p>
              <h3 class="card-name">{item.name}</h3>
              <table class="spec-table">
                {item.specs.map(s => (
                  <tr><th>{s.key}</th><td>{s.val}</td></tr>
                ))}
              </table>
              <p class="card-notes">{item.notes}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="sub-header">
        <h3 class="sub-title">Bench &amp; hand tools</h3>
        <p class="sub-note">Not glamorous, and responsible for most of the 800 hours.</p>
      </div>

      <ul class="stack-list">
        {handTools.map(t => (
          <li class="stack-item">
            <span class="stack-name">{t.name}</span>
            <span class="stack-role">{t.role}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── 03 Electronics & Measurement ──────────────────────────────────────── -->
  <section class="equip-section">
    <div class="container">
      <div class="section-header">
        <p class="section-overline">03</p>
        <FDMText id="equip-sec-03" duration={2.0} trigger="scroll" delay={0.05}>
          <h2 class="section-title">Electronics &amp; Measurement</h2>
        </FDMText>
      </div>

      <div class="equip-grid equip-grid--three">
        {electronics.map(item => (
          <article class="equip-card">
            {item.image
              ? <div class="card-image-wrap">
                  <img src={item.image} alt={item.imageAlt}
                    width="600" height="400" loading="lazy" />
                </div>
              : null
            }
            <div class="card-body">
              <p class="card-type">{item.type}</p>
              <h3 class="card-name">{item.name}</h3>
              <table class="spec-table">
                {item.specs.map(s => (
                  <tr><th>{s.key}</th><td>{s.val}</td></tr>
                ))}
              </table>
              <p class="card-notes">{item.notes}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── 04 Research Apparatus ──────────────────────────────────────────────── -->
  <section class="equip-section equip-section--dark">
    <div class="container">
      <div class="section-header">
        <p class="section-overline">04</p>
        <FDMText id="equip-sec-04" duration={2.0} trigger="scroll" delay={0.05}>
          <h2 class="section-title">Research Apparatus</h2>
        </FDMText>
      </div>

      {research.map(item => (
        <article class="featured-card">
          {item.image
            ? <div class="fc-image-wrap">
                <img src={item.image} alt={item.imageAlt}
                  width="800" height="500" loading="lazy" />
              </div>
            : null
          }
          <div class="fc-body">
            <p class="card-type">{item.type}</p>
            <h3 class="fc-name">{item.name}</h3>
            <table class="spec-table spec-table--featured">
              {item.specs.map(s => (
                <tr><th>{s.key}</th><td>{s.val}</td></tr>
              ))}
            </table>
            <p class="card-notes fc-notes">{item.notes}</p>
            {item.href && (
              <a href={item.href} class="fc-link">
                Full project write-up →
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ── 05 Software & Design Tools ────────────────────────────────────────── -->
  <section class="equip-section">
    <div class="container">
      <div class="section-header">
        <p class="section-overline">05</p>
        <FDMText id="equip-sec-05" duration={2.0} trigger="scroll" delay={0.05}>
          <h2 class="section-title">Software &amp; Design Tools</h2>
        </FDMText>
      </div>

      <ul class="stack-list">
        {software.map(s => (
          <li class="stack-item">
            <span class="stack-name">{s.name}</span>
            <span class="stack-role">{s.role}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    padding-block: 5rem 4rem;
    overflow: hidden;
    border-bottom: 1px solid var(--panel-edge);
  }
  .hero-body {
    position: relative;
    z-index: 1;
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--copper);
  }
  .hero-heading {
    font-family: var(--font-head);
    font-size: clamp(2rem, 7vw, 3.5rem);
    font-weight: 900;
    line-height: 1.05;
    color: var(--text);
  }
  .hero-sub {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--steel);
  }

  /* ── Sections ─────────────────────────────────────────────────────────────── */
  .equip-section {
    padding-block: 4rem;
    border-bottom: 1px solid var(--panel-edge);
  }
  .equip-section--dark { background: var(--panel); }

  .section-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 2.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--panel-edge);
  }
  .section-overline {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    color: var(--copper);
    flex-shrink: 0;
  }
  .section-title {
    font-family: var(--font-head);
    font-size: clamp(1.5rem, 5vw, 2.2rem);
    font-weight: 900;
    color: var(--text);
  }

  /* ── Equipment grid ───────────────────────────────────────────────────────── */
  .equip-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr));
    gap: 1px;
    border: 1px solid var(--panel-edge);
  }
  .equip-grid--three {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  /* ── Equipment card ───────────────────────────────────────────────────────── */
  .equip-card {
    background: var(--panel);
    display: flex;
    flex-direction: column;
  }
  .card-image-wrap {
    overflow: hidden;
    border-bottom: 1px solid var(--panel-edge);
  }
  .card-image-wrap img {
    width: 100%;
    aspect-ratio: 3/2;
    object-fit: cover;
    filter: brightness(0.85) contrast(1.08);
    display: block;
    transition: filter 0.3s;
  }
  .equip-card:hover .card-image-wrap img { filter: brightness(0.92) contrast(1.06); }

  .img-placeholder {
    background: var(--graphite);
    border-bottom: 1px solid var(--panel-edge);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--steel);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    padding: 0.75rem;
    text-align: center;
  }
  .img-placeholder::before { content: attr(data-label); }

  .card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex: 1;
  }
  .card-type {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--copper);
  }
  .card-name {
    font-family: var(--font-head);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.2;
  }
  .card-notes {
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--steel);
    margin-top: auto;
    padding-top: 0.4rem;
  }

  /* ── Spec table ───────────────────────────────────────────────────────────── */
  .spec-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.76rem;
  }
  .spec-table tr { border-bottom: 1px solid var(--panel-edge); }
  .spec-table tr:last-child { border-bottom: none; }
  .spec-table th {
    text-align: left;
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--steel);
    padding: 0.28rem 0.5rem 0.28rem 0;
    width: 40%;
    vertical-align: top;
  }
  .spec-table td {
    color: var(--text);
    padding: 0.28rem 0;
    vertical-align: top;
  }
  .spec-table--featured th { width: 30%; }

  /* ── Featured research card ───────────────────────────────────────────────── */
  .featured-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--panel-edge);
    background: var(--graphite);
    overflow: hidden;
  }
  .fc-image-wrap { overflow: hidden; }
  .fc-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.85) contrast(1.08);
    display: block;
  }
  .fc-image-placeholder {
    min-height: 280px;
    background: var(--panel);
    border-right: 1px solid var(--panel-edge);
  }
  .fc-body {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .fc-name {
    font-family: var(--font-head);
    font-size: clamp(1.1rem, 3vw, 1.55rem);
    font-weight: 900;
    color: var(--text);
    line-height: 1.2;
  }
  .fc-notes { font-size: 0.83rem; line-height: 1.65; color: var(--steel); }
  .fc-link {
    display: inline-block;
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.70rem;
    letter-spacing: 0.06em;
    color: var(--copper);
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    transition: color 0.15s;
  }
  .fc-link:hover { color: var(--gold-bright); }

  /* ── Sub-header (within a section) ─────────────────────────────────────────── */
  .sub-header {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-block: 2.5rem 1.25rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--panel-edge);
  }
  .sub-title {
    font-family: var(--font-head);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--text);
  }
  .sub-note {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--steel);
  }

  /* ── Shared name + role list (software, hand tools) ───────────────────────── */
  .stack-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--panel-edge);
  }
  .stack-item {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid var(--panel-edge);
    transition: background 0.15s;
  }
  .stack-item:last-child { border-bottom: none; }
  .stack-item:hover { background: var(--panel); }
  .stack-name {
    font-family: var(--font-head);
    font-size: 1rem;
    font-weight: 700;
    color: var(--gold);
    min-width: 130px;
    flex-shrink: 0;
  }
  .stack-role { font-size: 0.82rem; color: var(--steel); line-height: 1.5; }

  /* ── Gold accent ──────────────────────────────────────────────────────────── */
  .gold { color: var(--gold); }

  /* ── Responsive ───────────────────────────────────────────────────────────── */
  @media (max-width: 680px) {
    .featured-card { grid-template-columns: 1fr; }
    .fc-image-wrap { max-height: 200px; }
    .fc-body { padding: 1.25rem; }
    .stack-item { flex-direction: column; gap: 0.25rem; }
    .stack-name { min-width: unset; }
  }
</style>
