---
import ProjectLayout  from '@/layouts/ProjectLayout.astro';
import ProjectSection from '@/components/ProjectSection.astro';
import ProjectGallery from '@/components/ProjectGallery.astro';
import SpecTable      from '@/components/SpecTable.astro';
import Credits        from '@/components/Credits.astro';
import { getProject, getNeighbours } from '@/data/projects';

const p = getProject('from-crude-to-extrude');
---

<ProjectLayout
  title={p.title}
  subtitle="Flagship Research"
  role={p.role}
  year={p.year}
  tags={p.tags}
  overview={p.summary}
  ogImage={p.cover}
  specs={[
    { key: 'Build hours',        value: '800+'  },
    { key: 'Component versions', value: '50+'   },
    { key: 'More efficient',     value: '43%'   },
    { key: 'Lower emissions',    value: '~5×'   },
    { key: 'Lower cost',         value: '~90%'  },
  ]}
  {...getNeighbours(p.slug)}
>

  <ProjectSection num="01" title="What it does" dark>
    <p>
      Most plastic recycling happens somewhere else, at a scale no individual
      can reach. This machine does it on a desk. It takes PET bottle waste and
      the purge material every 3D printer throws away, and runs it through a
      single line that combines two processes normally done on separate
      machines — <strong>pultrusion</strong>, which pulls material through a
      heated die, and <strong>extrusion</strong>, which pushes it. The output
      is filament a printer can actually use.
    </p>
    <p>
      I designed the mechanical and electrical systems, made every part, and
      built and tested it over more than 800 hours and 50-plus component
      iterations.
    </p>

    <ProjectGallery
      cols={2}
      images={[
        {
          src: '/images/projects/fcte-feedstock.webp',
          alt: 'Shredded 3D-printing purge material weighed out on a digital scale before a run',
          caption: 'Feedstock: shredded printer purge, weighed per run so the energy and yield numbers are comparable.',
        },
        {
          src: '/images/machine-detail-auger.jpg',
          alt: 'Close view of the machine with the auger and heated barrel visible behind the frame',
          caption: 'The extrusion line: auger, heated barrel and die, with the three temperature zones labeled on the frame.',
        },
      ]}
    />
  </ProjectSection>

  <ProjectSection num="02" title="Results">
    <p>
      Measured against standard extrusion and re-extrusion of the same
      material:
    </p>
    <SpecTable
      caption="Measured against standard extrusion / re-extrusion"
      rows={[
        { key: 'Energy efficiency',    value: '43% more efficient' },
        { key: 'Particulate emissions', value: 'About 5× lower' },
        { key: 'Filament tolerance',   value: 'Approaching commercial tolerances' },
        { key: 'Cost',                 value: 'About 90% lower filament cost' },
      ]}
    />
    <p>
      Emissions were measured with a handheld particulate and VOC meter at the
      extruder outlet across the full run, not just at steady state — the
      start-up transient is where cheap extrusion does most of its damage.
    </p>
  </ProjectSection>

  <ProjectSection num="03" title="How it is built" dark>
    <p>
      Three heat zones run at roughly <strong>150 °C, 200 °C and 202 °C</strong>,
      driven by band heaters under PID control. Material enters through a
      hopper, is conveyed and compressed by the auger, exits the die into a
      water cooling bath, and is drawn down to diameter by a puller before
      being wound on a spooler running printed herringbone gears.
    </p>

    <SpecTable
      caption="Subsystems"
      rows={[
        { key: 'Heat zones',   value: 'Three band-heater zones — approx. 150 / 200 / 202 °C' },
        { key: 'Feed',         value: 'Hopper into a compression auger' },
        { key: 'Cooling',      value: 'Water bath downstream of the die' },
        { key: 'Draw-down',    value: 'Powered puller sets final diameter' },
        { key: 'Spooler',      value: 'Printed herringbone gear train' },
        { key: 'Power',        value: 'Mean Well 24 V supply' },
        { key: 'Motor control', value: 'Repurposed Creality printer board' },
      ]}
    />

    <h3>The auger</h3>
    <p>
      The compression screw is the part that decides whether any of this works.
      I made mine on my modified version of Jacob Franz and Joshua Pearce's
      open-source compression-screw grinder, scaled up to cut larger augers
      than the original design handles. Grinding it by hand holds roughly
      ±0.2 mm — good enough to prove the concept, and the first thing the
      <a href="/research/gen-2-filament-research">second-generation machine</a> fixes.
    </p>

    <ProjectGallery
      cols={3}
      images={[
        {
          src: '/images/projects/fcte-barrel.webp',
          alt: 'The stainless extrusion barrel standing vertically on its base plate with band heaters clamped along its length',
          caption: 'Barrel and band heaters during assembly.',
        },
        {
          src: '/images/projects/fcte-control-panel.webp',
          alt: 'The control panel with four PID temperature controllers, a motor speed dial and switchgear',
          caption: 'PID controllers, one per heat zone, plus auger speed control.',
        },
        {
          src: '/images/projects/fcte-machine-open.webp',
          alt: 'The machine with its covers off, showing wiring runs, the labeled heat zones and the full extrusion line',
          caption: 'Covers off, mid-build — every zone labeled and individually controlled.',
        },
      ]}
    />
  </ProjectSection>

  <ProjectSection num="04" title="Recognition">
    <SpecTable
      caption="Awards"
      rows={[
        { key: 'ISEF 2025', value: 'Regeneron Young Scientist Award', note: 'One of two worldwide · $75,000' },
        { key: 'ISEF 2025', value: '1st Place, Engineering Technology: Statics & Dynamics' },
        { key: 'Massachusetts State Science Fair', value: '1st Place, and AMD Engineering Excellence Award' },
        { key: 'Region III', value: 'AMD Award' },
        { key: 'Bishop Feehan', value: 'Best of Fair' },
      ]}
    />

    <p>
      The project's official record, including the abstract as submitted, is on
      the <a href="https://isef.net/project/etsd057-pultrusion-and-extrusion-to-recycle-filament" target="_blank" rel="noopener noreferrer">ISEF Virtual Showcase</a>.
    </p>

    <ProjectGallery
      cols={2}
      images={[
        {
          src: '/images/isef-booth.jpg',
          alt: 'Benjamin Davis standing at his ISEF 2025 booth beside the display board and the machine',
          caption: 'ISEF 2025, Columbus.',
        },
        {
          src: '/images/isef-award.jpg',
          alt: 'Benjamin Davis beside the project display board and machine at the fair',
          caption: 'The board and the machine traveled together to every fair.',
        },
      ]}
    />
  </ProjectSection>

  <ProjectSection num="05" title="Credits" dark>
    <Credits
      items={[
        'Puller motor mount and spooler adapted from two open online CAD files.',
        'Kelly Gomez advised on documentation and on using the school CNC router.',
        'My parents supervised testing for safety.',
        "Auger ground on my modified version of Jacob Franz and Joshua Pearce's open-source compression-screw grinder.",
      ]}
    />
  </ProjectSection>

</ProjectLayout>
