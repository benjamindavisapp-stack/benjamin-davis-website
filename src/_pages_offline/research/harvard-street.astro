---
import ProjectLayout  from '@/layouts/ProjectLayout.astro';
import ProjectSection from '@/components/ProjectSection.astro';
import ProjectGallery from '@/components/ProjectGallery.astro';
import { getProject, getNeighbours } from '@/data/projects';

const p = getProject('harvard-street');
---

<ProjectLayout
  title={p.title}
  subtitle="Team & Community · In progress"
  role={p.role}
  year={p.year}
  tags={p.tags}
  overview={p.summary}
  {...getNeighbours(p.slug)}
>

  <ProjectSection num="01" title="The problem" dark>
    <p>
      The Harvard Street entrance to Bishop Feehan has a traffic and logistics
      problem. Right now it is managed with cones — which means someone has to
      put them out, someone has to bring them in, and in between they are only
      as effective as drivers choose to find them.
    </p>
    <p>
      For Engineering II, my partner and I are treating it as a real design
      problem rather than a worksheet: observe how the entrance actually gets
      used, then propose something that works without a person standing there.
    </p>
  </ProjectSection>

  <ProjectSection num="02" title="The concept">
    <p>
      The current direction is a <strong>solar-powered gate opener</strong>
      operated by remote, paired with either a barrier arm or a lit
      <strong>"Do Not Exit"</strong> sign in place of the cones.
    </p>
    <p>
      Solar matters because the entrance has no convenient power, and running
      a trench to it would cost more than the problem is worth. A remote
      matters because whoever opens the entrance in the morning is usually
      already in a car.
    </p>
  </ProjectSection>

  <ProjectSection num="03" title="Status" dark>
    <p>
      This project is <strong>in progress</strong> through Fall 2026. The
      concept is settled; the design work, testing and results are still
      ahead, and this page will be updated as they land.
    </p>

    <ProjectGallery
      cols={1}
      ratio="16 / 9"
      images={[
        {
          alt: 'The Harvard Street entrance and the proposed gate concept — photographs to follow as the project progresses',
          pending: 'Photos to come — work in progress',
        },
      ]}
    />
  </ProjectSection>

</ProjectLayout>
