---
interface Props {
  position: 'tl' | 'tr' | 'bl' | 'br';
  size?: number;
}
const { position, size = 18 } = Astro.props;
---

<span class:list={['bolt', `bolt-${position}`]} aria-hidden="true">
  <svg
    viewBox="0 0 20 20"
    width={size}
    height={size}
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- Hex head, flat-top orientation -->
    <polygon
      points="18.8,10 14.4,2.38 5.6,2.38 1.2,10 5.6,17.62 14.4,17.62"
      stroke="var(--panel-edge)" stroke-width="1.2" fill="var(--panel)" />
    <!-- Machined head face, a step lighter than the head side so the
         chamfer reads as a top surface -->
    <polygon
      points="16.9,10 13.45,4.02 6.55,4.02 3.1,10 6.55,15.98 13.45,15.98"
      stroke="var(--panel-edge)" stroke-width="0.7" fill="var(--panel-edge)" opacity="0.85" />
    <!-- Torx (6-lobe) recess. Two same-shape unions of overlapping circles:
         a slightly larger light one underneath becomes the rim catching
         light, the near-black one on top is the recess itself. -->
    <g fill="var(--steel)" opacity="0.55">
      <circle cx="10"   cy="10"    r="3.15" />
      <circle cx="13.0" cy="10"    r="2.0"  />
      <circle cx="11.5" cy="7.40"  r="2.0"  />
      <circle cx="8.5"  cy="7.40"  r="2.0"  />
      <circle cx="7.0"  cy="10"    r="2.0"  />
      <circle cx="8.5"  cy="12.60" r="2.0"  />
      <circle cx="11.5" cy="12.60" r="2.0"  />
    </g>
    <g fill="#08090b">
      <circle cx="10"   cy="10"    r="2.7"  />
      <circle cx="13.0" cy="10"    r="1.55" />
      <circle cx="11.5" cy="7.40"  r="1.55" />
      <circle cx="8.5"  cy="7.40"  r="1.55" />
      <circle cx="7.0"  cy="10"    r="1.55" />
      <circle cx="8.5"  cy="12.60" r="1.55" />
      <circle cx="11.5" cy="12.60" r="1.55" />
    </g>
  </svg>
</span>

<style>
  .bolt {
    position: absolute;
    z-index: 2;
    opacity: 0.7;
    transform-origin: center;
    animation: bolt-seat 0.55s cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }
  .bolt-tl { top:    0.85rem; left:  0.85rem; animation-delay: 0.08s; }
  .bolt-tr { top:    0.85rem; right: 0.85rem; animation-delay: 0.18s; }
  .bolt-bl { bottom: 0.85rem; left:  0.85rem; animation-delay: 0.28s; }
  .bolt-br { bottom: 0.85rem; right: 0.85rem; animation-delay: 0.38s; }

  /* Lathe / turning: bolt descends and rotates as if being tightened */
  @keyframes bolt-seat {
    0%   { opacity: 0;   transform: scale(0.45) rotate(0deg);   }
    55%  { opacity: 0.8; transform: scale(1.06) rotate(108deg); }
    80%  { opacity: 0.7; transform: scale(0.97) rotate(120deg); }
    100% { opacity: 0.7; transform: scale(1)    rotate(120deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bolt { animation: none; }
  }
</style>
