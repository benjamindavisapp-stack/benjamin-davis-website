---
// AnodizeText.astro — Anodizing text treatment.
// Letters begin as bare brushed-aluminium, then undergo an electrolytic
// anodizing sequence: electrolysis bubbles rise, a wavy dye front floods
// left→right absorbing into the metal surface, and a satin iridescent
// finish settles. The real heading stays in the DOM (canvas is aria-hidden).
interface Props {
  duration?: number;              // total seconds (default 2.8)
  delay?:    number;              // seconds before animation starts (default 0.25)
  trigger?:  'scroll' | 'load';
  color?:    'accent' | 'blue' | 'red' | 'purple' | 'gold' | 'black';
  id?:       string;
  class?:    string;
}
const {
  duration = 2.8,
  delay    = 0.25,
  trigger  = 'scroll',
  color    = 'accent',
  id,
  class: cls,
} = Astro.props;
const anoId = id ?? ('ano-' + Math.random().toString(36).slice(2, 8));
---

<div
  class:list={['ano-wrap', cls]}
  data-ano-duration={String(duration)}
  data-ano-delay={String(delay)}
  data-ano-trigger={trigger}
  data-ano-color={color}
  data-ano-id={anoId}
>
  <slot />
  <canvas class="ano-bed" aria-hidden="true"></canvas>
</div>

<style>
  .ano-wrap { position: relative; display: block; }
  .ano-bed {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    pointer-events: none; display: block;
    z-index: 10;
  }
</style>

<script>
(function () {
  'use strict';

  /* ── Shared concurrency limiter ───────────────────────────────────────── */
  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let nActive   = 0;
  const MAX_ACT = 2;
  const MAX_BUBS = 60;

  /* ── Dye colour palette ───────────────────────────────────────────────── */
  const DYE: Record<string, string> = {
    accent:  '#c07030',
    blue:    '#1a58a8',
    red:     '#a01820',
    purple:  '#5a1a8a',
    gold:    '#c09028',
    black:   '#18181e',
  };

  /* ── Utilities ────────────────────────────────────────────────────────── */
  function mk(w: number, h: number): HTMLCanvasElement {
    const c = document.createElement('canvas'); c.width = w; c.height = h; return c;
  }
  function eio(t: number) { return t < 0.5 ? 2*t*t : -1 + (4 - 2*t)*t; }

  /* ── Pre-render brushed-aluminium surface ─────────────────────────────── */
  function renderAluminum(ctx: CanvasRenderingContext2D, W: number, H: number) {
    const bg = ctx.createLinearGradient(0, 0, 0, H);
    bg.addColorStop(0,   '#ccd2da');
    bg.addColorStop(0.4, '#b8bfc8');
    bg.addColorStop(0.7, '#c2c8d0');
    bg.addColorStop(1,   '#bac0c8');
    ctx.fillStyle = bg; ctx.fillRect(0, 0, W, H);

    for (let y = 0; y < H; y++) {
      const b = 0.88 + Math.sin(y * 3.7) * 0.035 + Math.sin(y * 11.3) * 0.015;
      ctx.strokeStyle = `rgba(${200*b|0},${208*b|0},${218*b|0},0.22)`;
      ctx.lineWidth   = 0.5;
      ctx.beginPath(); ctx.moveTo(0, y+0.3); ctx.lineTo(W, y+0.3); ctx.stroke();
    }

    const spec = ctx.createLinearGradient(0, 0, W*0.5, H*0.45);
    spec.addColorStop(0, 'rgba(255,255,255,0.34)');
    spec.addColorStop(1, 'rgba(255,255,255,0)');
    ctx.fillStyle = spec; ctx.fillRect(0, 0, W, H);
  }

  /* ── Pre-render anodised colour surface ───────────────────────────────── */
  function renderAnodized(ctx: CanvasRenderingContext2D, W: number, H: number, dyeColor: string) {
    ctx.fillStyle = dyeColor; ctx.fillRect(0, 0, W, H);

    for (let y = 0; y < H; y++) {
      const t = Math.max(0, 0.09 + Math.sin(y * 3.7) * 0.04 + Math.sin(y * 11.3) * 0.02);
      ctx.strokeStyle = `rgba(0,0,0,${t.toFixed(3)})`;
      ctx.lineWidth   = 0.5;
      ctx.beginPath(); ctx.moveTo(0, y+0.3); ctx.lineTo(W, y+0.3); ctx.stroke();
    }

    const sh = ctx.createLinearGradient(0, 0, W*0.55, H*0.4);
    sh.addColorStop(0, 'rgba(255,255,255,0.20)');
    sh.addColorStop(1, 'rgba(255,255,255,0)');
    ctx.fillStyle = sh; ctx.fillRect(0, 0, W, H);
  }

  /* ── Build glyph pixel mask from live DOM ─────────────────────────────── */
  function buildMask(wrap: HTMLElement, heading: HTMLElement, W: number, H: number) {
    const off = mk(W, H);
    const ctx = off.getContext('2d')!;
    const pr  = wrap.getBoundingClientRect();
    const range = document.createRange();
    ctx.fillStyle = '#fff';

    function walk(node: Node) {
      if (node.nodeType === Node.TEXT_NODE) {
        const txt = (node.textContent || '').trim();
        if (!txt) return;
        const el = (node.parentElement ?? heading) as HTMLElement;
        const cs = window.getComputedStyle(el);
        ctx.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
        ctx.textBaseline = 'alphabetic';
        const m = ctx.measureText(txt);
        range.selectNode(node);
        for (const r of Array.from(range.getClientRects())) {
          if (r.width < 2) continue;
          ctx.save();
          ctx.beginPath();
          ctx.rect(r.left - pr.left, r.top - pr.top, r.width + 1, r.height + 1);
          ctx.clip();
          ctx.fillText(txt, r.left - pr.left, r.top - pr.top + m.fontBoundingBoxAscent);
          ctx.restore();
        }
      } else { node.childNodes.forEach(walk); }
    }
    walk(heading);
    return ctx.getImageData(0, 0, W, H).data;
  }

  /* ── Bubble helpers ───────────────────────────────────────────────────── */
  type Bub = { x: number; y: number; r: number; vx: number; vy: number; life: number; maxLife: number };

  function drawBubbles(ctx: CanvasRenderingContext2D, bubbles: Bub[]) {
    for (const b of bubbles) {
      const t = b.life / b.maxLife;
      const alpha = (t < 0.15 ? t/0.15 : t > 0.78 ? (1-t)/0.22 : 1) * 0.5;
      ctx.save();
      ctx.globalAlpha = alpha;
      ctx.strokeStyle = 'rgba(218,228,242,0.92)';
      ctx.lineWidth   = 0.5;
      ctx.beginPath(); ctx.arc(b.x, b.y, b.r, 0, Math.PI*2); ctx.stroke();
      ctx.fillStyle = 'rgba(245,250,255,0.38)';
      ctx.beginPath(); ctx.arc(b.x - b.r*0.3, b.y - b.r*0.32, b.r*0.38, 0, Math.PI*2); ctx.fill();
      ctx.restore();
    }
  }

  /* ── Main per-element setup ───────────────────────────────────────────── */
  function setup(wrap: HTMLElement) {
    if (nActive >= MAX_ACT) { setTimeout(() => setup(wrap), 300); return; }
    nActive++;

    const bedEl   = wrap.querySelector<HTMLCanvasElement>('.ano-bed');
    if (!bedEl) { nActive--; return; }
    const heading = wrap.querySelector<HTMLElement>('h1,h2,h3,h4,h5,h6,[data-ano]');
    if (!heading) { nActive--; return; }

    const DUR      = parseFloat(wrap.dataset.anoDuration || '2.8') * 1000;
    const DELAY    = parseFloat(wrap.dataset.anoDelay    || '0.25') * 1000;
    const CLR      = wrap.dataset.anoColor || 'accent';
    const dyeColor = DYE[CLR] ?? DYE.accent;

    const rect = wrap.getBoundingClientRect();
    const W = Math.floor(rect.width);
    const H = Math.floor(rect.height);
    if (W < 40 || H < 8) { nActive--; return; }

    const DPR = Math.min(window.devicePixelRatio || 1, 2);
    const PW  = Math.round(W * DPR);
    const PH  = Math.round(H * DPR);

    bedEl.width  = PW; bedEl.height = PH;
    bedEl.style.width = W+'px'; bedEl.style.height = H+'px';
    const bCtx = bedEl.getContext('2d')!; bCtx.scale(DPR, DPR);

    // Static off-screen surfaces (DPR-scaled)
    const alOff  = mk(PW, PH);
    { const c = alOff.getContext('2d')!;  c.scale(DPR, DPR); renderAluminum(c, W, H); }
    const dyeOff = mk(PW, PH);
    { const c = dyeOff.getContext('2d')!; c.scale(DPR, DPR); renderAnodized(c, W, H, dyeColor); }

    // Scratch canvas
    const t1Off  = mk(PW, PH);
    const t1Ctx  = t1Off.getContext('2d')!; t1Ctx.scale(DPR, DPR);

    document.fonts.ready.then(() => {
      const mpx = buildMask(wrap, heading, W, H);

      // Letter-mask canvas
      const accOff = mk(W, H);
      {
        const c = accOff.getContext('2d')!;
        const id = c.createImageData(W, H);
        for (let i = 0; i < mpx.length; i++) id.data[i] = mpx[i];
        c.putImageData(id, 0, 0);
      }

      // Phase schedule: bare → electrolysis → immersion dye → finish
      const phases = [
        { name: 'bare',   t0: 0.00, t1: 0.10 },
        { name: 'bubble', t0: 0.10, t1: 0.42 },
        { name: 'dye',    t0: 0.42, t1: 0.78 },
        { name: 'finish', t0: 0.78, t1: 1.00 },
      ];

      // Animation state
      const bubbles: Bub[] = [];
      let phaseIdx   = 0;
      let dyeP       = 0;   // 0→1 controls dye opacity (uniform deepening)
      let oxideT     = 0;   // 0→1 oxide layer growth during electrolysis
      let finF       = 0;   // 0→1 controls iridescence
      let lastTs: number | null = null;
      let startTs    = 0;

      /* ── Helper: draw aluminium letters ──────────────────────────── */
      function drawAluminum() {
        t1Ctx.clearRect(0, 0, W, H);
        t1Ctx.drawImage(alOff, 0, 0, W, H);
        t1Ctx.globalCompositeOperation = 'destination-in';
        t1Ctx.drawImage(accOff, 0, 0, W, H);
        t1Ctx.globalCompositeOperation = 'source-over';
        bCtx.drawImage(t1Off, 0, 0, W, H);
      }

      /* ── Per-frame composite ─────────────────────────────────────── */
      function composite(dp: number, ff: number) {
        bCtx.clearRect(0, 0, W, H);

        // Layer 1: brushed-aluminium letters
        drawAluminum();

        // Oxide matte veil — grows during electrolysis, surface loses specular as Al₂O₃ forms
        if (oxideT > 0) {
          bCtx.globalCompositeOperation = 'source-atop';
          bCtx.fillStyle = `rgba(195,208,220,${(oxideT * 0.16).toFixed(3)})`;
          bCtx.fillRect(0, 0, W, H);
          bCtx.globalCompositeOperation = 'source-over';
        }

        // Layer 2: immersion dye — uniform simultaneous deepening, no wavefront
        if (dp > 0) {
          t1Ctx.clearRect(0, 0, W, H);
          t1Ctx.drawImage(dyeOff, 0, 0, W, H);
          t1Ctx.globalCompositeOperation = 'destination-in';
          t1Ctx.drawImage(accOff, 0, 0, W, H);
          t1Ctx.globalCompositeOperation = 'source-over';

          bCtx.globalAlpha = dp * 0.92;
          bCtx.drawImage(t1Off, 0, 0, W, H);
          bCtx.globalAlpha = 1;
        }

        // Layer 3: satin iridescence — subtle metallic sheen over sealed oxide
        if (ff > 0) {
          bCtx.globalCompositeOperation = 'source-atop';
          const ird = bCtx.createLinearGradient(W*0.08, 0, W*0.92, H);
          ird.addColorStop(0.00, `rgba(140, 80,255,${(0.28*ff).toFixed(3)})`);
          ird.addColorStop(0.22, `rgba( 50,140,255,${(0.24*ff).toFixed(3)})`);
          ird.addColorStop(0.44, `rgba( 30,220,180,${(0.20*ff).toFixed(3)})`);
          ird.addColorStop(0.60, 'rgba(40,200, 60,0)');
          ird.addColorStop(0.78, `rgba(220,200, 30,${(0.20*ff).toFixed(3)})`);
          ird.addColorStop(1.00, `rgba(220, 80, 30,${(0.16*ff).toFixed(3)})`);
          bCtx.fillStyle = ird;
          bCtx.fillRect(0, 0, W, H);
          bCtx.globalCompositeOperation = 'source-over';
        }
      }

      /* ── Spawn bath bubbles — rise through entire canvas, not letter-confined ── */
      function spawnBubbles(rate: number, dt: number) {
        const n = Math.round(rate * dt * 60 * (0.5 + Math.random()*0.5));
        for (let i = 0; i < n && bubbles.length < MAX_BUBS; i++) {
          bubbles.push({
            x: Math.random() * W,
            y: H * (0.55 + Math.random() * 0.45),
            r: 0.5 + Math.random() * 1.2,
            vx: (Math.random() - 0.5) * 3,
            vy: -(22 + Math.random() * 42),
            life: 0,
            maxLife: 0.50 + Math.random() * 0.55,
          });
        }
      }

      /* ── Finalise: fade out canvas, reveal heading ───────────────── */
      function finalise() {
        bedEl.style.transition = 'opacity 0.28s ease';
        bedEl.style.opacity = '0';
        heading.style.visibility = 'visible';
        setTimeout(() => { bedEl.style.display = 'none'; nActive--; }, 320);
      }

      function showDone() {
        bedEl.style.display = 'none';
        heading.style.visibility = 'visible';
        nActive--;
      }

      if (REDUCED) { showDone(); return; }

      // Hide heading; show bare aluminium immediately to avoid blank flash
      heading.style.visibility = 'hidden';
      bCtx.clearRect(0, 0, W, H);
      drawAluminum();

      /* ── Animation loop ──────────────────────────────────────────── */
      function frame(ts: number) {
        if (!lastTs) lastTs = ts;
        const dt  = Math.min((ts - lastTs) / 1000, 0.05);
        lastTs    = ts;
        const pct = Math.min((ts - startTs) / DUR, 1.0);

        // Advance phase
        while (phaseIdx < phases.length-1 && pct >= phases[phaseIdx].t1) phaseIdx++;
        const ph = phases[phaseIdx];
        const pt = ph.t1 > ph.t0 ? Math.min(1, (pct - ph.t0) / (ph.t1 - ph.t0)) : 1;

        // Update bubbles — rise freely through bath, not clipped to letter shapes
        for (let i = bubbles.length-1; i >= 0; i--) {
          const b = bubbles[i];
          b.x   += b.vx * dt;
          b.y   += b.vy * dt;
          b.life += dt;
          if (b.life >= b.maxLife || b.y < -4) bubbles.splice(i, 1);
        }

        // Phase actions
        if (ph.name === 'bubble') {
          oxideT = eio(pt);
          spawnBubbles(eio(pt) * 0.55, dt);
        } else if (ph.name === 'dye') {
          oxideT = 1;
          dyeP = eio(pt);
        } else if (ph.name === 'finish') {
          oxideT = 1;
          dyeP = 1;
          finF = pt;
        }

        composite(dyeP, finF);
        if (bubbles.length > 0) drawBubbles(bCtx, bubbles);

        if (pct >= 1) { finalise(); return; }
        requestAnimationFrame(frame);
      }

      setTimeout(() => {
        startTs = performance.now();
        requestAnimationFrame(frame);
      }, DELAY);
    });
  }

  /* ── IntersectionObserver / page init ────────────────────────────────── */
  function init() {
    document.querySelectorAll<HTMLElement>('.ano-wrap').forEach(wrap => {
      if (REDUCED) {
        const h = wrap.querySelector<HTMLElement>('h1,h2,h3,h4,h5,h6');
        if (h) h.style.visibility = 'visible';
        return;
      }
      const trig = wrap.dataset.anoTrigger || 'scroll';
      if (trig === 'scroll' && 'IntersectionObserver' in window) {
        const obs = new IntersectionObserver(entries => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              obs.unobserve(e.target as HTMLElement);
              setup(e.target as HTMLElement);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -20px 0px' });
        obs.observe(wrap);
      } else {
        setup(wrap);
      }
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
