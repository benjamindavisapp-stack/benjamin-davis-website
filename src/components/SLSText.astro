---
// SLSText.astro — Selective Laser Sintering (SLS) text reveal.
// Wraps any heading; on scroll-into-view it simulates the text being
// sintered from PA12 nylon powder, then blows away the loose powder
// to expose the letters. Real heading stays in DOM; canvas is aria-hidden.
//
//   <SLSText id="about-hero" duration={3} layers={2}>
//     <h1 class="hero-heading">Your heading</h1>
//   </SLSText>
interface Props {
  duration?: number;           // total seconds (default 3)
  layers?:   number;           // sinter layers 1–3 (default 2)
  delay?:    number;           // start delay in seconds (default 0.25)
  trigger?:  'scroll' | 'load';
  id?:       string;           // stable session-storage key (auto-gen if omitted)
  class?:    string;
}
const {
  duration = 3,
  layers   = 2,
  delay    = 0.25,
  trigger  = 'scroll',
  id,
  class: cls,
} = Astro.props;
const slsId = id ?? ('sls-' + Math.random().toString(36).slice(2, 8));
---

<div
  class:list={['sls-wrap', cls]}
  data-sls-duration={String(duration)}
  data-sls-layers={String(layers)}
  data-sls-delay={String(delay)}
  data-sls-trigger={trigger}
  data-sls-id={slsId}
>
  <slot />
  <canvas class="sls-bed" aria-hidden="true"></canvas>
  <canvas class="sls-fx"  aria-hidden="true"></canvas>
</div>

<style>
  .sls-wrap {
    position: relative;
    display: block;
  }
  .sls-bed,
  .sls-fx {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    display: block;
  }
  .sls-bed { z-index: 10; }
  .sls-fx  { z-index: 11; }
</style>

<script>
(function () {
  'use strict';

  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let   nActive = 0;
  const MAX_ACT = 2;

  /* ── helpers ──────────────────────────────────────────────────────────────── */
  function mk(w: number, h: number): HTMLCanvasElement {
    const c = document.createElement('canvas');
    c.width = w; c.height = h; return c;
  }
  // ease-in-out quadratic
  function eio(t: number) { return t < 0.5 ? 2*t*t : -1 + (4 - 2*t)*t; }

  /* ── PA12 nylon powder bed ────────────────────────────────────────────────── */
  function renderPowder(ctx: CanvasRenderingContext2D, W: number, H: number) {
    ctx.fillStyle = '#dad6cc';
    ctx.fillRect(0, 0, W, H);
    const n = Math.min(W * H * 0.10, 7000);
    for (let i = 0; i < n; i++) {
      const x = Math.random() * W, y = Math.random() * H;
      ctx.globalAlpha = Math.random() * 0.20 + 0.04;
      ctx.fillStyle   = Math.random() > 0.5 ? '#f0ece4' : '#b2aea6';
      ctx.beginPath(); ctx.arc(x, y, Math.random() * 0.7 + 0.2, 0, Math.PI * 2); ctx.fill();
    }
    ctx.globalAlpha = 1;
  }

  /* ── Sintered PA12 surface ────────────────────────────────────────────────── */
  function renderSintered(ctx: CanvasRenderingContext2D, W: number, H: number, angle: number) {
    ctx.fillStyle = '#c4beb4';
    ctx.fillRect(0, 0, W, H);
    const n = Math.min(W * H * 0.06, 4000);
    for (let i = 0; i < n; i++) {
      const x = Math.random() * W, y = Math.random() * H;
      ctx.globalAlpha = Math.random() * 0.13 + 0.03;
      ctx.fillStyle   = Math.random() > 0.55 ? '#dcd8d0' : '#888480';
      ctx.beginPath(); ctx.arc(x, y, Math.random() * 1.0 + 0.3, 0, Math.PI * 2); ctx.fill();
    }
    ctx.globalAlpha = 1;
    // Laser scan-line signature
    const cos = Math.cos(angle), sin = Math.sin(angle);
    const diag = Math.hypot(W, H);
    ctx.strokeStyle = 'rgba(80,76,70,0.16)'; ctx.lineWidth = 0.55;
    for (let d = -diag; d < diag; d += 2.8) {
      const ox = W/2 - sin*d, oy = H/2 + cos*d;
      ctx.beginPath();
      ctx.moveTo(ox - cos*diag, oy - sin*diag);
      ctx.lineTo(ox + cos*diag, oy + sin*diag);
      ctx.stroke();
    }
  }

  /* ── Letter pixel mask via Range API ─────────────────────────────────────── */
  function buildMask(wrap: HTMLElement, heading: HTMLElement, W: number, H: number) {
    const off = mk(W, H);
    const ctx = off.getContext('2d')!;
    const pr  = wrap.getBoundingClientRect();
    const range = document.createRange();
    ctx.fillStyle = '#fff';

    function walk(node: Node) {
      if (node.nodeType === Node.TEXT_NODE) {
        const txt = (node.textContent || '').trim();
        if (!txt) return;
        const el = (node.parentElement ?? heading) as HTMLElement;
        const cs = window.getComputedStyle(el);
        ctx.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
        ctx.textBaseline = 'alphabetic';
        const m = ctx.measureText(txt);
        range.selectNode(node);
        for (const r of Array.from(range.getClientRects())) {
          if (r.width < 2) continue;
          ctx.save();
          ctx.beginPath();
          ctx.rect(r.left - pr.left, r.top - pr.top, r.width + 1, r.height + 1);
          ctx.clip();
          ctx.fillText(txt, r.left - pr.left, r.top - pr.top + m.fontBoundingBoxAscent);
          ctx.restore();
        }
      } else {
        node.childNodes.forEach(walk);
      }
    }
    walk(heading);
    return ctx.getImageData(0, 0, W, H).data;
  }

  /* ── inLetter pixel test ──────────────────────────────────────────────────── */
  function inLtr(mpx: Uint8ClampedArray, W: number, H: number, x: number, y: number) {
    const xi = Math.max(0, Math.min(W-1, Math.round(x)));
    const yi = Math.max(0, Math.min(H-1, Math.round(y)));
    return mpx[(yi*W + xi)*4] > 60;
  }

  /* ── Simplified contour: bottom-edge L→R, top-edge R→L ───────────────────── */
  function extractContour(mpx: Uint8ClampedArray, W: number, H: number) {
    type P = { x: number; y: number; gap?: true };
    const bot: P[] = [], top: P[] = [];
    for (let x = 0; x < W; x++) {
      let yt = -1, yb = -1;
      for (let y = 0; y < H; y++) {
        if (mpx[(y*W + x)*4] > 60) { if (yt < 0) yt = y; yb = y; }
      }
      if (yt >= 0) { bot.push({ x, y: yb + 1.5 }); top.push({ x, y: yt - 1.5 }); }
    }
    const path: P[] = [];
    for (let i = 0; i < bot.length; i++) {
      if (i > 0 && bot[i].x - bot[i-1].x > 6) path.push({ ...bot[i], gap: true });
      else path.push(bot[i]);
    }
    for (let i = top.length-1; i >= 0; i--) {
      if (i < top.length-1 && top[i+1].x - top[i].x > 6) path.push({ ...top[i], gap: true });
      else path.push(top[i]);
    }
    return path;
  }

  /* ── Angled hatch segments clipped to letter mask ────────────────────────── */
  function genHatch(mpx: Uint8ClampedArray, W: number, H: number, angle: number, spacing: number) {
    const segs: [number,number,number,number][] = [];
    const cos = Math.cos(angle), sin = Math.sin(angle);
    const diag = Math.hypot(W, H);
    for (let d = -diag; d < diag; d += spacing) {
      const ox = W/2 - sin*d, oy = H/2 + cos*d;
      let inSeg = false, sx = 0, sy = 0;
      for (let t = -diag; t <= diag; t += 2) {
        const px = ox + cos*t, py = oy + sin*t;
        if (px < -2 || px > W+2 || py < -2 || py > H+2) {
          if (inSeg) { segs.push([sx, sy, px, py]); inSeg = false; }
          continue;
        }
        const ins = inLtr(mpx, W, H, px, py);
        if (ins && !inSeg)  { sx = px; sy = py; inSeg = true; }
        else if (!ins && inSeg) { segs.push([sx, sy, px, py]); inSeg = false; }
      }
      if (inSeg) segs.push([sx, sy, ox + cos*diag, oy + sin*diag]);
    }
    return segs;
  }

  /* ── Laser interaction zone ────────────────────────────────────────────────
     PA12 sinters at ~180°C — far below incandescent glow (~500°C). The CO2
     laser is invisible (10.6µm IR). What's visible: a faint surface shimmer
     from thermal disturbance, plus a pinpoint white-hot melt core.         */
  function drawLaser(ctx: CanvasRenderingContext2D, x: number, y: number, hot: number) {
    const R = 4 + hot * 1.5;
    const g = ctx.createRadialGradient(x, y, 0, x, y, R * 3);
    g.addColorStop(0,    `rgba(240,235,218,${(0.52 * hot).toFixed(2)})`);
    g.addColorStop(0.35, `rgba(215,208,188,${(0.20 * hot).toFixed(2)})`);
    g.addColorStop(1,    'rgba(185,178,162,0)');
    ctx.fillStyle = g;
    ctx.beginPath(); ctx.arc(x, y, R * 3, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = `rgba(255,255,255,${(0.88 * hot).toFixed(2)})`;
    ctx.beginPath(); ctx.arc(x, y, 0.9, 0, Math.PI * 2); ctx.fill();
  }

  /* ── Recoater bar ─────────────────────────────────────────────────────────── */
  function drawRecoater(ctx: CanvasRenderingContext2D, W: number, H: number, t: number) {
    const x = eio(t) * (W + 30) - 15;
    // Opaque blade body with hard leading edge
    const g = ctx.createLinearGradient(x-3, 0, x+9, 0);
    g.addColorStop(0,    'rgba(140,137,132,0)');
    g.addColorStop(0.12, 'rgba(162,158,153,0.95)');
    g.addColorStop(0.55, 'rgba(185,181,175,0.98)');
    g.addColorStop(1,    'rgba(155,152,147,0)');
    ctx.fillStyle = g; ctx.fillRect(x-3, 0, 12, H);
    // Shadow at leading edge — physical mass
    ctx.strokeStyle = 'rgba(88,86,82,0.50)'; ctx.lineWidth = 0.8;
    ctx.beginPath(); ctx.moveTo(x+1, 0); ctx.lineTo(x+1, H); ctx.stroke();
    // Powder disturbed ahead of blade (being pushed)
    ctx.fillStyle = '#e2dfd6';
    for (let i = 0; i < 30; i++) {
      const px = x + 4 + Math.random() * 20;
      const py = Math.random() * H;
      ctx.globalAlpha = 0.12 + Math.random() * 0.22;
      ctx.beginPath(); ctx.arc(px, py, Math.random()*1.8+0.25, 0, Math.PI*2); ctx.fill();
    }
    // Settling powder left behind (fresh layer, slightly smoother)
    for (let i = 0; i < 14; i++) {
      const px = x - 5 - Math.random() * 14;
      const py = Math.random() * H;
      ctx.globalAlpha = 0.07 + Math.random() * 0.09;
      ctx.beginPath(); ctx.arc(px, py, Math.random()*1.1+0.2, 0, Math.PI*2); ctx.fill();
    }
    ctx.globalAlpha = 1;
  }

  /* ── Main setup ───────────────────────────────────────────────────────────── */
  function setup(wrap: HTMLElement) {
    if (nActive >= MAX_ACT) { setTimeout(() => setup(wrap), 300); return; }
    nActive++;

    const bedEl = wrap.querySelector<HTMLCanvasElement>('.sls-bed');
    const fxEl  = wrap.querySelector<HTMLCanvasElement>('.sls-fx');
    if (!bedEl || !fxEl) { nActive--; return; }

    const heading = wrap.querySelector<HTMLElement>('h1,h2,h3,h4,h5,h6,[data-sls]');
    if (!heading) { nActive--; return; }

    const DUR   = parseFloat(wrap.dataset.slsDuration || '3') * 1000;
    const NLYR  = Math.max(1, Math.min(3, parseInt(wrap.dataset.slsLayers || '2')));
    const DELAY = parseFloat(wrap.dataset.slsDelay || '0.25') * 1000;
    const HSTEP = 2.8; // hatch line spacing (px)

    const rect = wrap.getBoundingClientRect();
    const W = Math.floor(rect.width);
    const H = Math.floor(rect.height);
    if (W < 40 || H < 8) { nActive--; return; }

    const DPR = Math.min(window.devicePixelRatio || 1, 2);
    const PW  = Math.round(W * DPR);
    const PH  = Math.round(H * DPR);

    [bedEl, fxEl].forEach(c => {
      c.width = PW; c.height = PH;
      c.style.width = W + 'px'; c.style.height = H + 'px';
    });
    const bCtx = bedEl.getContext('2d')!;
    const fCtx = fxEl.getContext('2d')!;
    bCtx.scale(DPR, DPR); fCtx.scale(DPR, DPR);

    // Hatch angles: EOS standard 67° per-layer rotation (0°, 67°, 134°)
    const ANGLES = [0, Math.PI * 67/180, Math.PI * 134/180];

    // Pre-render powder bed
    const powderOff = mk(PW, PH);
    { const c = powderOff.getContext('2d')!; c.scale(DPR, DPR); renderPowder(c, W, H); }

    // Pre-render sintered surfaces (one per layer with rotated hatch angle)
    const sintOff: HTMLCanvasElement[] = Array.from({ length: NLYR }, (_, i) => {
      const s = mk(PW, PH); const c = s.getContext('2d')!; c.scale(DPR, DPR);
      renderSintered(c, W, H, ANGLES[i % ANGLES.length]); return s;
    });

    // Accumulation canvas: grows as laser passes
    const accOff = mk(PW, PH);
    const acCtx  = accOff.getContext('2d')!; acCtx.scale(DPR, DPR);

    // Scratch canvas for destination-in compositing
    const tmpOff = mk(PW, PH);
    const tmCtx  = tmpOff.getContext('2d')!; tmCtx.scale(DPR, DPR);

    // Residual thermal glow — stamped on sinter, decays each frame (~400ms half-life)
    const glowOff = mk(PW, PH);
    const glCtx   = glowOff.getContext('2d')!; glCtx.scale(DPR, DPR);

    // Fume wisp particles (nitrogen-flow direction: rightward + upward)
    const fumePs: { x: number; y: number; vx: number; vy: number; a: number }[] = [];

    document.fonts.ready.then(() => {
      // Letter mask
      const mpx = buildMask(wrap, heading, W, H);

      // Generate sinter paths
      const cPath  = extractContour(mpx, W, H);
      const hPaths = Array.from({ length: NLYR }, (_, i) =>
        genHatch(mpx, W, H, ANGLES[i % ANGLES.length], HSTEP));
      const hLens  = hPaths.map(segs =>
        segs.reduce((a, [x1,y1,x2,y2]) => a + Math.hypot(x2-x1, y2-y1), 0));

      // Phase schedule (fractions of total duration)
      interface Ph { name: string; t0: number; t1: number; layer: number }
      const phases: Ph[] = [];
      let ti = 0;
      phases.push({ name:'powder',  t0:ti, t1:(ti += 0.08), layer:0 });
      const perLyr = (1.0 - 0.08 - (NLYR - 1) * 0.04) / NLYR;
      for (let i = 0; i < NLYR; i++) {
        if (i > 0) phases.push({ name:'recoat',  t0:ti, t1:(ti += 0.04), layer:i });
        phases.push({ name:'contour', t0:ti, t1:(ti += perLyr * 0.28), layer:i });
        phases.push({ name:'hatch',   t0:ti, t1:(ti += perLyr * 0.72), layer:i });
      }

      // Per-animation state
      let phaseIdx     = 0;
      let cIdx         = 0;       // contour index, reset each contour phase
      const hIdx       = Array(NLYR).fill(0);
      const hT         = Array(NLYR).fill(0);
      let   laserX     = -20, laserY = H * 0.5, laserHot = 0;
      let lastTs: number | null = null;
      let lastPhName   = '';
      let startTs      = 0;

      /* bed canvas composite — powder bed with sintered texture where laser has passed */
      function composite(layer: number) {
        // Decay residual glow each frame (τ ≈ 200ms at 60fps)
        glCtx.globalCompositeOperation = 'destination-out';
        glCtx.globalAlpha = 0.08;
        glCtx.fillRect(0, 0, W, H);
        glCtx.globalAlpha = 1;
        glCtx.globalCompositeOperation = 'source-over';

        bCtx.clearRect(0, 0, W, H);
        const slyr = Math.max(0, Math.min(NLYR - 1, layer));
        bCtx.drawImage(powderOff, 0, 0, W, H);
        tmCtx.clearRect(0, 0, W, H);
        tmCtx.drawImage(sintOff[slyr], 0, 0, W, H);
        tmCtx.globalCompositeOperation = 'destination-in';
        tmCtx.drawImage(accOff, 0, 0, W, H);
        tmCtx.globalCompositeOperation = 'source-over';
        bCtx.globalAlpha = 0.88;
        bCtx.drawImage(tmpOff, 0, 0, W, H);
        // Residual thermal glow overlaid on sintered surface
        bCtx.drawImage(glowOff, 0, 0, W, H);
        bCtx.globalAlpha = 1;
      }

      function sinterAt(x: number, y: number) {
        // Soft-edged accumulation mask — shadowBlur gives thermal-halo boundary
        acCtx.shadowBlur = 3; acCtx.shadowColor = '#fff';
        acCtx.fillStyle = '#fff';
        acCtx.beginPath(); acCtx.arc(x, y, 3.5, 0, Math.PI * 2); acCtx.fill();
        acCtx.shadowBlur = 0;
      }

      // Stamp residual glow ONCE PER FRAME at current laser position
      function stampGlow(x: number, y: number, hot: number) {
        const gr = glCtx.createRadialGradient(x, y, 0, x, y, 5);
        gr.addColorStop(0,   `rgba(255,215,140,${(0.55 * hot).toFixed(2)})`);
        gr.addColorStop(0.5, `rgba(255,155,45,${(0.22 * hot).toFixed(2)})`);
        gr.addColorStop(1,   'rgba(255,90,0,0)');
        glCtx.fillStyle = gr;
        glCtx.beginPath(); glCtx.arc(x, y, 5, 0, Math.PI*2); glCtx.fill();
      }

      function finalise() {
        fxEl.style.display = 'none';
        bedEl.style.transition = 'opacity 0.28s ease';
        bedEl.style.opacity = '0';
        heading.style.visibility = 'visible';
        setTimeout(() => { bedEl.style.display = 'none'; nActive--; }, 320);
      }

      function showDone() {
        bedEl.style.display = 'none'; fxEl.style.display = 'none';
        heading.style.visibility = 'visible'; nActive--;
      }

      if (REDUCED) { showDone(); return; }

      heading.style.visibility = 'hidden';
      composite(0); // show powder bed right away — no canvas-appears flash

      function frame(ts: number) {
        if (!lastTs) lastTs = ts;
        const dt  = Math.min((ts - lastTs) / 1000, 0.05);
        lastTs = ts;
        const pct = Math.min((ts - startTs) / DUR, 1.0);

        while (phaseIdx < phases.length - 1 && pct >= phases[phaseIdx].t1) phaseIdx++;
        const ph = phases[phaseIdx];
        const pt = ph.t1 > ph.t0 ? Math.min(1, (pct - ph.t0) / (ph.t1 - ph.t0)) : 1;

        // Reset contour state on each new contour phase entry
        if (ph.name === 'contour' && lastPhName !== 'contour') {
          cIdx = 0;
          // Recoater deposited fresh powder — sintered layer is now buried
          if (lastPhName === 'recoat') {
            acCtx.clearRect(0, 0, W, H);
            glCtx.clearRect(0, 0, W, H);
          }
        }
        lastPhName = ph.name;

        fCtx.clearRect(0, 0, W, H);

        /* ── POWDER SETTLE ──────────────────────────────────────────────── */
        if (ph.name === 'powder') {
          composite(0);
          if (pt > 0.5) {
            const li = eio((pt - 0.5) * 2);
            laserX = -20 + li * (W * 0.12 + 20);
            laserY = H * 0.5; laserHot = 0.25;
            drawLaser(fCtx, laserX, laserY, laserHot * (pt - 0.5) * 2);
          }
        }

        /* ── RECOATER ───────────────────────────────────────────────────── */
        else if (ph.name === 'recoat') {
          composite(ph.layer);
          drawRecoater(fCtx, W, H, pt);
        }

        /* ── CONTOUR PASS ───────────────────────────────────────────────── */
        else if (ph.name === 'contour') {
          if (cPath.length) {
            const speed = cPath.length / ((ph.t1 - ph.t0) * DUR / 1000);
            let rem = speed * dt;
            while (rem > 0 && cIdx < cPath.length) {
              const p = cPath[cIdx++];
              if (!p.gap) { sinterAt(p.x, p.y); laserX = p.x; laserY = p.y; laserHot = 1; }
              else        { laserX = p.x; laserY = p.y; laserHot = 0.3; }
              rem--;
            }
          }
          stampGlow(laserX, laserY, laserHot);
          composite(ph.layer);
          drawLaser(fCtx, laserX, laserY, laserHot);
          if (laserHot > 0.5 && Math.random() < 0.55) {
            fumePs.push({ x: laserX + (Math.random()-0.5)*3, y: laserY - 1,
              vx: 0.30 + (Math.random()-0.5)*0.20, vy: -(0.55 + Math.random()*0.40),
              a: 0.22 + Math.random()*0.12 });
          }
        }

        /* ── HATCH FILL ─────────────────────────────────────────────────── */
        else if (ph.name === 'hatch') {
          const L = ph.layer;
          const segs = hPaths[L]; const total = hLens[L];
          if (total > 0) {
            const speed = total / ((ph.t1 - ph.t0) * DUR / 1000);
            let rem = speed * dt;
            while (rem > 0 && hIdx[L] < segs.length) {
              const [x1,y1,x2,y2] = segs[hIdx[L]];
              const dx = x2-x1, dy = y2-y1;
              const len = Math.hypot(dx, dy);
              if (len < 0.1) { hIdx[L]++; continue; }
              const toEnd = (1 - hT[L]) * len;
              if (rem >= toEnd) {
                rem -= toEnd; hT[L] = 0; hIdx[L]++;
                sinterAt(x2, y2); laserX = x2; laserY = y2; laserHot = 1;
              } else {
                hT[L] += rem / len;
                const nx = x1 + dx*hT[L], ny = y1 + dy*hT[L];
                sinterAt(nx, ny); laserX = nx; laserY = ny; laserHot = 1;
                rem = 0;
              }
            }
          }
          stampGlow(laserX, laserY, laserHot);
          composite(ph.layer);
          drawLaser(fCtx, laserX, laserY, laserHot);
          if (laserHot > 0.8 && Math.random() < 0.35) {
            fumePs.push({ x: laserX + (Math.random()-0.5)*2, y: laserY - 1,
              vx: 0.28 + (Math.random()-0.5)*0.15, vy: -(0.50 + Math.random()*0.30),
              a: 0.18 + Math.random()*0.10 });
          }
          if (ph.layer === NLYR - 1 && pt >= 1) { finalise(); return; }
        }

        // Update and draw fume wisps (upward + rightward drift, nitrogen cross-flow)
        for (let i = fumePs.length - 1; i >= 0; i--) {
          const fp = fumePs[i];
          fp.x += fp.vx; fp.y += fp.vy; fp.a *= 0.93;
          if (fp.a < 0.012) { fumePs.splice(i, 1); continue; }
          fCtx.globalAlpha = fp.a;
          fCtx.fillStyle = 'rgba(212,208,200,1)';
          fCtx.beginPath(); fCtx.arc(fp.x, fp.y, 0.9 + fp.a * 0.7, 0, Math.PI*2); fCtx.fill();
        }
        fCtx.globalAlpha = 1;

        requestAnimationFrame(frame);
      }

      setTimeout(() => { startTs = performance.now(); requestAnimationFrame(frame); }, DELAY);
    });
  }

  /* ── Observer / init ──────────────────────────────────────────────────────── */
  function init() {
    document.querySelectorAll<HTMLElement>('.sls-wrap').forEach(wrap => {
      if (REDUCED) return;
      const trig = wrap.dataset.slsTrigger || 'scroll';
      if (trig === 'scroll' && 'IntersectionObserver' in window) {
        const obs = new IntersectionObserver(entries => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              obs.unobserve(e.target as HTMLElement);
              setup(e.target as HTMLElement);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -20px 0px' });
        obs.observe(wrap);
      } else {
        setup(wrap);
      }
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
