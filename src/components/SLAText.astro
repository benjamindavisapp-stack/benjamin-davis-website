---
// SLAText.astro — Stereolithography (SLA) UV-resin text reveal.
// Wraps any heading; on scroll-into-view it simulates the text being
// UV-cured in a liquid photopolymer vat, then drains/drips to expose
// the glossy amber letters. Supports visible during build; dissolve on drain.
// Real heading stays in DOM (aria-hidden canvas).
//
//   <SLAText id="research-hero" duration={3} layers={2} delay={0.4}>
//     <h1 class="hero-heading">Your heading</h1>
//   </SLAText>
interface Props {
  duration?: number;          // total seconds (default 3)
  layers?:   number;          // cure layers 1–3 (default 2)
  delay?:    number;          // start delay in seconds (default 0.25)
  trigger?:  'scroll' | 'load';
  id?:       string;
  class?:    string;
}
const {
  duration = 3,
  layers   = 2,
  delay    = 0.25,
  trigger  = 'scroll',
  id,
  class: cls,
} = Astro.props;
const slaId = id ?? ('sla-' + Math.random().toString(36).slice(2, 8));
---

<div
  class:list={['sla-wrap', cls]}
  data-sla-duration={String(duration)}
  data-sla-layers={String(layers)}
  data-sla-delay={String(delay)}
  data-sla-trigger={trigger}
  data-sla-id={slaId}
>
  <slot />
  <canvas class="sla-bed" aria-hidden="true"></canvas>
  <canvas class="sla-fx"  aria-hidden="true"></canvas>
</div>

<style>
  .sla-wrap {
    position: relative;
    display: block;
  }
  .sla-bed,
  .sla-fx {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    display: block;
  }
  .sla-bed { z-index: 10; }
  .sla-fx  { z-index: 11; }
</style>

<script>
(function () {
  'use strict';

  const REDUCED    = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let   nActive    = 0;
  const MAX_ACT    = 2;
  const TRAIL_LIFE = 0.15;  // cure fluorescence fade (s) — photoinitiator emission, not phosphorescence
  const HSTEP      = 2.4;   // hatch spacing (px)

  function mk(w: number, h: number): HTMLCanvasElement {
    const c = document.createElement('canvas');
    c.width = w; c.height = h; return c;
  }
  function eio(t: number) { return t < 0.5 ? 2*t*t : -1 + (4 - 2*t)*t; }

  /* ── Liquid photopolymer resin vat ─────────────────────────────────────────── */
  function renderResinVat(ctx: CanvasRenderingContext2D, W: number, H: number) {
    const bg = ctx.createLinearGradient(0, 0, 0, H);
    bg.addColorStop(0,   'rgba(185,138,28,0.60)');
    bg.addColorStop(0.5, 'rgba(196,148,36,0.52)');
    bg.addColorStop(1,   'rgba(180,130,20,0.62)');
    ctx.fillStyle = bg; ctx.fillRect(0, 0, W, H);

    // Specular highlight
    const sp = ctx.createRadialGradient(W*0.43, H*0.38, 0, W*0.43, H*0.38, Math.min(W,H)*0.55);
    sp.addColorStop(0,   'rgba(255,228,138,0.28)');
    sp.addColorStop(0.5, 'rgba(255,210,96,0.09)');
    sp.addColorStop(1,   'rgba(255,188,58,0)');
    ctx.fillStyle = sp; ctx.fillRect(0, 0, W, H);

    // Top-edge meniscus
    const men = ctx.createLinearGradient(0, 0, 0, Math.min(H, 10));
    men.addColorStop(0, 'rgba(75,50,0,0.22)');
    men.addColorStop(1, 'rgba(75,50,0,0)');
    ctx.fillStyle = men; ctx.fillRect(0, 0, W, H);

    // Build platform — thin dark bar at top (part hangs from this in bottom-up SLA)
    ctx.fillStyle = 'rgba(38,30,16,0.80)';
    ctx.fillRect(0, 0, W, 3);
    ctx.strokeStyle = 'rgba(100,78,22,0.60)';
    ctx.lineWidth = 0.8;
    ctx.beginPath(); ctx.moveTo(0, 3); ctx.lineTo(W, 3); ctx.stroke();
  }

  /* ── Cured photopolymer — deep amber, translucent-glossy ───────────────────── */
  function renderCured(ctx: CanvasRenderingContext2D, W: number, H: number, angle: number) {
    ctx.fillStyle = 'rgba(162,104,10,0.93)';
    ctx.fillRect(0, 0, W, H);

    // Glossy surface sheen
    const shine = ctx.createLinearGradient(0, 0, W*0.32, H*0.32);
    shine.addColorStop(0, 'rgba(255,232,155,0.30)');
    shine.addColorStop(1, 'rgba(255,212,118,0)');
    ctx.fillStyle = shine; ctx.fillRect(0, 0, W, H);

    // Subtle horizontal layer banding — stratification from layer-by-layer build
    const bandH = 2.5;
    ctx.lineWidth = 0.6;
    for (let y = bandH; y < H; y += bandH) {
      ctx.strokeStyle = (Math.floor(y / bandH) % 2 === 0)
        ? 'rgba(125,78,5,0.09)' : 'rgba(185,128,18,0.07)';
      ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke();
    }

    // Faint UV scan-line texture
    const cos = Math.cos(angle), sin = Math.sin(angle);
    const diag = Math.hypot(W, H);
    ctx.strokeStyle = 'rgba(195,162,60,0.11)';
    ctx.lineWidth = 0.5;
    for (let d = -diag; d < diag; d += HSTEP) {
      const ox = W/2 - sin*d, oy = H/2 + cos*d;
      ctx.beginPath();
      ctx.moveTo(ox - cos*diag, oy - sin*diag);
      ctx.lineTo(ox + cos*diag, oy + sin*diag);
      ctx.stroke();
    }
  }

  /* ── Letter pixel mask via Range API ──────────────────────────────────────── */
  function buildMask(wrap: HTMLElement, heading: HTMLElement, W: number, H: number) {
    const off = mk(W, H);
    const ctx = off.getContext('2d')!;
    const pr  = wrap.getBoundingClientRect();
    const range = document.createRange();
    ctx.fillStyle = '#fff';

    function walk(node: Node) {
      if (node.nodeType === Node.TEXT_NODE) {
        const txt = (node.textContent || '').trim();
        if (!txt) return;
        const el = (node.parentElement ?? heading) as HTMLElement;
        const cs = window.getComputedStyle(el);
        ctx.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
        ctx.textBaseline = 'alphabetic';
        const m = ctx.measureText(txt);
        range.selectNode(node);
        for (const r of Array.from(range.getClientRects())) {
          if (r.width < 2) continue;
          ctx.save();
          ctx.beginPath();
          ctx.rect(r.left - pr.left, r.top - pr.top, r.width + 1, r.height + 1);
          ctx.clip();
          ctx.fillText(txt, r.left - pr.left, r.top - pr.top + m.fontBoundingBoxAscent);
          ctx.restore();
        }
      } else {
        node.childNodes.forEach(walk);
      }
    }
    walk(heading);
    return ctx.getImageData(0, 0, W, H).data;
  }

  function inLtr(mpx: Uint8ClampedArray, W: number, H: number, x: number, y: number) {
    const xi = Math.max(0, Math.min(W-1, Math.round(x)));
    const yi = Math.max(0, Math.min(H-1, Math.round(y)));
    return mpx[(yi*W + xi)*4] > 60;
  }

  /* ── Contour: bottom-edge L→R, top-edge R→L ──────────────────────────────── */
  function extractContour(mpx: Uint8ClampedArray, W: number, H: number) {
    type P = { x: number; y: number; gap?: true };
    const bot: P[] = [], top: P[] = [];
    for (let x = 0; x < W; x++) {
      let yt = -1, yb = -1;
      for (let y = 0; y < H; y++) {
        if (mpx[(y*W+x)*4] > 60) { if (yt < 0) yt = y; yb = y; }
      }
      if (yt >= 0) { bot.push({ x, y: yb+1.5 }); top.push({ x, y: yt-1.5 }); }
    }
    const path: P[] = [];
    for (let i = 0; i < bot.length; i++) {
      if (i > 0 && bot[i].x - bot[i-1].x > 6) path.push({ ...bot[i], gap: true });
      else path.push(bot[i]);
    }
    for (let i = top.length-1; i >= 0; i--) {
      if (i < top.length-1 && top[i+1].x - top[i].x > 6) path.push({ ...top[i], gap: true });
      else path.push(top[i]);
    }
    return path;
  }

  /* ── Angled hatch segments clipped to letter mask ─────────────────────────── */
  function genHatch(mpx: Uint8ClampedArray, W: number, H: number, angle: number, spacing: number) {
    const segs: [number,number,number,number][] = [];
    const cos = Math.cos(angle), sin = Math.sin(angle);
    const diag = Math.hypot(W, H);
    for (let d = -diag; d < diag; d += spacing) {
      const ox = W/2 - sin*d, oy = H/2 + cos*d;
      let inSeg = false, sx = 0, sy = 0;
      for (let t = -diag; t <= diag; t += 2) {
        const px = ox + cos*t, py = oy + sin*t;
        if (px < -2 || px > W+2 || py < -2 || py > H+2) {
          if (inSeg) { segs.push([sx, sy, px, py]); inSeg = false; }
          continue;
        }
        const ins = inLtr(mpx, W, H, px, py);
        if (ins && !inSeg)      { sx = px; sy = py; inSeg = true; }
        else if (!ins && inSeg) { segs.push([sx, sy, px, py]); inSeg = false; }
      }
      if (inSeg) segs.push([sx, sy, ox + cos*diag, oy + sin*diag]);
    }
    return segs;
  }

  /* ── Support structure: raft at top, pillars to letter tops ───────────────── */
  interface Supports {
    raft: { x0: number; x1: number; y: number } | null;
    pillars: { x: number; ytop: number; ybot: number }[];
  }
  function genSupports(mpx: Uint8ClampedArray, W: number, H: number): Supports {
    const RAFT_Y = 2;
    const topEdge: number[] = new Array(W).fill(-1);
    let x0 = W, x1 = 0;
    for (let x = 0; x < W; x++) {
      for (let y = 0; y < H; y++) {
        if (mpx[(y*W+x)*4] > 60) {
          topEdge[x] = y;
          x0 = Math.min(x0, x); x1 = Math.max(x1, x);
          break;
        }
      }
    }
    if (x0 > x1) return { raft: null, pillars: [] };
    const raft = { x0: x0 - 4, x1: x1 + 4, y: RAFT_Y };
    const pillars: Supports['pillars'] = [];
    for (let x = x0; x <= x1; x += 18) {
      const yt = topEdge[x];
      if (yt > RAFT_Y + 4) pillars.push({ x, ytop: RAFT_Y, ybot: yt });
    }
    return { raft, pillars };
  }

  /* ── UV laser — violet/near-UV, no heat ───────────────────────────────────── */
  function drawUVLaser(ctx: CanvasRenderingContext2D, x: number, y: number, hot: number) {
    const R = 4 + hot * 2;
    const g = ctx.createRadialGradient(x, y, 0, x, y, R * 4.5);
    g.addColorStop(0,    'rgba(238,222,255,0.97)');
    g.addColorStop(0.12, `rgba(168,98,255,${(0.80+hot*0.15).toFixed(2)})`);
    g.addColorStop(0.45, `rgba(82,32,192,${(0.26+hot*0.10).toFixed(2)})`);
    g.addColorStop(1,    'rgba(42,6,140,0)');
    ctx.fillStyle = g;
    ctx.beginPath(); ctx.arc(x, y, R * 4.5, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = 'rgba(248,242,255,0.98)';
    ctx.beginPath(); ctx.arc(x, y, 1.0, 0, Math.PI * 2); ctx.fill();
    // UV scatter column through liquid resin above the cure plane
    if (hot > 0.3) {
      const scatterH = 26;
      const col = ctx.createLinearGradient(x, y, x, y - scatterH);
      col.addColorStop(0, `rgba(138,78,255,${(0.22 * hot).toFixed(2)})`);
      col.addColorStop(1, 'rgba(78,28,180,0)');
      ctx.fillStyle = col;
      ctx.fillRect(x - 2, y - scatterH, 4, scatterH);
    }
  }

  /* ── Photo-cure fluorescence trail ────────────────────────────────────────── */
  // Stokes-shifted: 405nm excitation → ~470nm blue-cyan emission (TPO/BAPO photoinitiators)
  function drawCureGlow(ctx: CanvasRenderingContext2D, x: number, y: number, alpha: number) {
    if (alpha < 0.02) return;
    const rg = ctx.createRadialGradient(x, y, 0, x, y, 7);
    rg.addColorStop(0, `rgba(80,190,255,${alpha.toFixed(2)})`);
    rg.addColorStop(1, 'rgba(30,110,215,0)');
    ctx.fillStyle = rg;
    ctx.beginPath(); ctx.arc(x, y, 7, 0, Math.PI*2); ctx.fill();
  }

  /* ── Wiper blade (re-leveler between layers) ──────────────────────────────── */
  function drawWiper(ctx: CanvasRenderingContext2D, W: number, H: number, t: number) {
    const x = eio(t) * (W + 30) - 15;
    const g = ctx.createLinearGradient(x-4, 0, x+5, 0);
    g.addColorStop(0,    'rgba(140,98,16,0)');
    g.addColorStop(0.30, 'rgba(178,134,30,0.78)');
    g.addColorStop(0.65, 'rgba(200,154,42,0.90)');
    g.addColorStop(1,    'rgba(155,110,18,0)');
    ctx.fillStyle = g; ctx.fillRect(x-4, 0, 9, H);

    // Liquid meniscus on trailing edge
    const mg = ctx.createLinearGradient(x-18, 0, x, 0);
    mg.addColorStop(0, 'rgba(195,148,38,0)');
    mg.addColorStop(1, 'rgba(218,168,52,0.30)');
    ctx.fillStyle = mg; ctx.fillRect(x-18, 0, 18, H);

    // Trailing resin film (viscous ~1000-5000 cP — no discrete drops, continuous leveling)
    const film = ctx.createLinearGradient(x - 22, 0, x - 2, 0);
    film.addColorStop(0, 'rgba(185,142,32,0)');
    film.addColorStop(1, 'rgba(200,158,44,0.16)');
    ctx.fillStyle = film; ctx.fillRect(x - 22, 0, 20, H);
  }

  /* ── Support raft + pillars ───────────────────────────────────────────────── */
  function drawSupports(ctx: CanvasRenderingContext2D, sup: Supports, alpha: number) {
    if (!sup.raft || alpha <= 0.01) return;
    ctx.save();
    ctx.globalAlpha = alpha;
    ctx.strokeStyle = 'rgba(212,164,44,0.72)';
    ctx.lineWidth = 1.0;
    ctx.beginPath();
    ctx.moveTo(sup.raft.x0, sup.raft.y);
    ctx.lineTo(sup.raft.x1, sup.raft.y);
    ctx.stroke();
    ctx.lineWidth = 0.7;
    for (const p of sup.pillars) {
      ctx.beginPath(); ctx.moveTo(p.x, p.ytop + 1); ctx.lineTo(p.x, p.ybot); ctx.stroke();
    }
    ctx.restore();
  }

  /* ── Main setup ───────────────────────────────────────────────────────────── */
  function setup(wrap: HTMLElement) {
    if (nActive >= MAX_ACT) { setTimeout(() => setup(wrap), 300); return; }
    nActive++;

    const bedEl = wrap.querySelector<HTMLCanvasElement>('.sla-bed');
    const fxEl  = wrap.querySelector<HTMLCanvasElement>('.sla-fx');
    if (!bedEl || !fxEl) { nActive--; return; }

    const heading = wrap.querySelector<HTMLElement>('h1,h2,h3,h4,h5,h6,[data-sla]');
    if (!heading) { nActive--; return; }

    const DUR   = parseFloat(wrap.dataset.slaDuration || '3') * 1000;
    const NLYR  = Math.max(1, Math.min(3, parseInt(wrap.dataset.slaLayers || '2')));
    const DELAY = parseFloat(wrap.dataset.slaDelay   || '0.25') * 1000;

    const rect = wrap.getBoundingClientRect();
    const W = Math.floor(rect.width);
    const H = Math.floor(rect.height);
    if (W < 40 || H < 8) { nActive--; return; }

    const DPR = Math.min(window.devicePixelRatio || 1, 2);
    const PW  = Math.round(W * DPR);
    const PH  = Math.round(H * DPR);

    [bedEl, fxEl].forEach(c => {
      c.width = PW; c.height = PH;
      c.style.width = W + 'px'; c.style.height = H + 'px';
    });
    const bCtx = bedEl.getContext('2d')!;
    const fCtx = fxEl.getContext('2d')!;
    bCtx.scale(DPR, DPR); fCtx.scale(DPR, DPR);

    // Hatch angles (60° increments — distinct from SLS's 67°)
    const ANGLES = [0, Math.PI * 60/180, Math.PI * 120/180];

    // Pre-render resin vat
    const vatOff = mk(PW, PH);
    { const c = vatOff.getContext('2d')!; c.scale(DPR, DPR); renderResinVat(c, W, H); }

    // Pre-render cured surfaces (one per layer)
    const curedOff: HTMLCanvasElement[] = Array.from({ length: NLYR }, (_, i) => {
      const s = mk(PW, PH); const c = s.getContext('2d')!; c.scale(DPR, DPR);
      renderCured(c, W, H, ANGLES[i % ANGLES.length]); return s;
    });

    // Accumulation canvas (grows as UV laser cures)
    const accOff = mk(PW, PH);
    const acCtx  = accOff.getContext('2d')!; acCtx.scale(DPR, DPR);

    // Scratch canvas for destination-in compositing
    const tmpOff = mk(PW, PH);
    const tmCtx  = tmpOff.getContext('2d')!; tmCtx.scale(DPR, DPR);

    document.fonts.ready.then(() => {
      const mpx = buildMask(wrap, heading, W, H);

      // Generate cure paths
      const cPath  = extractContour(mpx, W, H);
      const hPaths = Array.from({ length: NLYR }, (_, i) =>
        genHatch(mpx, W, H, ANGLES[i % ANGLES.length], HSTEP));
      const hLens  = hPaths.map(segs =>
        segs.reduce((a, [x1,y1,x2,y2]) => a + Math.hypot(x2-x1, y2-y1), 0));

      // Support structures (raft at top of canvas, pillars to letter tops)
      const supports = genSupports(mpx, W, H);

      // Phase schedule (fractions of total duration, mirroring SLS structure)
      interface Ph { name: string; t0: number; t1: number; layer: number }
      const phases: Ph[] = [];
      let ti = 0;
      phases.push({ name:'vat', t0:ti, t1:(ti += 0.08), layer:0 });
      // 0.03 peel + 0.035 wipe between each layer pair
      const interLayer = (NLYR - 1) * 0.065;
      const perLyr = (1.0 - 0.08 - interLayer) / NLYR;
      for (let i = 0; i < NLYR; i++) {
        if (i > 0) {
          phases.push({ name:'peel', t0:ti, t1:(ti += 0.030), layer:i-1 });
          phases.push({ name:'wipe', t0:ti, t1:(ti += 0.035), layer:i });
        }
        phases.push({ name:'contour', t0:ti, t1:(ti += perLyr * 0.28), layer:i });
        phases.push({ name:'hatch',   t0:ti, t1:(ti += perLyr * 0.72), layer:i });
      }

      // Animation state
      let phaseIdx     = 0;
      let cIdx         = 0;
      const hIdx       = Array(NLYR).fill(0);
      const hT         = Array(NLYR).fill(0);
      let   laserX     = -20, laserY = H * 0.5, laserHot = 0;
      type TrailPt    = { x:number; y:number; age:number };
      const trail: TrailPt[] = [];
      let lastTs: number | null = null;
      let lastPhName = '';
      let startTs    = 0;

      /* Composite during vat/cure phases: liquid resin + cured overlay.
         peelY < 0 shifts cured content upward (FEP separation lift).   */
      function compositeVat(layer: number, peelY = 0) {
        bCtx.clearRect(0, 0, W, H);
        const slyr = Math.max(0, Math.min(NLYR-1, layer));
        bCtx.drawImage(vatOff, 0, 0, W, H);
        tmCtx.clearRect(0, 0, W, H);
        tmCtx.drawImage(curedOff[slyr], 0, 0, W, H);
        tmCtx.globalCompositeOperation = 'destination-in';
        tmCtx.drawImage(accOff, 0, 0, W, H);
        tmCtx.globalCompositeOperation = 'source-over';
        bCtx.drawImage(tmpOff, 0, peelY, W, H);
      }

      function cureAt(x: number, y: number) {
        acCtx.shadowBlur = 3; acCtx.shadowColor = '#fff';
        acCtx.fillStyle = '#fff';
        acCtx.beginPath(); acCtx.arc(x, y, 4.5, 0, Math.PI * 2); acCtx.fill();
        acCtx.shadowBlur = 0;
      }

      function finalise() {
        fxEl.style.display = 'none';
        bedEl.style.transition = 'opacity 0.28s ease';
        bedEl.style.opacity = '0';
        heading.style.visibility = 'visible';
        setTimeout(() => { bedEl.style.display = 'none'; nActive--; }, 320);
      }

      function showDone() {
        bedEl.style.display = 'none'; fxEl.style.display = 'none';
        heading.style.visibility = 'visible'; nActive--;
      }

      if (REDUCED) { showDone(); return; }

      heading.style.visibility = 'hidden';
      compositeVat(0); // show resin vat immediately to avoid flash

      function frame(ts: number) {
        if (!lastTs) lastTs = ts;
        const dt  = Math.min((ts - lastTs) / 1000, 0.05);
        lastTs = ts;
        const pct = Math.min((ts - startTs) / DUR, 1.0);

        while (phaseIdx < phases.length - 1 && pct >= phases[phaseIdx].t1) phaseIdx++;
        const ph = phases[phaseIdx];
        const pt = ph.t1 > ph.t0 ? Math.min(1, (pct - ph.t0) / (ph.t1 - ph.t0)) : 1;

        if (ph.name === 'contour' && lastPhName !== 'contour') cIdx = 0;
        lastPhName = ph.name;

        // Age and prune cure-fluorescence trail
        for (const tp of trail) tp.age += dt / TRAIL_LIFE;
        while (trail.length > 0 && trail[0].age >= 1) trail.shift();

        fCtx.clearRect(0, 0, W, H);

        /* ── VAT SETTLE ─────────────────────────────────────────────────────── */
        if (ph.name === 'vat') {
          compositeVat(0);
          if (pt > 0.5) {
            const li = eio((pt - 0.5) * 2);
            laserX = -20 + li * (W * 0.12 + 20);
            laserY = H * 0.5; laserHot = 0.2;
            drawUVLaser(fCtx, laserX, laserY, laserHot * (pt - 0.5) * 2);
          }

        /* ── FEP PEEL (build platform lifts to separate cured layer) ────── */
        } else if (ph.name === 'peel') {
          const lift = Math.sin(pt * Math.PI) * 5;  // 0 → 5px → 0
          compositeVat(ph.layer, -lift);
          // Resin separation filaments at peak lift
          if (lift > 1.5) {
            const fa = (0.30 * Math.sin(pt * Math.PI)).toFixed(2);
            fCtx.strokeStyle = `rgba(185,138,28,${fa})`;
            fCtx.lineWidth = 0.7;
            for (let fx = W * 0.15; fx < W * 0.88; fx += W * 0.16) {
              fCtx.beginPath();
              fCtx.moveTo(fx, H * 0.9);
              fCtx.lineTo(fx + (Math.random() - 0.5) * 6, H * 0.9 - lift * 1.2);
              fCtx.stroke();
            }
          }

        /* ── WIPER (resin re-leveler) ─────────────────────────────────────── */
        } else if (ph.name === 'wipe') {
          compositeVat(ph.layer);
          drawWiper(fCtx, W, H, pt);

        /* ── CONTOUR PASS ───────────────────────────────────────────────────── */
        } else if (ph.name === 'contour') {
          if (cPath.length) {
            const speed = cPath.length / ((ph.t1 - ph.t0) * DUR / 1000);
            let rem = speed * dt;
            while (rem > 0 && cIdx < cPath.length) {
              const p = cPath[cIdx++];
              if (!p.gap) { cureAt(p.x, p.y); laserX = p.x; laserY = p.y; laserHot = 1; }
              else        { laserX = p.x; laserY = p.y; laserHot = 0.3; }
              rem--;
            }
          }
          compositeVat(ph.layer);
          for (const tp of trail) drawCureGlow(fCtx, tp.x, tp.y, (1 - tp.age) * 0.40);
          drawUVLaser(fCtx, laserX, laserY, laserHot);
          if (laserHot > 0.3) {
            trail.push({ x: laserX, y: laserY, age: 0 });
            if (trail.length > 80) trail.splice(0, trail.length - 80);
          }

        /* ── HATCH FILL ─────────────────────────────────────────────────────── */
        } else if (ph.name === 'hatch') {
          const L = ph.layer;
          const segs = hPaths[L]; const total = hLens[L];
          if (total > 0) {
            const speed = total / ((ph.t1 - ph.t0) * DUR / 1000);
            let rem = speed * dt;
            while (rem > 0 && hIdx[L] < segs.length) {
              const [x1,y1,x2,y2] = segs[hIdx[L]];
              const dx = x2-x1, dy = y2-y1, len = Math.hypot(dx, dy);
              if (len < 0.1) { hIdx[L]++; continue; }
              const toEnd = (1 - hT[L]) * len;
              if (rem >= toEnd) {
                rem -= toEnd; hT[L] = 0; hIdx[L]++;
                cureAt(x2, y2); laserX = x2; laserY = y2; laserHot = 1;
              } else {
                hT[L] += rem / len;
                const nx = x1 + dx*hT[L], ny = y1 + dy*hT[L];
                cureAt(nx, ny); laserX = nx; laserY = ny; laserHot = 1;
                rem = 0;
              }
            }
          }
          compositeVat(ph.layer);
          for (const tp of trail) drawCureGlow(fCtx, tp.x, tp.y, (1 - tp.age) * 0.40);
          drawUVLaser(fCtx, laserX, laserY, laserHot);
          if (laserHot > 0.3) {
            trail.push({ x: laserX, y: laserY, age: 0 });
            if (trail.length > 80) trail.splice(0, trail.length - 80);
          }
          if (ph.layer === NLYR - 1 && pt >= 1) { finalise(); return; }
        }

        // Support overlay (raft + pillars) on fxEl — fades in on vat, full otherwise
        const sAlpha = ph.name === 'vat' ? eio(pt) : 1;
        drawSupports(fCtx, supports, sAlpha);

        requestAnimationFrame(frame);
      }

      setTimeout(() => { startTs = performance.now(); requestAnimationFrame(frame); }, DELAY);
    });
  }

  /* ── Observer / init ──────────────────────────────────────────────────────── */
  function init() {
    document.querySelectorAll<HTMLElement>('.sla-wrap').forEach(wrap => {
      if (REDUCED) return;
      const trig = wrap.dataset.slaTrigger || 'scroll';
      if (trig === 'scroll' && 'IntersectionObserver' in window) {
        const obs = new IntersectionObserver(entries => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              obs.unobserve(e.target as HTMLElement);
              setup(e.target as HTMLElement);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -20px 0px' });
        obs.observe(wrap);
      } else {
        setup(wrap);
      }
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
