---
/**
 * VideoFigure — self-hosted video with a poster and no preloading.
 *
 * The source clips are silent with burned-in captions, so they carry their
 * own narration and need no audio track. `preload="none"` means nothing but
 * the poster image downloads until a visitor presses play, which matters on
 * a site most people reach from a business card on their phone.
 */

interface Props {
  src:      string;
  poster:   string;
  /** Describes the footage for anyone who cannot watch it. */
  label:    string;
  caption?: string;
  /** Loop silently without controls — for decorative hero use. */
  ambient?: boolean;
}

const { src, poster, label, caption, ambient = false } = Astro.props;
---

<figure class="vf">
  <div class="vf-frame">
    <video
      src={src}
      poster={poster}
      controls={!ambient}
      muted
      playsinline
      loop={ambient}
      autoplay={ambient}
      preload="none"
      aria-label={label}
    ></video>
    <span class="vf-silent" aria-hidden="true">Silent · captioned</span>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .vf {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .vf-frame {
    position: relative;
    border: 1px solid var(--panel-edge);
    background: var(--panel);
    line-height: 0;
  }

  .vf video {
    width: 100%;
    aspect-ratio: 16 / 9;
    display: block;
    object-fit: cover;
    background: var(--graphite);
  }

  .vf-silent {
    position: absolute;
    top: 0;
    right: 0;
    padding: 0.26rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--steel);
    background: color-mix(in srgb, var(--graphite) 86%, transparent);
    border-left: 1px solid var(--panel-edge);
    border-bottom: 1px solid var(--panel-edge);
    line-height: 1.4;
    pointer-events: none;
  }

  figcaption {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    line-height: 1.6;
    color: var(--steel);
  }
</style>
