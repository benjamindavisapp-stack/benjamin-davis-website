---
// Background: the two materials this work is actually made of.
//
// Rows alternate between the polymers that go through the extruder and the
// metal the machines and the card are cut from:
//
//   PET  -[O-CH2-CH2-O-CO-C6H4-CO]-   the bottle waste the research recycles
//   PA6  -[NH-(CH2)5-CO]-             nylon, no aromatic ring, so it reads as
//                                      a pure zig-zag against PET's rings
//   FCC                                aluminium's face-centred cubic cell —
//                                      6061-T6 is what the card is machined from
//
// Standard skeletal convention for the chains: vertices are carbons, only
// heteroatoms get a label, bonds stop short of a label, and one repeat per row
// carries the polymer brackets and their n subscript.
//
// The unit cells are drawn as a wireframe with face diagonals and small open
// rings at the lattice points. Deliberately not filled dots: 14 filled circles
// in a regular box is a dot grid, which is the pattern this background replaced.
//
// A page can name its own material with the `material` prop. This changes only
// where a page is genuinely about one substance — the card page is aluminium
// because the card is milled from 6061-T6. Everywhere else keeps the house mix,
// so a change in the background actually means something rather than being
// variety for its own sake.
//
// Drawn once, not per frame. Caller must give the parent position:relative and
// overflow:hidden.

interface Props {
  /** 'mix' (default) · 'aluminium' · 'feedstock' (PET + PLA) · 'silicon' */
  material?: 'mix' | 'aluminium' | 'feedstock' | 'silicon' | 'steel' | 'peek' | 'ptfe' | 'cellulose' | 'carbide';
}
const { material = 'mix' } = Astro.props;
---

<canvas class="lattice" data-material={material} aria-hidden="true"></canvas>

<script>
  // Sits ~1.65:1 against --graphite. The first version was 1.27:1, which looked
  // right on a good monitor in a dark room and vanished on a phone outdoors —
  // where most visitors are, arriving from the card.
  const STROKE = 'rgba(52, 56, 65, 0.95)';
  const LABEL  = 'rgba(70, 76, 87, 0.95)';   // ~2.3:1, so O/N/n survive a bad screen

  interface Pt { x: number; y: number }

  interface Geo {
    L: number;        // bond length; everything else derives from it
    inner: number;    // aromatic / double-bond inner-line offset
    labelR: number;   // bond trim around an atom label
  }

  const pt = (x: number, y: number): Pt => ({ x, y });
  const rad = (deg: number) => (deg * Math.PI) / 180;
  const COS30 = Math.cos(rad(30));

  function hash(n: number): number {
    const s = Math.sin(n * 127.1) * 43758.5453;
    return s - Math.floor(s);
  }

  /* ── Primitives ────────────────────────────────────────────────────────── */

  function bond(ctx: CanvasRenderingContext2D, a: Pt, b: Pt, trimA = 0, trimB = 0) {
    const dx = b.x - a.x, dy = b.y - a.y;
    const d  = Math.hypot(dx, dy) || 1;
    const ux = dx / d, uy = dy / d;
    ctx.beginPath();
    ctx.moveTo(a.x + ux * trimA, a.y + uy * trimA);
    ctx.lineTo(b.x - ux * trimB, b.y - uy * trimB);
    ctx.stroke();
  }

  function innerLine(ctx: CanvasRenderingContext2D, a: Pt, b: Pt, off: number, inset = 0.18) {
    const dx = b.x - a.x, dy = b.y - a.y;
    const d  = Math.hypot(dx, dy) || 1;
    const ux = dx / d, uy = dy / d;
    const nx = -uy * off, ny = ux * off;
    ctx.beginPath();
    ctx.moveTo(a.x + ux * d * inset + nx, a.y + uy * d * inset + ny);
    ctx.lineTo(b.x - ux * d * inset + nx, b.y - uy * d * inset + ny);
    ctx.stroke();
  }

  function atom(ctx: CanvasRenderingContext2D, p: Pt, text: string) {
    ctx.fillStyle = LABEL;
    ctx.fillText(text, p.x, p.y);
    ctx.fillStyle = STROKE;
  }

  function openRing(ctx: CanvasRenderingContext2D, p: Pt, r: number) {
    ctx.beginPath();
    ctx.arc(p.x, p.y, r, 0, Math.PI * 2);
    ctx.stroke();
  }

  // Carbonyl: C=O perpendicular to the chain, with the O labelled.
  function carbonyl(ctx: CanvasRenderingContext2D, c: Pt, dir: number, g: Geo) {
    const o = pt(c.x, c.y + dir * g.L);
    bond(ctx, c, o, 0, g.labelR);
    innerLine(ctx, c, o, g.L * 0.13, 0.22);
    atom(ctx, pt(o.x, o.y + dir * g.L * 0.06), 'O');
  }

  /* ── Benzene ───────────────────────────────────────────────────────────── */
  // Pointy-left/right, so vertices 1 and 4 sit on the horizontal axis — the
  // para substitution PET's terephthalate unit has.
  function ring(ctx: CanvasRenderingContext2D, centre: Pt, g: Geo) {
    const v: Pt[] = [];
    for (let i = 0; i < 6; i++) {
      v.push(pt(centre.x + Math.cos(rad(i * 60)) * g.L,
                centre.y + Math.sin(rad(i * 60)) * g.L));
    }
    for (let i = 0; i < 6; i++) bond(ctx, v[i], v[(i + 1) % 6]);
    for (let i = 0; i < 6; i += 2) innerLine(ctx, v[i], v[(i + 1) % 6], -g.inner);
    return { left: v[3], right: v[0] };
  }

  /* ── Chain zig-zag ─────────────────────────────────────────────────────── */
  // Walks `count` bonds alternating ±30°, calling back at each atom. Both
  // polymers below use an odd bond count, so a strict zig-zag would finish half
  // a step off the line it started on; alternate units mirror their starting
  // direction and the chain stays level over each pair.
  function chain(
    ctx: CanvasRenderingContext2D, start: Pt, count: number, mirror: boolean, g: Geo,
    marks: Record<number, string>,
    at: (i: number, p: Pt) => void,
  ): Pt {
    const sign = mirror ? 1 : -1;
    let p = start;
    for (let i = 0; i < count; i++) {
      const a = rad(sign * 30 * (i % 2 === 0 ? 1 : -1));
      const next = pt(p.x + Math.cos(a) * g.L, p.y + Math.sin(a) * g.L);
      bond(ctx, p, next, marks[i] ? g.labelR : 0, marks[i + 1] ? g.labelR : 0);
      at(i, next);
      if (marks[i + 1]) atom(ctx, next, marks[i + 1]);
      p = next;
    }
    return p;
  }

  /* ── PET repeat ────────────────────────────────────────────────────────── */
  // ring - C(=O) - O - CH2 - CH2 - O - C(=O) - ring.
  // Atom 1 and 6 are the carbonyl carbons, 2 and 5 the ester oxygens, 3 and 4
  // the glycol CH2s (carbons, so unlabelled).
  function petUnit(ctx: CanvasRenderingContext2D, start: Pt, mirror: boolean, g: Geo): Pt {
    return chain(ctx, start, 7, mirror, g, { 2: 'O', 5: 'O' }, (i, next) => {
      if (i === 0) carbonyl(ctx, next, -1, g);
      if (i === 5) carbonyl(ctx, next,  1, g);
    });
  }

  /* ── PLA repeat ────────────────────────────────────────────────────────── */
  // O - CH(CH3) - C(=O). Three backbone atoms, so it is much shorter than the
  // other two, and the methyl hanging off every repeat is what identifies it
  // on sight — the only one of these polymers with a branch.
  function plaUnit(ctx: CanvasRenderingContext2D, start: Pt, mirror: boolean, g: Geo): Pt {
    return chain(ctx, start, 3, mirror, g, { 0: 'O', 3: 'O' }, (i, next) => {
      if (i === 0) {
        // Pendant methyl, drawn away from the chain on the opposite side to
        // the carbonyl so the two don't collide.
        const m = pt(next.x, next.y + g.L * 0.9);
        bond(ctx, next, m);
      }
      if (i === 1) carbonyl(ctx, next, -1, g);
    });
  }

  /* ── PTFE repeat ───────────────────────────────────────────────────────── */
  // -[CF2-CF2]-. An all-carbon backbone with two fluorines on every carbon, so
  // it draws as a dense comb of labels rather than a sparse chain. PTFE is the
  // hotend liner and bowden tube in every printer here, and the tape on every
  // threaded joint.
  function ptfeUnit(ctx: CanvasRenderingContext2D, start: Pt, mirror: boolean, g: Geo): Pt {
    return chain(ctx, start, 2, mirror, g, {}, (_i, next) => {
      // Both F on the same carbon, splayed either side of the backbone.
      for (const dx of [-0.52, 0.52]) {
        const f = pt(next.x + g.L * dx, next.y + g.L * 0.78);
        bond(ctx, next, f, 0, g.labelR * 0.8);
        atom(ctx, f, 'F');
      }
    });
  }

  /* ── Cellulose repeat ──────────────────────────────────────────────────── */
  // Beta-1,4-linked glucose: six-membered pyranose rings joined through ring
  // oxygens, with hydroxyls hanging off. Wood, paper and flour are all this.
  // Rings in the backbone like PET, but saturated and covered in OH, so it
  // reads as a knobbly chain rather than a clean aromatic one.
  function celluloseUnit(ctx: CanvasRenderingContext2D, start: Pt, mirror: boolean, g: Geo): Pt {
    const sign = mirror ? 1 : -1;
    // Pyranose drawn as a flat hexagon with its ring oxygen marked.
    const c = pt(start.x + g.L, start.y);
    const v: Pt[] = [];
    for (let i = 0; i < 6; i++) {
      v.push(pt(c.x + Math.cos(rad(i * 60)) * g.L, c.y + Math.sin(rad(i * 60)) * g.L));
    }
    for (let i = 0; i < 6; i++) {
      // The ring oxygen sits at the top vertex; bonds around it stop short.
      const skip = i === 4 || i === 5;
      bond(ctx, v[i], v[(i + 1) % 6], i === 5 ? g.labelR : 0, skip && i === 4 ? g.labelR : 0);
    }
    atom(ctx, v[5], 'O');
    // Hydroxyls below the ring, and the C6 arm above it.
    for (const i of [2, 3]) {
      const oh = pt(v[i].x, v[i].y + g.L * 0.8);
      bond(ctx, v[i], oh, 0, g.labelR);
      atom(ctx, oh, 'O');
    }
    const arm = pt(v[0].x + g.L * 0.5 * sign, v[0].y - g.L * 0.85);
    bond(ctx, v[0], arm);

    // Glycosidic link out to the next ring.
    const link = pt(v[0].x + g.L * COS30, v[0].y + g.L * 0.5);
    bond(ctx, v[0], link, 0, g.labelR);
    atom(ctx, link, 'O');
    const nextLeft = pt(link.x + g.L * COS30, link.y - g.L * 0.5);
    bond(ctx, link, nextLeft, g.labelR, 0);
    return nextLeft;
  }

  /* ── PA6 repeat ────────────────────────────────────────────────────────── */
  // N - CH2 x5 - C(=O) - N. No ring, so it reads as a long zig-zag punctuated
  // by one amide, which is the visual counterpoint to PET.
  function paUnit(ctx: CanvasRenderingContext2D, start: Pt, mirror: boolean, g: Geo): Pt {
    return chain(ctx, start, 7, mirror, g, { 0: 'N', 7: 'N' }, (i, next) => {
      if (i === 5) carbonyl(ctx, next, -1, g);
    });
  }

  /* ── Aluminium FCC unit cell ───────────────────────────────────────────── */
  function cell(ctx: CanvasRenderingContext2D, c: Pt, g: Geo) {
    const s = g.L * 1.45;              // cube edge
    const d = s * 0.42;                // oblique projection depth
    const h = s / 2;
    const front = [pt(c.x - h, c.y - h), pt(c.x + h, c.y - h),
                   pt(c.x + h, c.y + h), pt(c.x - h, c.y + h)];
    const back  = front.map(p => pt(p.x + d, p.y - d));

    for (let i = 0; i < 4; i++) {
      bond(ctx, front[i], front[(i + 1) % 4]);
      bond(ctx, back[i],  back[(i + 1) % 4]);
      bond(ctx, front[i], back[i]);
    }
    // Face diagonals: the close-packed directions, and what keeps this from
    // reading as a plain box of dots.
    bond(ctx, front[0], front[2]);
    bond(ctx, front[1], front[3]);

    const r = Math.max(1, g.L * 0.1);
    front.forEach(p => openRing(ctx, p, r));
    back.forEach(p => openRing(ctx, p, r));
    openRing(ctx, c, r);                          // front face centre
    openRing(ctx, pt(c.x + d, c.y - d), r);       // back face centre
    return s + d;
  }

  /* ── Martensite: body-centred tetragonal ───────────────────────────────── */
  // Quenched steel. Carbon trapped in the iron lattice on cooling stretches one
  // axis, so the cell is taller than it is wide — that stretch is what makes
  // the steel hard, and it is the whole visual difference from the cubic cells:
  // one atom at the body centre, no face centres, no tetrahedral interior.
  function bctCell(ctx: CanvasRenderingContext2D, c: Pt, g: Geo) {
    const a  = g.L * 1.15;
    const ht = g.L * 1.95;
    const d  = a * 0.44;
    const front = [pt(c.x - a / 2, c.y - ht / 2), pt(c.x + a / 2, c.y - ht / 2),
                   pt(c.x + a / 2, c.y + ht / 2), pt(c.x - a / 2, c.y + ht / 2)];
    const back  = front.map(p => pt(p.x + d, p.y - d));

    for (let i = 0; i < 4; i++) {
      bond(ctx, front[i], front[(i + 1) % 4]);
      bond(ctx, back[i],  back[(i + 1) % 4]);
      bond(ctx, front[i], back[i]);
    }

    const mid = pt(c.x + d / 2, c.y - d / 2);
    for (let i = 0; i < 4; i++) bond(ctx, mid, front[i]);
    const r = Math.max(1, g.L * 0.1);
    front.forEach(p => openRing(ctx, p, r));
    back.forEach(p => openRing(ctx, p, r));
    openRing(ctx, mid, r);
  }

  /* ── PEEK repeat ───────────────────────────────────────────────────────── */
  // -[O-C6H4-O-C6H4-CO-C6H4]-. Three aromatic rings per repeat against PET's
  // one, joined by two ethers and a ketone, so the backbone is almost all ring.
  // That density is what makes it read apart from every other chain here.
  // Contract matches petUnit: given the right vertex of the ring the caller just
  // drew, draw the rest of the repeat and return the left vertex of the ring the
  // caller should draw next. Returning a ring's own right vertex instead left
  // the closing bracket sitting inside a ring and the repeats touching with no
  // linker between them.
  function peekUnit(ctx: CanvasRenderingContext2D, start: Pt, mirror: boolean, g: Geo): Pt {
    const sign = mirror ? 1 : -1;
    let p = start;
    let nextLeft = start;
    for (let i = 0; i < 3; i++) {
      const up = i % 2 === 0;
      const link = pt(p.x + Math.cos(rad(sign * 30 * (up ? 1 : -1))) * g.L,
                      p.y + Math.sin(rad(sign * 30 * (up ? 1 : -1))) * g.L);
      const ketone = i === 2;
      bond(ctx, p, link, 0, ketone ? 0 : g.labelR);
      if (ketone) carbonyl(ctx, link, -1, g);
      else atom(ctx, link, 'O');

      nextLeft = pt(link.x + Math.cos(rad(-sign * 30 * (up ? 1 : -1))) * g.L,
                    link.y + Math.sin(rad(-sign * 30 * (up ? 1 : -1))) * g.L);
      bond(ctx, link, nextLeft, ketone ? 0 : g.labelR, 0);
      if (i < 2) p = ring(ctx, pt(nextLeft.x + g.L, nextLeft.y), g).right;
    }
    return nextLeft;
  }

  /* ── Tungsten carbide: simple hexagonal ────────────────────────────────── */
  // WC is hexagonal, not cubic, so it is the one cell here that is not a box —
  // a prism rather than a cube. It is what the endmills, router bits and inserts
  // are actually made of, which is why it sits on the equipment page.
  function hexCell(ctx: CanvasRenderingContext2D, c: Pt, g: Geo) {
    const r  = g.L * 1.05;
    const ht = g.L * 1.5;
    const sq = 0.42;                    // vertical squash, so it reads as a solid
    const face = (dy: number) => {
      const v: Pt[] = [];
      for (let i = 0; i < 6; i++) {
        const a = rad(i * 60 + 30);
        v.push(pt(c.x + Math.cos(a) * r, c.y + dy + Math.sin(a) * r * sq));
      }
      return v;
    };
    const top = face(-ht / 2), bot = face(ht / 2);
    for (let i = 0; i < 6; i++) {
      bond(ctx, top[i], top[(i + 1) % 6]);
      bond(ctx, bot[i], bot[(i + 1) % 6]);
      bond(ctx, top[i], bot[i]);
    }
    const rr = Math.max(1, g.L * 0.1);
    top.forEach(p => openRing(ctx, p, rr));
    bot.forEach(p => openRing(ctx, p, rr));
    openRing(ctx, c, rr);               // the interstitial carbon
  }

  /* ── Silicon: diamond cubic ────────────────────────────────────────────── */
  // Same cube as the FCC cell, but with the tetrahedral interior that makes it
  // diamond cubic rather than close-packed — each atom bonded to four others at
  // 109.5°. That interior is the whole visual difference, so it is drawn and
  // the face diagonals are not.
  // Bigger, and projected the other way. Side by side with the aluminium cell
  // at the same size and angle these were nearly indistinguishable — the
  // interior is too fine a difference to survive background contrast. The size
  // is not arbitrary: silicon's lattice constant is 5.43 Å against aluminium's
  // 4.05, and diamond cubic fills only 34% of its cell where close-packed FCC
  // fills 74%, so an open, larger, sparser cell is what the material is.
  function siliconCell(ctx: CanvasRenderingContext2D, c: Pt, g: Geo) {
    const s = g.L * 1.95;
    const d = -s * 0.40;
    const h = s / 2;
    const front = [pt(c.x - h, c.y - h), pt(c.x + h, c.y - h),
                   pt(c.x + h, c.y + h), pt(c.x - h, c.y + h)];
    const back  = front.map(p => pt(p.x + d, p.y - d));

    for (let i = 0; i < 4; i++) {
      bond(ctx, front[i], front[(i + 1) % 4]);
      bond(ctx, back[i],  back[(i + 1) % 4]);
      bond(ctx, front[i], back[i]);
    }

    // Two of the four tetrahedral sites, at the quarter positions along the
    // body diagonal, each bonded to the corners nearest it.
    const r = Math.max(1, g.L * 0.1);
    const t1 = pt(c.x - h * 0.5 + d * 0.25, c.y - h * 0.5 - d * 0.25);
    const t2 = pt(c.x + h * 0.5 + d * 0.75, c.y + h * 0.5 - d * 0.75);
    bond(ctx, t1, front[0]); bond(ctx, t1, front[1]); bond(ctx, t1, back[0]);
    bond(ctx, t2, front[2]); bond(ctx, t2, front[3]); bond(ctx, t2, back[2]);
    openRing(ctx, t1, r);
    openRing(ctx, t2, r);
    front.forEach(p => openRing(ctx, p, r));
    back.forEach(p => openRing(ctx, p, r));
  }

  /* ── Polymer brackets ──────────────────────────────────────────────────── */
  // [ ... ]n — the notation that says polymer rather than molecule.
  function brackets(ctx: CanvasRenderingContext2D, x0: number, x1: number, y: number, g: Geo) {
    const h    = g.L * 1.55;
    const claw = g.L * 0.26;
    const draw = (x: number, dir: number) => {
      ctx.beginPath();
      ctx.moveTo(x + claw * dir, y - h);
      ctx.lineTo(x, y - h);
      ctx.lineTo(x, y + h);
      ctx.lineTo(x + claw * dir, y + h);
      ctx.stroke();
    };
    draw(x0, 1);
    draw(x1, -1);

    const prev = ctx.font;
    ctx.font = `${Math.max(6, Math.round(g.L * 0.36))}px 'IBM Plex Mono', ui-monospace, monospace`;
    ctx.textAlign = 'left';
    atom(ctx, pt(x1 + claw * 0.6, y + h), 'n');
    ctx.textAlign = 'center';
    ctx.font = prev;
  }

  /* ── Scene ─────────────────────────────────────────────────────────────── */

  function render(ctx: CanvasRenderingContext2D, W: number, H: number, material: string) {
    ctx.clearRect(0, 0, W, H);

    // Bond length tracks the viewport. Fixed, a 390px phone got barely one and
    // a half repeats across the hero and the chain never resolved.
    const L: number = Math.max(12, Math.min(26, W / 28));
    const g: Geo = { L, inner: L * 0.162, labelR: L * 0.25 };

    ctx.lineWidth    = Math.max(0.6, L * 0.031);
    ctx.lineCap      = 'round';
    ctx.lineJoin     = 'round';
    ctx.strokeStyle  = STROKE;
    ctx.textAlign    = 'center';
    ctx.textBaseline = 'middle';
    ctx.font = `${Math.max(7, Math.round(L * 0.44))}px 'IBM Plex Mono', ui-monospace, monospace`;

    const petSpan = 2 * L + 7 * L * COS30;
    const paSpan  = 7 * L * COS30;
    const plaSpan = 3 * L * COS30;
    const peekSpan = 3 * (2 * L + 2 * L * COS30);
    const ptfeSpan = 2 * L * COS30;
    const celSpan  = 2 * L + 2 * L * COS30;
    // Silicon's cell is larger, so its rows need more room between them than
    // the chains or the tighter metal cell do.
    const gap     = L * (material === 'silicon' ? 5 : 3.6);

    // Rows vary in spacing and carry a sub-degree tilt. Perfectly parallel,
    // evenly spaced rows read as wallpaper rather than a drawn structure.
    let y = -gap;
    for (let row = -1; y < H + gap; row++) {
      // Every fourth row is metal, on a fixed cycle rather than a hash. A hash
      // distributes fine over hundreds of rows but clumps badly over the four
      // or five a hero actually has — the first cell landed on row 9, so most
      // heroes showed no aluminium at all.
      const cycle = ((row % 4) + 4) % 4;
      const kind  =
          material === 'aluminium' ? 'fcc'
        : material === 'silicon'   ? 'si'
        : material === 'steel'     ? 'bct'
        : material === 'peek'      ? 'peek'
        : material === 'ptfe'      ? 'ptfe'
        : material === 'carbide'   ? 'wc'
        : material === 'cellulose' ? 'cel'
        // The extruder page is only what goes through the extruder: no metal,
        // and PLA alternating with PET rather than PA.
        : material === 'feedstock' ? (hash(row * 4.3 + 7) < 0.5 ? 'pet' : 'pla')
        : cycle === 1 ? 'fcc'
        : (hash(row * 4.3 + 7) < 0.5 ? 'pet' : 'pa');
      const tilt  = (hash(row * 3.7 + 11) - 0.5) * rad(2.2);

      ctx.save();
      ctx.translate(0, y);
      ctx.rotate(tilt);

      if (kind === 'fcc' || kind === 'si' || kind === 'bct' || kind === 'wc') {
        // Against polymer, a unit cell carries far more strokes than a length
        // of chain, so evenly spaced cells read as a dense band rather than
        // punctuation — they sit about four cell widths apart. On a page that
        // is all metal there is no chain to punctuate, so they pack closer and
        // read as bulk material. The per-row tilt and offset keep them off a
        // regular grid either way.
        // Close-packed metal sits tight; the open silicon lattice sits sparse.
        const step = L * (kind === 'si' ? 8.5 : kind === 'bct' ? 4.2 : kind === 'wc' ? 5 : material === 'aluminium' ? 4.6 : 8);
        const draw = kind === 'si' ? siliconCell : kind === 'bct' ? bctCell : kind === 'wc' ? hexCell : cell;
        for (let x = -step * (0.2 + hash(row) * 0.8); x < W / Math.cos(tilt) + step; x += step) {
          draw(ctx, pt(x, 0), g);
        }
      } else {
        // Each polymer gets its own scale. Chemistry alone was not enough to
        // tell them apart at background contrast — every chain read as the same
        // horizontal line — so the aromatic one is drawn coarse and the
        // short-repeat one fine, which is also roughly what their repeat
        // lengths are.
        const scale = kind === 'pet' ? 1.15 : kind === 'pla' ? 0.7 : kind === 'peek' ? 0.92
                    : kind === 'ptfe' ? 0.78 : kind === 'cel' ? 1.05 : 1;
        const gl: Geo = { L: L * scale, inner: g.inner * scale, labelR: g.labelR * scale };
        const span   = W / Math.cos(tilt) + petSpan * 2;
        const unit   = kind === 'pet' ? petUnit : kind === 'pla' ? plaUnit
                     : kind === 'peek' ? peekUnit : kind === 'ptfe' ? ptfeUnit
                     : kind === 'cel' ? celluloseUnit : paUnit;
        const stride = (kind === 'pet' ? petSpan : kind === 'pla' ? plaSpan
                      : kind === 'peek' ? peekSpan : kind === 'ptfe' ? ptfeSpan
                      : kind === 'cel' ? celSpan : paSpan) * scale;
        const marked = 1 + Math.floor(hash(row * 5.3 + 2) * 2);

        const strand = (yOff: number, flip: boolean, bracket: boolean) => {
          let p = pt(-stride * (0.15 + hash(row) * 0.9), yOff);
          let k = 0;
          while (p.x < span) {
            const start = p;
            // Both ring-backbone polymers start a repeat at a ring's right
            // vertex, so the ring is drawn before the linkers that follow it.
            if (kind === 'pet' || kind === 'peek') {
              const { right } = ring(ctx, pt(p.x + gl.L, p.y), gl);
              p = unit(ctx, right, flip !== (k % 2 === 1), gl);
            } else {
              p = unit(ctx, p, flip !== (k % 2 === 1), gl);
            }
            // Both brackets sit the same distance ahead of a unit's start, so
            // they cut the bonds between repeats rather than through a ring.
            if (bracket && k === marked) {
              brackets(ctx, start.x - gl.L * 0.45, p.x - gl.L * 0.45, (start.y + p.y) / 2, gl);
            }
            k++;
          }
        };

        if (kind === 'pa') {
          // Nylon crystallises in hydrogen-bonded sheets: adjacent chains run
          // antiparallel and the N-H of one bonds to the C=O of the next. That
          // is the defining feature of a polyamide and the reason it behaves
          // the way it does, so PA is drawn as a bonded pair rather than a lone
          // strand — which also makes it read as a ladder instead of one more
          // horizontal line.
          const sep = gl.L * 2.6;
          strand(0, false, true);
          strand(sep, true, false);
          ctx.save();
          ctx.setLineDash([gl.L * 0.1, gl.L * 0.16]);
          for (let x = -stride; x < span; x += stride / 2) {
            bond(ctx, pt(x, gl.L * 0.55), pt(x, sep - gl.L * 0.55));
          }
          ctx.restore();
        } else {
          strand(0, false, true);
        }
      }

      ctx.restore();
      // A bonded pair is two strands tall, so it needs its own clearance.
      y += gap * (0.84 + hash(row * 2.1 + 5) * 0.34) + (kind === 'pa' ? L * 2.6 : 0);
    }
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas.lattice').forEach(canvas => {
    const ctx = canvas.getContext('2d')!;

    const material = canvas.dataset.material || 'mix';

    function draw() {
      const w = canvas.offsetWidth, h = canvas.offsetHeight;
      if (w < 2 || h < 2) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width  = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      render(ctx, w, h, material);
    }

    let pending = 0;
    new ResizeObserver(() => {
      cancelAnimationFrame(pending);
      pending = requestAnimationFrame(draw);
    }).observe(canvas);

    draw();
  });
</script>

<style>
  .lattice {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
</style>
