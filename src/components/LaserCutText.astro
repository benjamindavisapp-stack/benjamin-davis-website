---
// LaserCutText.astro — Laser through-cut text treatment.
// A focused beam traces glyph contours on a metal sheet, throwing sparks.
// The kerf cools, then the waste sheet falls away, freeing the cut letters.
interface Props {
  duration?: number;
  delay?:    number;
  trigger?:  'scroll' | 'load';
  material?: 'steel' | 'aluminum' | 'acrylic';
  id?:       string;
  class?:    string;
}
const {
  duration = 3.0,
  delay    = 0.25,
  trigger  = 'scroll',
  material = 'steel',
  id,
  class: cls,
} = Astro.props;
const lcId = id ?? ('lc-' + Math.random().toString(36).slice(2, 8));
---

<div
  class:list={['lcut-wrap', cls]}
  data-lc-duration={String(duration)}
  data-lc-delay={String(delay)}
  data-lc-trigger={trigger}
  data-lc-material={material}
  data-lc-id={lcId}
>
  <slot />
  <canvas class="lcut-bed" aria-hidden="true"></canvas>
  <canvas class="lcut-fx"  aria-hidden="true"></canvas>
</div>

<style>
  .lcut-wrap { position: relative; display: block; }
  .lcut-bed, .lcut-fx {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    pointer-events: none; display: block;
  }
  .lcut-bed { z-index: 10; }
  .lcut-fx  { z-index: 11; }
</style>

<script>
(function () {
  'use strict';

  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let nActive   = 0;
  const MAX_ACT = 2;
  const KERF_COOL   = 2.5;    // seconds kerf stays visible
  const MAX_SPARKS  = 120;
  const MAX_KERF    = 1800;

  function mk(w: number, h: number): HTMLCanvasElement {
    const c = document.createElement('canvas'); c.width = w; c.height = h; return c;
  }
  function eio(t: number) { return t < 0.5 ? 2*t*t : -1 + (4 - 2*t)*t; }
  function clamp(v: number, lo: number, hi: number) { return Math.max(lo, Math.min(hi, v)); }
  function lerp(a: number, b: number, t: number) { return a + (b - a) * t; }

  /* ── Pre-render sheet texture ─────────────────────────────────────────── */
  function renderSheet(ctx: CanvasRenderingContext2D, W: number, H: number, mat: string) {
    if (mat === 'acrylic') {
      const g = ctx.createLinearGradient(0, 0, 0, H);
      g.addColorStop(0, '#d0d8e8'); g.addColorStop(1, '#b8c0d0');
      ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = 'rgba(255,255,255,0.22)';
      ctx.fillRect(0, 0, W, H * 0.4);
    } else {
      const lightness = mat === 'aluminum' ? 1.12 : 1.0;
      const g = ctx.createLinearGradient(0, 0, 0, H);
      g.addColorStop(0,   `hsl(215,8%,${62*lightness}%)`);
      g.addColorStop(0.5, `hsl(215,7%,${50*lightness}%)`);
      g.addColorStop(1,   `hsl(215,8%,${56*lightness}%)`);
      ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
      for (let y = 0; y < H; y++) {
        const b = 0.90 + Math.sin(y * 3.9) * 0.04 + Math.sin(y * 9.3) * 0.02;
        ctx.strokeStyle = `rgba(${180*b|0},${185*b|0},${195*b|0},0.18)`;
        ctx.lineWidth = 0.5;
        ctx.beginPath(); ctx.moveTo(0, y + 0.3); ctx.lineTo(W, y + 0.3); ctx.stroke();
      }
      const spec = ctx.createLinearGradient(0, 0, W * 0.4, H * 0.3);
      spec.addColorStop(0, 'rgba(255,255,255,0.22)');
      spec.addColorStop(1, 'rgba(255,255,255,0)');
      ctx.fillStyle = spec; ctx.fillRect(0, 0, W, H);
    }
  }

  /* ── Build per-letter contour path for cutting ────────────────────────── */
  function buildCutPath(mpx: Uint8ClampedArray, W: number, H: number) {
    type P = { x: number; y: number; cut: boolean };

    // Detect horizontal text-line bands so multi-line headings aren't bridged
    const rowHas = new Uint8Array(H);
    for (let y = 0; y < H; y++) {
      for (let x = 0; x < W; x++) {
        if (mpx[(y*W+x)*4] > 60) { rowHas[y] = 1; break; }
      }
    }
    const bands: { y0: number; y1: number }[] = [];
    let inB = false, bY0 = 0;
    for (let y = 0; y <= H; y++) {
      if (y < H && rowHas[y]) { if (!inB) { inB = true; bY0 = y; } }
      else if (inB) { bands.push({ y0: bY0, y1: y - 1 }); inB = false; }
    }

    const ytA = new Int16Array(W).fill(-1);
    const ybA = new Int16Array(W).fill(-1);
    const path: P[] = [];

    for (const band of bands) {
      const lyt = new Int16Array(W).fill(-1);
      const lyb = new Int16Array(W).fill(-1);
      for (let x = 0; x < W; x++) {
        for (let y = band.y0; y <= band.y1; y++) {
          if (mpx[(y*W+x)*4] > 60) { if (lyt[x] < 0) lyt[x] = y; lyb[x] = y; }
        }
        if (lyt[x] >= 0) { ytA[x] = lyt[x]; ybA[x] = lyb[x]; }
      }

      const groups: { xl: number; xr: number }[] = [];
      let gs = -1;
      for (let x = 0; x <= W; x++) {
        if (x < W && lyt[x] >= 0) { if (gs < 0) gs = x; }
        else if (gs >= 0) { groups.push({ xl: gs, xr: x - 1 }); gs = -1; }
      }
      for (const { xl, xr } of groups) {
        path.push({ x: xl, y: lyt[xl] - 2, cut: false });
        for (let x = xl; x <= xr; x++) path.push({ x, y: lyt[x] - 1.5, cut: true });
        path.push({ x: xr, y: lyb[xr] + 1.5, cut: true });
        for (let x = xr - 1; x >= xl; x--) path.push({ x, y: lyb[x] + 1.5, cut: true });
        path.push({ x: xl, y: lyt[xl] - 1.5, cut: true });
      }
    }
    return { path, ytA, ybA };
  }

  /* ── Glyph mask from live DOM (Range API) ─────────────────────────────── */
  function buildMask(wrap: HTMLElement, heading: HTMLElement, W: number, H: number) {
    const off = mk(W, H);
    const ctx = off.getContext('2d')!;
    const pr  = wrap.getBoundingClientRect();
    const range = document.createRange();
    ctx.fillStyle = '#fff';
    function walk(node: Node) {
      if (node.nodeType === Node.TEXT_NODE) {
        const txt = (node.textContent || '').trim();
        if (!txt) return;
        const el  = (node.parentElement ?? heading) as HTMLElement;
        const cs  = window.getComputedStyle(el);
        ctx.font  = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
        ctx.textBaseline = 'alphabetic';
        const m = ctx.measureText(txt);
        range.selectNode(node);
        for (const r of Array.from(range.getClientRects())) {
          if (r.width < 2) continue;
          ctx.save();
          ctx.beginPath();
          ctx.rect(r.left - pr.left, r.top - pr.top, r.width + 1, r.height + 1);
          ctx.clip();
          ctx.fillText(txt, r.left - pr.left, r.top - pr.top + m.fontBoundingBoxAscent);
          ctx.restore();
        }
      } else { node.childNodes.forEach(walk); }
    }
    walk(heading);
    return ctx.getImageData(0, 0, W, H).data;
  }

  /* ── Spark particle system ────────────────────────────────────────────── */
  type Spark = { x: number; y: number; vx: number; vy: number; life: number; maxLife: number };
  const sparks: Spark[] = [];
  const GRAV = 220;

  /* ── Smoke / plasma plume particles ───────────────────────────────────── */
  type Smoke = { x: number; y: number; r: number; vx: number; vy: number; life: number; maxLife: number };
  const smokes: Smoke[] = [];
  const MAX_SMOKES = 25;

  function emitSparks(bx: number, by: number, dt: number, mat: string, ddx = 0, ddy = 1) {
    const isMetal = mat !== 'acrylic';
    const rate = isMetal ? 32 : 12;
    const n = Math.floor(rate * dt * (0.4 + Math.random() * 0.6));
    for (let i = 0; i < n && sparks.length < MAX_SPARKS; i++) {
      const scatter = (Math.random() - 0.5);
      const px = -ddy * scatter * 0.9;
      const py =  ddx * scatter * 0.9;
      // ~18% of sparks launch upward at oblique angles (scatter from kerf interaction)
      const vyBase = isMetal && Math.random() < 0.18
        ? -(18 + Math.random() * 50)
        : 40 + Math.random() * 130;
      sparks.push({
        x: bx, y: by,
        vx: (ddx * 0.4 + px) * 130,
        vy: vyBase + Math.abs(ddy) * 35 + py * 40,
        life: 0,
        maxLife: 0.2 + Math.random() * 0.45,
      });
    }
  }

  function emitPierceSparks(bx: number, by: number, dt: number) {
    const n = Math.floor(42 * dt * (0.6 + Math.random() * 0.4));
    for (let i = 0; i < n && sparks.length < MAX_SPARKS; i++) {
      const ang = Math.random() * Math.PI * 2;
      const spd = 70 + Math.random() * 110;
      sparks.push({
        x: bx, y: by,
        vx: Math.cos(ang) * spd,
        vy: Math.sin(ang) * spd + 55,
        life: 0,
        maxLife: 0.22 + Math.random() * 0.30,  // pierce is more violent — longer lifetime
      });
    }
  }

  function emitSmoke(bx: number, by: number, dt: number) {
    const n = Math.floor(6 * dt * (0.4 + Math.random() * 0.6));
    for (let i = 0; i < n && smokes.length < MAX_SMOKES; i++) {
      smokes.push({
        x: bx + (Math.random() - 0.5) * 3,
        y: by - 1,
        r: 1.0 + Math.random() * 1.8,
        vx: (Math.random() - 0.5) * 7,
        vy: -(10 + Math.random() * 20),
        life: 0,
        maxLife: 0.38 + Math.random() * 0.48,
      });
    }
  }

  function updateSmoke(dt: number) {
    for (let i = smokes.length - 1; i >= 0; i--) {
      const s = smokes[i];
      s.x  += s.vx * dt;
      s.y  += s.vy * dt;
      s.vx *= (1 - dt * 1.8);  // lateral drag dissipates
      s.r  += dt * 4;           // wisp expands as it rises
      s.life += dt;
      if (s.life >= s.maxLife) smokes.splice(i, 1);
    }
  }

  function drawSmoke(ctx: CanvasRenderingContext2D) {
    for (const s of smokes) {
      const t = s.life / s.maxLife;
      const alpha = (t < 0.22 ? t / 0.22 : t > 0.52 ? (1 - t) / 0.48 : 1) * 0.15;
      ctx.fillStyle = `rgba(210,195,175,${alpha.toFixed(3)})`;
      ctx.beginPath(); ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2); ctx.fill();
    }
  }

  function updateSparks(dt: number) {
    for (let i = sparks.length - 1; i >= 0; i--) {
      const s = sparks[i];
      s.x  += s.vx * dt;
      s.y  += s.vy * dt;
      s.vy += GRAV * dt;
      s.life += dt;
      if (s.life >= s.maxLife) sparks.splice(i, 1);
    }
  }

  function drawSparks(ctx: CanvasRenderingContext2D, sparks: Spark[], mat: string) {
    const isMetal = mat !== 'acrylic';
    for (const s of sparks) {
      const f = 1 - s.life / s.maxLife;
      if (isMetal) {
        // White-hot at birth → yellow → orange → dim red
        const gg = Math.round(lerp(60, 255, f));
        const bb = Math.round(Math.max(0, (f - 0.55) / 0.45) * 220);
        ctx.fillStyle = `rgba(255,${gg},${bb},${(f * 0.9).toFixed(2)})`;
      } else {
        ctx.fillStyle = `rgba(200,${220*f|0},255,${f * 0.6})`;
      }
      ctx.fillRect(s.x - 0.75, s.y - 0.75, 1.5, 1.5);
      if (f > 0.45) {
        const tg = Math.round(lerp(60, 200, f));
        ctx.strokeStyle = `rgba(255,${tg},0,${((f - 0.4) * 0.4).toFixed(2)})`;
        ctx.lineWidth   = 0.6;
        ctx.beginPath();
        ctx.moveTo(s.x, s.y);
        ctx.lineTo(s.x - s.vx * 0.022, s.y - s.vy * 0.022);
        ctx.stroke();
      }
    }
  }

  /* ── Beam head ───────────────────────────────────────────────────────── */
  function drawBeamHead(ctx: CanvasRenderingContext2D, x: number, y: number, intensity: number) {
    // Plasma plume — blue-cyan upward flare (Fe I metal-vapor emission)
    const pg = ctx.createRadialGradient(x, y - 5, 0, x, y - 3, 8);
    pg.addColorStop(0, `rgba(130,195,255,${(intensity * 0.55).toFixed(2)})`);
    pg.addColorStop(1, 'rgba(80,150,255,0)');
    ctx.fillStyle = pg;
    ctx.beginPath(); ctx.arc(x, y - 3, 8, 0, Math.PI * 2); ctx.fill();
    // Main beam spot
    const g = ctx.createRadialGradient(x, y, 0, x, y, 10);
    g.addColorStop(0,    `rgba(255,255,240,${intensity})`);
    g.addColorStop(0.18, `rgba(255,220,100,${intensity * 0.8})`);
    g.addColorStop(0.55, `rgba(255,90,0,${intensity * 0.4})`);
    g.addColorStop(1,    'rgba(255,60,0,0)');
    ctx.fillStyle = g;
    ctx.beginPath(); ctx.arc(x, y, 10, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = `rgba(255,255,255,${intensity})`;
    ctx.beginPath(); ctx.arc(x, y, 1.5, 0, Math.PI * 2); ctx.fill();
  }

  /* ── Kerf segments ───────────────────────────────────────────────────── */
  type KerfSeg = { x0: number; y0: number; x1: number; y1: number; born: number };
  const kerfSegs: KerfSeg[] = [];

  function addKerf(x0: number, y0: number, x1: number, y1: number, elapsed: number) {
    kerfSegs.push({ x0, y0, x1, y1, born: elapsed });
    if (kerfSegs.length > MAX_KERF) kerfSegs.shift();
  }

  function drawKerf(ctx: CanvasRenderingContext2D, elapsed: number, opacity: number) {
    if (opacity <= 0) return;
    const BUCK = 10;
    const byBucket: KerfSeg[][] = Array.from({ length: BUCK }, () => []);
    for (const k of kerfSegs) {
      const age = elapsed - k.born;
      if (age < 0 || age > KERF_COOL) continue;
      const bi = clamp(Math.floor(age / KERF_COOL * BUCK), 0, BUCK - 1);
      byBucket[bi].push(k);
    }
    // Kerf gap — thin dark slot showing material removal beneath the glow
    ctx.strokeStyle = `rgba(10,7,5,${(0.75 * opacity).toFixed(2)})`;
    ctx.lineWidth = 0.7; ctx.lineCap = 'round';
    ctx.beginPath();
    for (const k of kerfSegs) {
      const age = elapsed - k.born;
      if (age >= 0 && age <= KERF_COOL) { ctx.moveTo(k.x0, k.y0); ctx.lineTo(k.x1, k.y1); }
    }
    ctx.stroke();
    // HAZ pass — correct steel oxide sequence: blue (hot/fresh) → violet → brown → straw (cold)
    for (let bi = 0; bi < BUCK; bi++) {
      const segs = byBucket[bi];
      if (!segs.length) continue;
      const af = bi / BUCK;
      // af=0 (just cut): steel blue; af=0.5: brown; af=1.0: straw/gold
      const hr = af < 0.5 ? Math.round(lerp(75, 165, af*2)) : Math.round(lerp(165, 192, (af-0.5)*2));
      const hg = af < 0.5 ? Math.round(lerp(100, 85, af*2)) : Math.round(lerp(85, 158, (af-0.5)*2));
      const hb = af < 0.5 ? Math.round(lerp(195, 70, af*2)) : Math.round(lerp(70, 55, (af-0.5)*2));
      const hazA = (lerp(0.26, 0.12, af) * opacity).toFixed(2);
      ctx.strokeStyle = `rgba(${hr},${hg},${hb},${hazA})`;
      ctx.lineWidth = 6; ctx.lineCap = 'round';
      ctx.beginPath();
      for (const k of segs) { ctx.moveTo(k.x0, k.y0); ctx.lineTo(k.x1, k.y1); }
      ctx.stroke();
    }
    // Hot kerf — orange → dark iron-oxide gray (persists, never fades to nothing)
    for (let bi = 0; bi < BUCK; bi++) {
      const segs = byBucket[bi];
      if (!segs.length) continue;
      const af = bi / BUCK;
      const r = Math.round(lerp(255, 38, af));
      const g = Math.round(lerp(120, 26, af));
      const b = Math.round(lerp(0,   22, af));
      const a = (lerp(0.72, 0.48, af) * opacity).toFixed(2);
      ctx.strokeStyle = `rgba(${r},${g},${b},${a})`;
      ctx.lineWidth = 1.5; ctx.lineCap = 'round';
      ctx.beginPath();
      for (const k of segs) { ctx.moveTo(k.x0, k.y0); ctx.lineTo(k.x1, k.y1); }
      ctx.stroke();
    }
  }

  /* ── Main per-element setup ───────────────────────────────────────────── */
  function setup(wrap: HTMLElement) {
    if (nActive >= MAX_ACT) { setTimeout(() => setup(wrap), 300); return; }
    nActive++;

    const bedEl = wrap.querySelector<HTMLCanvasElement>('.lcut-bed');
    const fxEl  = wrap.querySelector<HTMLCanvasElement>('.lcut-fx');
    if (!bedEl || !fxEl) { nActive--; return; }

    const heading = wrap.querySelector<HTMLElement>('h1,h2,h3,h4,h5,h6,[data-lc]');
    if (!heading) { nActive--; return; }

    const DUR   = parseFloat(wrap.dataset.lcDuration  || '3.0') * 1000;
    const DELAY = parseFloat(wrap.dataset.lcDelay     || '0.25') * 1000;
    const MAT   = wrap.dataset.lcMaterial || 'steel';

    const rect = wrap.getBoundingClientRect();
    const W    = Math.floor(rect.width);
    const H    = Math.floor(rect.height);
    if (W < 40 || H < 8) { nActive--; return; }

    const DPR  = Math.min(window.devicePixelRatio || 1, 2);
    const PW   = Math.round(W * DPR);
    const PH   = Math.round(H * DPR);

    function setCanvas(el: HTMLCanvasElement) {
      el.width = PW; el.height = PH;
      el.style.width = W + 'px'; el.style.height = H + 'px';
      const c = el.getContext('2d')!; c.scale(DPR, DPR); return c;
    }
    const bCtx  = setCanvas(bedEl);
    const fxCtx = setCanvas(fxEl);

    const sheetOff = mk(PW, PH);
    { const c = sheetOff.getContext('2d')!; c.scale(DPR, DPR); renderSheet(c, W, H, MAT); }

    const t1Off  = mk(PW, PH);
    const t1Ctx  = t1Off.getContext('2d')!; t1Ctx.scale(DPR, DPR);

    document.fonts.ready.then(() => {
      const mpx = buildMask(wrap, heading, W, H);

      // Letter mask canvas
      const lMaskOff = mk(PW, PH);
      {
        const c = lMaskOff.getContext('2d')!; c.scale(DPR, DPR);
        c.fillStyle = '#fff';
        for (let x = 0; x < W; x++) {
          let yt = -1, yb = -1;
          for (let y = 0; y < H; y++) {
            if (mpx[(y*W+x)*4] > 60) { if (yt < 0) yt = y; yb = y; }
          }
          if (yt >= 0) c.fillRect(x, yt, 1, yb - yt + 1);
        }
      }

      const { path, ytA, ybA } = buildCutPath(mpx, W, H);

      // Pre-compute total cut length and trace speed
      let totalLen = 0;
      for (let i = 1; i < path.length; i++) {
        if (!path[i].cut) continue;
        totalLen += Math.hypot(path[i].x - path[i-1].x, path[i].y - path[i-1].y);
      }

      // Phase schedule
      const phases = [
        { name: 'sheet',  t0: 0.00, t1: 0.09 },
        { name: 'trace',  t0: 0.09, t1: 0.77 },
        { name: 'cool',   t0: 0.77, t1: 0.90 },
        { name: 'reveal', t0: 0.90, t1: 1.00 },
      ];
      const DUR_S   = DUR / 1000;
      const traceD  = DUR_S * (phases[1].t1 - phases[1].t0);
      const traceSpd = totalLen / traceD;

      // Beam state
      let beamX = path[0]?.x ?? W * 0.5;
      let beamY = path[0]?.y ?? H * 0.5;
      let traceIdx  = 0;
      let traceDist = 0;
      let pierceDwell = 0;
      let beamDX = 0, beamDY = 1;

      let phaseIdx  = 0;
      let lastTs: number | null = null;
      let startTs   = 0;

      function finalise() {
        fxEl.style.display  = 'none';
        bedEl.style.transition = 'opacity 0.28s ease';
        bedEl.style.opacity  = '0';
        heading.style.visibility = 'visible';
        setTimeout(() => { bedEl.style.display = 'none'; nActive--; }, 320);
      }

      function showDone() {
        bedEl.style.display  = 'none';
        fxEl.style.display   = 'none';
        heading.style.visibility = 'visible';
        nActive--;
      }

      if (REDUCED) { showDone(); return; }
      heading.style.visibility = 'hidden';

      // Show sheet immediately (before DELAY)
      bCtx.clearRect(0, 0, W, H);
      bCtx.drawImage(sheetOff, 0, 0, W, H);

      function frame(ts: number) {
        if (!lastTs) lastTs = ts;
        const dt      = Math.min((ts - lastTs) / 1000, 0.05);
        lastTs        = ts;
        const elapsed = Math.min((ts - startTs) / 1000, DUR_S);
        const pct     = elapsed / DUR_S;

        while (phaseIdx < phases.length - 1 && pct >= phases[phaseIdx].t1) phaseIdx++;
        const ph = phases[phaseIdx];
        const pt = ph.t1 > ph.t0 ? clamp((pct - ph.t0) / (ph.t1 - ph.t0), 0, 1) : 1;

        // ── Trace phase: advance beam ──────────────────────────────────── //
        if (ph.name === 'trace' && totalLen > 0) {
          if (pierceDwell > 0) {
            pierceDwell -= dt;
            emitPierceSparks(beamX, beamY, dt);
            emitSmoke(beamX, beamY, dt);
          } else {
            let rem = traceSpd * dt;
            while (rem > 0 && traceIdx < path.length - 1) {
              const p0 = path[traceIdx];
              const p1 = path[traceIdx + 1];
              if (!p1.cut) {
                beamX = p1.x; beamY = p1.y;
                traceIdx++; traceDist = 0;
                pierceDwell = 0.28;
                rem = 0; break;
              }
              const segLen = Math.hypot(p1.x - p0.x, p1.y - p0.y);
              if (segLen < 0.01) { traceIdx++; traceDist = 0; continue; }
              const remSeg = segLen - traceDist;
              const sf = traceDist / segLen, ef = (traceDist + Math.min(rem, remSeg)) / segLen;
              const sx = lerp(p0.x, p1.x, sf), sy = lerp(p0.y, p1.y, sf);
              const ex = lerp(p0.x, p1.x, ef), ey = lerp(p0.y, p1.y, ef);
              const sdx = ex - sx, sdy = ey - sy, sl = Math.hypot(sdx, sdy);
              if (sl > 0.5) { beamDX = sdx / sl; beamDY = sdy / sl; }
              addKerf(sx, sy, ex, ey, elapsed);
              beamX = ex; beamY = ey;
              if (rem >= remSeg) {
                rem -= remSeg; traceDist = 0; traceIdx++;
              } else {
                traceDist += rem; rem = 0;
              }
            }
            emitSparks(beamX, beamY, dt, MAT, beamDX, beamDY);
            emitSmoke(beamX, beamY, dt);
          }
        }

        updateSparks(dt);
        updateSmoke(dt);

        // ── Composite ──────────────────────────────────────────────────── //
        const fallY    = ph.name === 'reveal' ? eio(pt) * (H + 24) : 0;
        const fallTilt = ph.name === 'reveal' ? eio(pt) * 0.06 : 0;
        const kerfOpac = ph.name === 'reveal' ? Math.max(0, 1 - pt * 2.5) : 1;
        const sheetFI  = ph.name === 'sheet' ? pt : 1;
        const showBeam = ph.name === 'trace' || (ph.name === 'cool' && pt < 0.25);
        const beamInt  = ph.name === 'trace' ? 1.0 : Math.max(0, 1 - pt * 4);

        bCtx.clearRect(0, 0, W, H);

        // Layer 1: cut letter metal at y=0
        t1Ctx.clearRect(0, 0, W, H);
        t1Ctx.drawImage(sheetOff, 0, 0, W, H);
        t1Ctx.globalCompositeOperation = 'destination-in';
        t1Ctx.drawImage(lMaskOff, 0, 0, W, H);
        t1Ctx.globalCompositeOperation = 'source-over';
        bCtx.globalAlpha = sheetFI;
        bCtx.drawImage(t1Off, 0, 0, W, H);
        bCtx.globalAlpha = 1;

        // Layer 2: falling waste sheet (sheet minus letters, shifted by fallY + slight tilt)
        t1Ctx.clearRect(0, 0, W, H);
        t1Ctx.save();
        t1Ctx.translate(W / 2, H / 2 + fallY);
        t1Ctx.rotate(fallTilt);
        t1Ctx.translate(-W / 2, -H / 2);
        t1Ctx.drawImage(sheetOff, 0, 0, W, H);
        t1Ctx.globalCompositeOperation = 'destination-out';
        t1Ctx.drawImage(lMaskOff, 0, 0, W, H);
        t1Ctx.restore();
        t1Ctx.globalCompositeOperation = 'source-over';
        bCtx.globalAlpha = sheetFI;
        bCtx.drawImage(t1Off, 0, 0, W, H);
        bCtx.globalAlpha = 1;

        // Layer 3: kerf glow
        drawKerf(bCtx, elapsed, kerfOpac);

        // Layer 4: beam head
        if (showBeam) drawBeamHead(bCtx, beamX, beamY, beamInt);

        // FX: smoke plume + sparks
        fxCtx.clearRect(0, 0, W, H);
        if (smokes.length > 0) drawSmoke(fxCtx);
        if (sparks.length > 0) drawSparks(fxCtx, sparks, MAT);

        if (pct >= 1) { finalise(); return; }
        requestAnimationFrame(frame);
      }

      setTimeout(() => { startTs = performance.now(); requestAnimationFrame(frame); }, DELAY);
    });
  }

  /* ── Observer / init ─────────────────────────────────────────────────── */
  function init() {
    document.querySelectorAll<HTMLElement>('.lcut-wrap').forEach(wrap => {
      if (REDUCED) {
        const h = wrap.querySelector<HTMLElement>('h1,h2,h3,h4,h5,h6');
        if (h) h.style.visibility = 'visible';
        return;
      }
      const trig = wrap.dataset.lcTrigger || 'scroll';
      if (trig === 'scroll' && 'IntersectionObserver' in window) {
        const obs = new IntersectionObserver(entries => {
          entries.forEach(e => {
            if (e.isIntersecting) { obs.unobserve(e.target as HTMLElement); setup(e.target as HTMLElement); }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -20px 0px' });
        obs.observe(wrap);
      } else {
        setup(wrap);
      }
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
