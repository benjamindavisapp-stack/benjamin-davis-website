---
/**
 * ProjectGallery — photo grid for project detail pages.
 *
 * Images with no `src` render as the labeled placeholder figure described in
 * CLAUDE.md, so a missing photo holds its slot at the right aspect ratio
 * instead of collapsing the layout.
 */

export interface GalleryImage {
  src?:     string;
  alt:      string;
  caption?: string;
  /** Crop focus for the fixed-ratio frame, e.g. "center 35%". */
  focus?:   string;
  /** Let one image span the full row. */
  wide?:    boolean;
  /** Label shown inside a placeholder when `src` is absent. */
  pending?: string;
}

interface Props {
  images: GalleryImage[];
  /** Columns at desktop width. */
  cols?:  2 | 3;
  ratio?: string;
}

const { images, cols = 2, ratio = '3 / 2' } = Astro.props;
---

<div class="gallery" style={`--cols:${cols}; --ratio:${ratio};`}>
  {images.map(img => (
    <figure class:list={['g-item', { 'g-item--wide': img.wide }]}>
      {img.src
        ? (
          <img
            src={img.src}
            alt={img.alt}
            loading="lazy"
            decoding="async"
            style={img.focus ? `object-position:${img.focus}` : undefined}
          />
        )
        : (
          <div class="g-placeholder" role="img" aria-label={img.alt}>
            <span>{img.pending ?? 'Photo to come'}</span>
          </div>
        )
      }
      {img.caption && <figcaption>{img.caption}</figcaption>}
    </figure>
  ))}
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 1rem;
  }

  .g-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .g-item--wide { grid-column: 1 / -1; }

  .g-item img,
  .g-placeholder {
    width: 100%;
    aspect-ratio: var(--ratio);
    border: 1px solid var(--panel-edge);
  }

  .g-item img {
    object-fit: cover;
    object-position: center;
    display: block;
    background: var(--panel);
  }

  .g-placeholder {
    background: var(--panel);
    border-style: dashed;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--steel);
  }

  figcaption {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: var(--steel);
  }

  @media (max-width: 640px) {
    .gallery { grid-template-columns: 1fr; }
    .g-item--wide { grid-column: auto; }
  }
</style>
